{{define "head"}}<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{if .Title}}{{.Title}}{{else}}NSM - the GTA V multiplayer modification you have dreamt of{{end}}</title>
  <link rel="icon" type="image/png" href="/img/nsm-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=JetBrains+Mono:wght@400;500;700&family=Material+Icons+Outlined&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=078n">
  <link rel="stylesheet" href="/css/zapx.css?v=6">
</head>
<body>

{{if .HasPendingClientAuth}}
<div class="client-auth-banner">
  <div class="wrap client-auth-banner-inner">
    <div style="display:flex;align-items:center;gap:10px">
      <span class="pulse-dot"></span>
      <span><strong>NSM.exe Desktop Client is waiting to sign in!</strong> {{if .User}}Click Authorize to connect your <strong>{{.User.EffectiveDisplayName}} (@{{.User.Username}})</strong> account inside NSM.exe.{{else}}Sign in to connect your account inside NSM.exe.{{end}}</span>
    </div>
    <div>
      {{if .User}}
      <form method="post" action="/account/connect-client" style="display:inline">
        <button type="submit" class="btn primary">Authorize NSM.exe as {{.User.EffectiveDisplayName}}</button>
      </form>
      {{else}}
      <a href="/user-api-key/new" class="btn primary">Sign In for NSM.exe</a>
      {{end}}
    </div>
  </div>
</div>
{{end}}

<div class="bg-holder{{if eq .Page "/"}} with-bg{{end}}">
<header class="nsm-top-header">
  <div class="hbar">
    <a href="/" class="logo unstyled">
      <img src="/img/nsm-icon.png" alt="NSM" class="logo-img">
      <span class="logo-title">NSM</span>
    </a>
    <ul class="links nav-main hidden-xs hidden-sm">
      <li><a href="/servers" class="{{if eq .Page "/servers"}}active{{end}}">Server List</a></li>
      <li><a href="/hosting" class="{{if or (eq .Page "/hosting") (eq .Page "/hosting/create") (eq .Page "/hosting/manage")}}active{{end}}">Hosting</a></li>
      <li><a href="/keymaster" class="{{if eq .Page "/keymaster"}}active{{end}}">Portal</a></li>
      <li><a href="/support" class="{{if eq .Page "/support"}}active{{end}}">Support</a></li>
      <li class="has-drop">
        <button type="button" class="drop-trigger{{if or (eq .Page "/forum") (eq .Page "/marketplace")}} active{{end}}">Community<span class="material-icons-outlined drop-caret">expand_more</span></button>
        <ul class="drop-menu">
          <li><a href="/forum" class="{{if eq .Page "/forum"}}active{{end}}">Forum</a></li>
          <li><a href="/marketplace" class="{{if eq .Page "/marketplace"}}active{{end}}">Marketplace</a></li>
        </ul>
      </li>
      <li><a href="/status" class="{{if eq .Page "/status"}}active{{end}}">Status</a></li>
      <li><a href="/docs" class="{{if eq .Page "/docs"}}active{{end}}">Documentation</a></li>
      {{if and .User (or (eq .User.Role "owner") (eq .User.Role "admin") (eq .User.Role "staff"))}}
      <li><a href="/admin/users" class="{{if eq .Page "/admin/users"}}active{{end}}">Staff</a></li>
      {{end}}
      {{if .User}}
      <li class="has-drop">
        <button type="button" class="drop-trigger">{{.User.EffectiveDisplayName}}<span class="material-icons-outlined drop-caret">expand_more</span></button>
        <ul class="drop-menu drop-menu-right">
          <li><a href="/u/{{.User.Username}}" class="{{if eq .Page "/u"}}active{{end}}">Profile</a></li>
          <li><a href="/account" class="{{if eq .Page "/account"}}active{{end}}">Account</a></li>
          <li><a href="/logout">Log out</a></li>
        </ul>
      </li>
      {{else}}
      <li><a href="/login" class="{{if eq .Page "/login"}}active{{end}}">Log in</a></li>
      {{end}}
      <li class="nav-cta"><a href="/download" data-no-spa="1" class="btn primary nav-dl">Download</a></li>
    </ul>
    <button class="burger-toggle" id="burger-open" type="button" aria-label="Open menu" aria-expanded="false"><span class="material-icons-outlined">menu</span></button>
  </div>
</header>
<div class="nav-backdrop" id="nav-backdrop"></div>
<nav class="nav-drawer" id="nav-drawer" aria-hidden="true">
  <div class="nav-drawer-head">
    <span class="logo-title">Menu</span>
    <button class="burger-toggle" id="burger-close" type="button" aria-label="Close menu"><span class="material-icons-outlined">close</span></button>
  </div>
  <ul>
    <li><a href="/servers">Server List</a></li>
    <li><a href="/hosting">Hosting</a></li>
    <li><a href="/keymaster">Portal</a></li>
    <li><a href="/support">Support</a></li>
    <li><span class="nav-drawer-label">Community</span></li>
    <li><a href="/forum">Forum</a></li>
    <li><a href="/marketplace">Marketplace</a></li>
    <li><a href="/status">Status</a></li>
    <li><a href="/docs">Documentation</a></li>
    {{if and .User (or (eq .User.Role "owner") (eq .User.Role "admin") (eq .User.Role "staff"))}}
    <li><a href="/admin/users">Staff</a></li>
    {{end}}
    {{if .User}}
    <li><span class="nav-drawer-label">{{.User.EffectiveDisplayName}}</span></li>
    <li><a href="/u/{{.User.Username}}">Profile</a></li>
    <li><a href="/account">Account</a></li>
    <li><a href="/logout">Log out</a></li>
    {{else}}
    <li><a href="/login">Log in</a></li>
    {{end}}
  </ul>
</nav>
<script>
(function(){
  var openBtn = document.getElementById('burger-open'),
      closeBtn = document.getElementById('burger-close'),
      drawer = document.getElementById('nav-drawer'),
      backdrop = document.getElementById('nav-backdrop');
  if (!drawer) return;
  function set(open){
    drawer.classList.toggle('open', open);
    if (backdrop) backdrop.classList.toggle('open', open);
    drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
    if (openBtn) openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    document.body.classList.toggle('nav-locked', open);
  }
  if (openBtn) openBtn.addEventListener('click', function(){ set(true); });
  if (closeBtn) closeBtn.addEventListener('click', function(){ set(false); });
  if (backdrop) backdrop.addEventListener('click', function(){ set(false); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') set(false); });
  drawer.addEventListener('click', function(e){ if (e.target.closest('a')) set(false); });
})();
</script>
{{if ne .Page "/"}}</div><main>{{end}}
{{end}}
