{{define "panel-foot"}}<script>
(function(){
  // ITEM 1 — restore the profile-card colour everywhere it appears
  try{var c=JSON.parse(localStorage.getItem('nsmPassColor')||'null');
    if(c){document.documentElement.style.setProperty('--pnl-pass-a',c[0]);document.documentElement.style.setProperty('--pnl-pass-b',c[1]);}
  }catch(e){}
  // ITEM 6 — mouse-following glow, kept inside each highlighted element
  var SEL='.pnl-pass,.pnl-me,.pnl-rail-item,.pnl-chip,.pnl-mini-btn,.pnl-btn-green,.pnl-tab';
  var raf=0;
  document.addEventListener('mousemove',function(e){
    if(raf)return;
    raf=requestAnimationFrame(function(){
      raf=0;
      var el=e.target&&e.target.closest?e.target.closest(SEL):null;
      if(!el)return;
      var r=el.getBoundingClientRect();
      el.style.setProperty('--mx',(e.clientX-r.left)+'px');
      el.style.setProperty('--my',(e.clientY-r.top)+'px');
    });
  },{passive:true});
})();
function supFilter(f){
  if(!document.getElementById('sup-list'))return;
  document.querySelectorAll('.pnl-tab-chip[data-f]').forEach(function(b){b.classList.toggle('pnl-on',b.getAttribute('data-f')===f);});
  document.querySelectorAll('#sup-list .pnl-ticket').forEach(function(t){
    var b=t.getAttribute('data-bucket');
    t.style.display=(b==='all'||b===f)?'':'none';
  });
}
</script>
<script src="/js/main.js?v=078n"></script></body></html>
{{end}}

