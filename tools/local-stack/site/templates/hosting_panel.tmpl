<script>
var ID = {{$s.ID}};
function post(url, body) {
  return fetch(url, {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body || {})});
}
window.post = post;
function pnlGet(url,tries){tries=tries||0;var ab=('AbortController' in window)?new AbortController():null;
  if(ab)setTimeout(function(){ab.abort();},20000);
  var sep=url.indexOf('?')>=0?'&':'?';
  return fetch(url+sep+'_='+Date.now(),{signal:ab?ab.signal:undefined,credentials:'same-origin',cache:'no-store'}).then(function(r){
    if(r.redirected||r.url.indexOf('/login')>=0)throw new Error('SESSION');
    if(!r.ok)return r.text().then(function(b){throw new Error('HTTP '+r.status+(b?': '+String(b).slice(0,120):''));});
    return r.json();
  }).catch(function(e){
    var m=String(e&&e.message||e);
    // fail fast on definitive answers (404/401/403/sessions) — only transient
    // conditions (timeouts, network, 5xx) deserve retries
    if(tries<2 && m.indexOf('HTTP 4')!==0 && m!=='SESSION')return new Promise(function(res){setTimeout(res,2000);}).then(function(){return pnlGet(url,tries+1);});
    throw e;
  });
}
function pnlFail(el,msg,err){if(!el)return;var d=err&&err.message==='SESSION'
  ?'your login session expired &mdash; <a href="/login?next='+encodeURIComponent(location.pathname+location.search)+'">sign in again</a>'
  :(err?String(err.message||err).replace(/</g,'&lt;'):'');
  el.innerHTML='<div class="pnl-err"><b>'+msg+'</b>'+(d?' <span class="pnl-err-d">'+d+'</span>':'')+' <button class="pnl-mini-btn" onclick="location.reload()">Retry</button></div>';
}
function pnlPost(u){post(u).then(function(){location.reload();});}
function pnlApplySrvStatus(d){
  var pill=document.getElementById('srv-pill'); if(pill){pill.textContent=d.status; pill.className='pnl-pill '+(d.status==='online'?'ok':d.status==='error'?'bad':'off');}
  var stop=document.querySelector('.pnl-top [data-pwr="stop"]'),start=document.querySelector('.pnl-top [data-pwr="start"]');
  var online=d.status==='online';
  if(stop){stop.style.display=online?'':'none';stop.disabled=false;}
  if(start){start.style.display=online?'none':'';start.disabled=false;}
}
function pnlPower(a,btn){
  if(btn)btn.disabled=true;
  post('/api/host/'+ID+'/power/'+a).then(function(r){return r.text();}).then(function(t){
    var d={};try{d=JSON.parse(t);}catch(e){throw new Error('server sent an unexpected response'+(t?': '+String(t).slice(0,120):''));}
    if(d&&d.error)throw new Error(d.error);
    pnlToast('Power: '+a+' requested');
    setTimeout(pnlStats,1200);setTimeout(pnlStats,2400);
  }).catch(function(e){pnlToast('Power action failed: '+String(e.message||e));if(btn)btn.disabled=false;});
}
function pnlToast(msg){
  var t=document.getElementById('pnl-toast');
  if(!t){t=document.createElement('div');t.id='pnl-toast';document.body.appendChild(t);}
  t.textContent=msg;t.classList.add('show');
  clearTimeout(window.__nsmToastT);
  window.__nsmToastT=setTimeout(function(){t.classList.remove('show');},4200);
}
function pnlNote(t){var m=document.getElementById('set-msg');if(m)m.textContent=t;}
function pnlCopy(t){navigator.clipboard&&navigator.clipboard.writeText(t);}
function pnlTogglePass(id,btn){var e=document.getElementById(id);if(!e)return;
  var hid=e.getAttribute('data-shown')!=='1';
  if(hid){e.textContent=e.getAttribute('data-pass');e.setAttribute('data-shown','1');if(btn)btn.innerHTML='&#128065; hide password';}
  else{e.textContent='\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022';e.setAttribute('data-shown','0');if(btn)btn.innerHTML='&#128065; show password';}}
function pnlShowPass(btn){pnlTogglePass('ftp-pass',btn);}
function pnlShowPass2(btn){pnlTogglePass('ftp-pass2',btn);}
function pnlRename(){var n=prompt('New server name:',document.getElementById('srv-name').textContent);if(!n)return;post('/api/host/'+ID+'/rename',{name:n}).then(function(r){return r.json();}).then(function(d){if(d.name)location.reload();});}
function pnlRenameSave(){var n=document.getElementById('set-name').value;post('/api/host/'+ID+'/rename',{name:n}).then(function(r){return r.json();}).then(function(d){document.getElementById('set-msg').textContent=d.name?'Saved':'Error: '+(d.error||'');if(d.name)document.getElementById('srv-name').textContent=d.name;});}
function pnlFtpPass(fromSettings){
  var el=document.getElementById(fromSettings?'set-ftppass':'ftp-new');
  var p=el?el.value:'';
  post('/api/host/'+ID+'/ftp-password',{pass:p}).then(function(r){return r.json();}).then(function(d){
    var m=document.getElementById(fromSettings?'set-msg':'ftp-msg');
    if(d.pass){if(m)m.textContent='New password: '+d.pass;if(el)el.value='';}else if(m)m.textContent=d.error||'error';
  });
}
function pnlDelete(){post('/api/host/'+ID+'/delete').then(function(){window.location.href='/hosting/dashboard';});}
function fmtUp(s){if(!s&&s!==0)return '—';var d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60);return d?d+'d '+h+'h':h?h+'h '+m+'m':m+'m';}
function fmtBytes(b){if(b<1024)return b+' B';if(b<1048576)return (b/1024).toFixed(1)+' KB';if(b<1073741824)return (b/1048576).toFixed(1)+' MB';return (b/1073741824).toFixed(2)+' GB';}

/* ---- live polling (no reloads) ---- */
var hist=[];
function pnlStats(){
  fetch('/api/host/'+ID+'/stats?_='+Date.now(),{credentials:'same-origin',cache:'no-store'}).then(function(r){return r.json();}).then(function(d){
    if(d&&d.error){throw new Error(d.error);}
    var cpu=d.cpu<0?0:d.cpu, ram=d.ramMB<0?0:Math.min(100,d.ramMB/(8*1024)*100), disk=Math.min(100,d.diskMB/(50*1024)*100);
    function set(g,b,v,txt){var e=document.getElementById(g),p=document.getElementById(b);if(e)e.textContent=txt;if(p)p.style.width=(v>0?v:0)+'%';}
    var cpuT=d.cpu<0?'n/a — offline':cpu.toFixed(0)+'%', ramT=d.ramMB<0?'n/a — offline':(d.ramMB/1024).toFixed(2)+' GB';
    set('g-cpu','b-cpu',cpu,cpuT); set('g-cpu2','b-cpu2',cpu,cpuT);
    set('g-ram','b-ram',ram,ramT); set('g-ram2','b-ram2',ram,ramT);
    set('g-disk','b-disk',disk,(d.diskMB/1024).toFixed(1)+' GB'); set('g-disk2','b-disk2',disk,(d.diskMB/1024).toFixed(1)+' GB');
    var gn=document.getElementById('g-net'); if(gn)gn.textContent=fmtBytes(d.rxBytes)+' ↓ / '+fmtBytes(d.txBytes)+' ↑';
    var tr=document.getElementById('t-rx'),tt=document.getElementById('t-tx');if(tr)tr.textContent=fmtBytes(d.rxBytes);if(tt)tt.textContent=fmtBytes(d.txBytes);
    var qd=document.getElementById('q-disk'),qb=document.getElementById('q-bar');if(qd)qd.textContent=(d.diskMB/1024).toFixed(2)+' GB / 50 GB';if(qb)qb.style.width=disk+'%';
    var mc=document.getElementById('m-cpu'),mr=document.getElementById('m-ram'),mp=document.getElementById('m-players');
    if(mc)mc.textContent=d.cpu<0?'n/a':cpu.toFixed(1)+'%';if(mr)mr.textContent=d.ramMB<0?'n/a':(d.ramMB/1024).toFixed(2)+' GB';if(mp)mp.textContent=d.players;
    hist.push(cpu); if(hist.length>60)hist.shift();
    var cv=document.getElementById('m-chart');
    if(cv){var x=cv.getContext('2d'),w=cv.width=cv.offsetWidth,h=cv.height=90;x.clearRect(0,0,w,h);x.strokeStyle='#18E888';x.beginPath();
      hist.forEach(function(v,i){var px=i/59*w,py=h-v/100*h*0.95;i?x.lineTo(px,py):x.moveTo(px,py);});x.stroke();}
    pnlApplySrvStatus(d);
    var live=document.getElementById('srv-live');
    if(live)live.textContent=(d.online?'Uptime '+fmtUp(d.uptimeSec):'Server is '+d.status)+' · updated '+new Date().toLocaleTimeString();
    var ga=document.getElementById('guest-agent'); if(ga){ga.textContent=d.guestAgent?'connected':'idle';ga.style.color=d.guestAgent?'#18E888':'#8fa0b2';}
  }).catch(function(e){
    var live=document.getElementById('srv-live');
    if(live)live.textContent='cannot load stats: '+String(e.message||e)+' — retrying…';
  });
}

/* ---- console ---- */
var since=0,consoleTimer=null;
function pnlConsole(){
  var el=document.getElementById('pnl-console'); if(!el){return;}
  fetch('/api/host/'+ID+'/console?since='+since+'&_='+Date.now(),{credentials:'same-origin',cache:'no-store'}).then(function(r){return r.json();}).then(function(d){
    if(d&&d.error){throw new Error(d.error);}
    since=d.seq;
    window.__cmErr=0;
    if(!d.lines.length && el.childElementCount===0){
      el.textContent='waiting for output — the city streams logs while it runs (press Start if it is offline)';
    }
    d.lines.forEach(function(l){
      var div=document.createElement('div');
      var cls=l.line.indexOf('[system]')>=0||l.line.indexOf('[panel]')>=0||l.line.indexOf('[apps]')>=0||l.line.indexOf('[backup]')>=0||l.line.indexOf('[schedule]')>=0?'sys':l.line.toLowerCase().indexOf('err')>=0?'err':'';
      div.className=cls; div.textContent=l.line; el.appendChild(div);
    });
    if(d.lines.length)el.scrollTop=el.scrollHeight;
  }).catch(function(e){
    window.__cmErr=(window.__cmErr||0)+1;
    if(window.__cmErr<3||window.__cmErr%10===0){
      var div=document.createElement('div');div.className='err';
      div.textContent='[panel] cannot reach the server ('+String(e.message||e)+') — retrying…';
      el.appendChild(div);el.scrollTop=el.scrollHeight;
    }
  });
}
function pnlCmd(e){
  e.preventDefault();
  var v=document.getElementById('cmdinput').value.trim(); if(!v)return false;
  post('/api/host/'+ID+'/command',{cmd:v}).then(function(){document.getElementById('cmdinput').value='';pnlConsole();});
  return false;
}

/* ---- plan ---- */
var planTier={{.PlanTier}},planUp={{.PlanUpvotes}};
function fmtN(n){return n>=1000000?(n/1000000).toFixed(n%1000000?1:0)+'M':n>=1000?(n/1000).toFixed(n%1000?1:0)+'k':String(n);}
function pnlDue(up){return up<=10?0:Math.max(2.99,Math.round(up*0.0002*100)/100);}
function pnlDueText(up){var d=pnlDue(up);return d<=0?'Free':'€'+d.toFixed(2);}
function pnlDueRefresh(){
  var a=document.getElementById('due-amount'),b=document.getElementById('due-price');
  if(a)a.textContent=pnlDueText(planUp)+(pnlDue(planUp)>0?' / month':'');
  if(b)b.textContent=pnlDueText(planUp);
}
(function(){document.querySelectorAll('.pnl-tier [data-price]').forEach(function(sp){
  var t=sp.closest('.pnl-tier'),up=parseInt(t.getAttribute('data-up')||'0',10);
  if(up)sp.textContent=pnlDueText(up)+' / mo';
});pnlDueRefresh();})();
function pnlSlide(v){planUp=parseInt(v,10);planTier='custom';document.getElementById('up-num').textContent=fmtN(planUp);
  document.querySelectorAll('.pnl-tier').forEach(function(t){t.classList.remove('pnl-on');});
  var c=document.querySelector('.pnl-tier[onclick*="custom"]');if(c)c.classList.add('pnl-on');
  pnlDueRefresh();}
function pnlStep(d){var s=document.getElementById('up-slider');s.value=Math.max(1,Math.min(2000000,parseInt(s.value,10)+d));pnlSlide(s.value);}
function pnlTier(btn,name){document.querySelectorAll('.pnl-tier').forEach(function(t){t.classList.remove('pnl-on');});btn.classList.add('pnl-on');
  planTier=name;var up=btn.getAttribute('data-up');if(up){document.getElementById('up-slider').value=up;pnlSlide(up);planTier=name;}else{planTier='custom';pnlDueRefresh();}}
function pnlPlanSave(){post('/api/host/'+ID+'/plan',{tier:planTier,upvotes:planUp}).then(function(r){return r.json();}).then(function(d){
  document.getElementById('plan-msg').textContent='Subscription active — '+(d.dueText||pnlDueText(planUp))+' / month · '+fmtN(d.upvotes||planUp)+' upvotes';}).catch(function(){pnlToast('Could not save the plan');});}

/* ---- agent ---- */
function pnlAgentSend(){
  var t=document.getElementById('agent-in'); if(!t.value.trim())return;
  var chat=document.getElementById('agent-chat');
  var me=document.createElement('div');me.className='pnl-msg me';me.innerHTML='<div class="who">'+{{.User.Username}}+'</div>'+t.value.replace(/[<>]/g,'');chat.appendChild(me);
  var q=t.value;t.value='';chat.scrollTop=chat.scrollHeight;
  post('/api/host/'+ID+'/agent',{message:q}).then(function(r){return r.json();}).then(function(d){
    var el=document.createElement('div');el.className='pnl-msg them';
    var html='<div class="who">Plus</div>'+(d.reply||'…');
    if(d.code)html+='<pre>'+d.code.replace(/[<>]/g,'')+'</pre>';
    el.innerHTML=html;chat.appendChild(el);chat.scrollTop=chat.scrollHeight;
  });
}

/* ---- apps ---- */
function pnlApps(){
  var el=document.getElementById('app-list'); if(!el)return;
  pnlGet('/api/host/'+ID+'/apps').then(function(d){
    el.innerHTML='';
    d.apps.forEach(function(a){
      var div=document.createElement('div');div.className='pnl-app';
      div.innerHTML='<div class="logo">'+a.name[0]+'</div><div><div class="nm">'+a.name+' <span style="color:#fff;font-size:.72rem">v'+a.version+'</span></div><div class="blurb">'+a.blurb+'</div></div><div class="sp"></div>'+
        (a.installed?'<span class="pnl-pill ok">installed</span>':'<button class="pnl-btn-green" onclick="pnlInstall(\''+a.id+'\',this)">Install</button>');
      el.appendChild(div);
    });
  }).catch(function(e){pnlFail(el,'Apps could not be loaded.',e);});
}
function pnlInstall(id,btn){btn.textContent='Installing…';btn.disabled=true;post('/api/host/'+ID+'/apps/'+id+'/install').then(function(r){return r.json();}).then(function(){pnlApps();}).catch(function(){pnlApps();});}

/* ---- backups / schedules / activity ---- */
function pnlBackups(){
  var el=document.getElementById('bk-list'); if(!el)return;
  pnlGet('/api/host/'+ID+'/backups').then(function(d){
    if(!d.backups.length){el.innerHTML='<div class="pnl-ticket">No backups yet — create your first one.</div>';return;}
    el.innerHTML='';
    d.backups.forEach(function(b){
      var div=document.createElement('div');div.className='pnl-ticket';
      div.innerHTML='<span class="id">'+b.id+'</span><span class="subj">'+b.name+'</span><span class="when">'+new Date(b.created*1000).toLocaleString()+' · '+b.sizeMB+' MB</span>'+
        '<button class="pnl-mini-btn" onclick="pnlBackupOp(\''+b.id+'\',\'restore\')">Restore</button>'+
        '<button class="pnl-mini-btn red" onclick="pnlBackupOp(\''+b.id+'\',\'delete\')">Delete</button>';
      el.appendChild(div);
    });
  }).catch(function(e){pnlFail(el,'Backups could not be loaded.',e);});
}
function pnlBackupCreate(){document.getElementById('bk-msg').textContent='Creating…';post('/api/host/'+ID+'/backup').then(function(r){return r.json();}).then(function(){document.getElementById('bk-msg').textContent='Backup created';pnlBackups();});}
function pnlBackupOp(id,op){if(op==='restore'&&!confirm('Restore this backup? Current files are replaced.'))return;post('/api/host/'+ID+'/backup/'+id+'/'+op).then(function(){pnlBackups();});}
function pnlScheds(){
  var el=document.getElementById('sch-list'); if(!el)return;
  pnlGet('/api/host/'+ID+'/schedules').then(function(d){
    if(!d.schedules||!d.schedules.length){el.innerHTML='<div class="pnl-ticket">No schedules yet.</div>';return;}
    el.innerHTML='';
    d.schedules.forEach(function(s){
      var div=document.createElement('div');div.className='pnl-ticket';
      div.innerHTML='<span class="id">'+s.id+'</span><span class="subj">'+s.label+'</span><span class="when">every '+s.everyMin+' min · '+s.kind+'</span>'+
        '<button class="pnl-mini-btn" onclick="pnlSchedOp(\''+s.id+'\',\'toggle\')">'+(s.enabled?'Disable':'Enable')+'</button>'+
        '<button class="pnl-mini-btn red" onclick="pnlSchedOp(\''+s.id+'\',\'delete\')">Delete</button>';
      el.appendChild(div);
    });
  }).catch(function(e){pnlFail(el,'Schedules could not be loaded.',e);});
}
function pnlSchedAdd(){post('/api/host/'+ID+'/schedules',{label:'',kind:document.getElementById('sch-kind').value,everyMin:parseInt(document.getElementById('sch-min').value,10)||60}).then(function(){pnlScheds();});}
function pnlSchedOp(id,op){post('/api/host/'+ID+'/schedule/'+id+'/'+op).then(function(){pnlScheds();});}
function pnlActivity(){
  var el=document.getElementById('act-list'); if(!el)return;
  pnlGet('/api/host/'+ID+'/activity').then(function(d){
    el.textContent=(d.lines||[]).join('\n')||'no activity yet';
    el.scrollTop=el.scrollHeight;
  }).catch(function(e){pnlFail(el,'Activity could not be loaded.',e);});
}

/* ---- files + config (kept from the classic panel) ---- */
var cur='';
function fmList(p){
  var t=document.getElementById('filetable'); if(!t)return;
  cur=p||'';
  document.getElementById('fm-path').textContent='/'+cur;
  pnlGet('/api/host/'+ID+'/files?path='+encodeURIComponent(cur)).then(function(d){
    if(d.error){t.innerHTML='<div class="pnl-err">'+d.error+'</div>';return;}
    var h='<div class="pnl-kv">';
    d.entries.forEach(function(e){
      var act=e.dir?"fmList('"+e.path+"')":"fmEdit('"+e.path+"')";
      h+='<div class="r"><span class="k" style="cursor:pointer" onclick="'+act+'">'+(e.dir?'&#128193;':'&#128196;')+' '+e.name+'</span><span class="v">'+
        '<button class="pnl-mini-btn" onclick="fmRename(\''+e.path+'\')">rename</button> '+
        '<button class="pnl-mini-btn red" onclick="fmDelete(\''+e.path+'\')">delete</button></span></div>';
    });
    t.innerHTML=h+'</div>';
  });
}
function fmUp(){var i=cur.lastIndexOf('/');fmList(i<0?'':cur.substring(0,i));}
function fmEdit(p){fetch('/api/host/'+ID+'/file?path='+encodeURIComponent(p)).then(function(r){return r.json();}).then(function(d){
  var w=document.getElementById('fm-edit');w.style.display='block';document.getElementById('fm-text').value=d.content||'';w.setAttribute('data-p',p);});}
function fmSave(){var w=document.getElementById('fm-edit');post('/api/host/'+ID+'/file/write',{path:w.getAttribute('data-p'),content:document.getElementById('fm-text').value}).then(function(){fmList(cur);});}
function fmRename(p){var n=prompt('New path:',p);if(!n)return;post('/api/host/'+ID+'/file/op',{op:'rename',path:p,to:n}).then(function(){fmList(cur);});}
function fmDelete(p){if(!confirm('Delete '+p+'?'))return;post('/api/host/'+ID+'/file/op',{op:'delete',path:p}).then(function(){fmList(cur);});}
function fmNew(){var n=prompt('File name:');if(!n)return;post('/api/host/'+ID+'/file/write',{path:(cur?cur+'/':'')+n,content:''}).then(function(){fmList(cur);});}
function fmMkdir(){var n=prompt('Folder name:');if(!n)return;post('/api/host/'+ID+'/file/op',{op:'mkdir',path:(cur?cur+'/':'')+n}).then(function(){fmList(cur);});}
function cfgSave(){
  return post('/api/host/'+ID+'/file/write',{path:'server.cfg',content:document.getElementById('cfgtext').value}).then(function(){
    var m=document.getElementById('cfgmsg');if(m){m.textContent='Saved';setTimeout(function(){m.textContent='';},2500);}});
}
window.cfgSave=cfgSave;
window.cfgSaveRestart=function(){cfgSave().then(function(){pnlPower('restart');});};

/* ---- boot ---- */
window.__nsmTimers=window.__nsmTimers||[];
if(document.getElementById('pnl-console'))pnlConsole();
if(document.getElementById('filetable'))fmList('');
if(document.getElementById('cfgtext')){
  pnlGet('/api/host/'+ID+'/file?path=server.cfg').then(function(d){
    if(d.error){
      document.getElementById('cfgtext').value='# server.cfg is not on disk yet — press "Create default config" to write one.\n# '+d.error;
      var m=document.getElementById('cfgmsg');
      if(m)m.innerHTML='<button class="pnl-mini-btn green" onclick="cfgCreate()">Create default config</button>';
      return;
    }
    document.getElementById('cfgtext').value=d.content||'';
  }).catch(function(){
    document.getElementById('cfgtext').value='# could not read server.cfg';
  });
}
function cfgCreate(){
  var txt='sv_hostname "NSM City"\nsv_maxclients 2048\nsv_lan 1\nsets sv_projectName "NSM City"\n';
  post('/api/host/'+ID+'/file/write',{path:'server.cfg',content:txt}).then(function(){location.reload();});
}
pnlStats();
window.__nsmTimers.push(setInterval(pnlStats,4000));
if(document.getElementById('pnl-console'))window.__nsmTimers.push(setInterval(pnlConsole,2500));
if(document.getElementById('app-list'))pnlApps();
if(document.getElementById('bk-list'))pnlBackups();
if(document.getElementById('sch-list'))pnlScheds();
if(document.getElementById('act-list')){window.__nsmTimers.push(setInterval(pnlActivity,6000));pnlActivity();}
</script>
{{template "panel-foot" .}}
{{end}}

{{define "panel-support"}}
{{template "panel-head" .}}
<div class="pnl">
  {{template "panel-rail" .}}
  <div class="pnl-main">
    <div class="pnl-top"><a class="pnl-back" href="/hosting/dashboard" title="Back to dashboard">&#8592;</a><h1>Support</h1><div class="sp"></div>
      <div class="pnl-top-actions">
        <button class="pnl-mini-btn green" onclick="pnlNewTicket()">New chat</button>
        <a class="pnl-mini-btn" href="/support">Help center</a>
        <a class="pnl-mini-btn" href="/hosting/incidents">Status</a>
      </div>
    </div>
    <div class="pnl-body">
      {{if .T}}
      <div class="pnl-panel">
        <div class="pnl-srv-head">
          <div class="title">{{.T.Subject}}</div>
          <span class="pnl-unit">ticket #{{.T.ID}}</span>
          <div class="sp"></div>
          <span class="pnl-pill {{if eq .T.Status "closed"}}off{{else}}ok{{end}}">status: {{.T.Status}}</span>
          {{if ne .T.Status "closed"}}<button class="pnl-mini-btn" onclick="pnlCloseTicket('{{.T.ID}}')">Close</button>{{end}}
          <a class="pnl-mini-btn" href="/hosting/support">&#8592; all tickets</a>
        </div>
        <div class="pnl-chat" id="tchat">
          {{range .T.Messages}}
          <div class="pnl-msg {{if eq .From "user"}}me{{else}}them{{end}}"><div class="who">{{.By}} &middot; {{unixfmt .At}}</div>{{.Text}}</div>
          {{end}}
        </div>
        <div class="pnl-chat-input">
          <textarea id="tmsg" placeholder="Write a message… (Enter to send)" onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();pnlSendTicketMsg('{{.T.ID}}')}"></textarea>
          <button class="pnl-btn-green" onclick="pnlSendTicketMsg('{{.T.ID}}')">Send</button>
        </div>
      </div>
      {{else}}
      <div class="pnl-tabs-row">
        <button type="button" class="pnl-tab-chip pnl-on" data-f="new" onclick="supFilter('new')">New <span class="n">{{.ChipNew}}</span></button>
        <button type="button" class="pnl-tab-chip" data-f="open" onclick="supFilter('open')">Open <span class="n">{{.ChipOpen}}</span></button>
        <button type="button" class="pnl-tab-chip" data-f="closed" onclick="supFilter('closed')">Closed <span class="n">{{.ChipClosed}}</span></button>
      </div>
      <div class="pnl-panel">
        <h3>Hosting support</h3><p class="hint">Live chat with the hosting team — separate from the <a href="/support" style="color:#18E888">NSM ticket system</a>. Status of the platform lives on the <a href="/status" style="color:#18E888">status page</a>.</p>
        <div class="pnl-tickets" id="sup-list">
          {{range .Tickets}}
          <a class="pnl-ticket" data-bucket="{{if eq .Status "new"}}new{{else if eq .Status "closed"}}closed{{else}}open{{end}}" href="/hosting/support?t={{.ID}}">
            <span class="id">#{{.ID}}</span>
            <span class="subj">{{.Subject}}</span>
            <span class="pnl-pill {{if eq .Status "closed"}}off{{else}}ok{{end}}">{{.Status}}</span>
            <span class="when">{{unixfmt .Updated}}</span>
          </a>
          {{else}}
          <div class="pnl-ticket" data-bucket="all">No tickets yet — press <b>New chat</b> to reach the hosting team.</div>
          {{end}}
        </div>
      </div>
      {{end}}
    </div>
  </div>
</div>
<script>
function pnlNewTicket(){
  var s=prompt('Subject:'); if(!s)return;
  var t=prompt('Describe your issue:'); if(!t)return;
  fetch('/api/hosting/support',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({subject:s,text:t})})
    .then(function(r){return r.json();}).then(function(d){location.href='/hosting/support?t='+d.id;});
}
function pnlSendTicketMsg(id){
  var t=document.getElementById('tmsg'); if(!t.value.trim())return;
  fetch('/api/hosting/support/'+id+'/message',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:t.value})})
    .then(function(){location.reload();});
}
function pnlCloseTicket(id){fetch('/api/hosting/support/'+id+'/close',{method:'POST'}).then(function(){location.href='/hosting/support';});}
</script>
{{template "panel-foot" .}}
{{end}}

{{define "panel-community"}}
{{template "panel-head" .}}
<div class="pnl">
  {{template "panel-rail" .}}
  <div class="pnl-main">
    <div class="pnl-top"><a class="pnl-back" href="/hosting/dashboard" title="Back to dashboard">&#8592;</a><h1>Community &amp; Partners</h1><div class="sp"></div><a class="pnl-mini-btn" href="/hosting/dashboard">&#8592; back to dashboard</a></div>
    <div class="pnl-body">
      <div class="pnl-community">
        <nav class="pnl-subrail">
          <a class="pnl-on" href="/hosting/community">&#8592; Back</a>
          <div class="grp">Affiliate &amp; Partner program</div>
          <a href="/hosting/community?s=affiliate">Affiliate &amp; Partner program</a>
          <div class="grp">Community</div>
          <a href="/hosting/community?s=overview">Overview</a>
          <a href="/hosting/community?s=feedback">Feedback</a>
          <a href="/hosting/community?s=roadmap">Roadmap</a>
          <a href="/hosting/community?s=changelog">Changelog</a>
          <a href="/hosting/community?s=partner">Partner</a>
          <a href="/forum">Discord</a>
          <a href="/servers">Server list</a>
        </nav>
        <div class="pnl-pane">
          <div class="pnl-panel">
            {{if eq .Section "affiliate"}}
            <h3>Affiliate &amp; Partner program</h3>
            <p class="hint">Bring your community to NSM Hosting and earn partner status — featured placement on the server list, a partner badge on your profile and a direct line to the team. Apply through the <a href="/support" style="color:#18E888">NSM ticket system</a> with your community details.</p>
            {{else if eq .Section "feedback"}}
            <h3>Feedback</h3>
            <p class="hint">Tell us what the panel is missing — every hosting feature in use today started as community feedback. Post ideas on the <a href="/forum" style="color:#18E888">forum</a> or in a <a href="/hosting/support" style="color:#18E888">hosting chat</a>.</p>
            {{else if eq .Section "roadmap"}}
            <h3>Roadmap</h3>
            <p class="hint">In progress: one-click apps expansion, per-server schedules, live monitoring history. Planned: DNS record editor, team access, regional cities. Follow along on the <a href="/forum" style="color:#18E888">forum</a>.</p>
            {{else if eq .Section "changelog"}}
            <h3>Changelog</h3>
            <p class="hint">The panel and platform ship continuously — recent work: ZAPX-style control panel, live updates, hosting support chat, backups &amp; schedules, one-click apps, five servers per account. Details on the <a href="/status" style="color:#18E888">status page</a>.</p>
            {{else if eq .Section "partner"}}
            <h3>Partner</h3>
            <p class="hint">Partner servers keep their own identity and rules — NSM provides the hosting, the join links and the audience. See current communities on the <a href="/servers" style="color:#18E888">server list</a>.</p>
            {{else}}
            <h3>Community overview</h3>
            <p class="hint">NSM is built with its cities — roleplay, racing, freeroam and everything between. Jump into the <a href="/servers" style="color:#18E888">server list</a>, the <a href="/forum" style="color:#18E888">forum</a>, or the partner channels below.</p>
            <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:10px">
              <a class="pnl-mini-btn green" href="/servers">Server list</a>
              <a class="pnl-mini-btn" href="/forum">Forum &amp; Discord</a>
              <a class="pnl-mini-btn" href="/hosting/community?s=roadmap">Roadmap</a>
            </div>
            {{end}}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{template "panel-foot" .}}
{{end}}

{{define "panel-billing"}}
{{template "panel-head" .}}
<div class="pnl">{{template "panel-rail" .}}<div class="pnl-main">
  <div class="pnl-top"><a class="pnl-back" href="/hosting/dashboard" title="Back to dashboard">&#8592;</a><h1>Billing</h1></div>
  <div class="pnl-body">
    <div class="pnl-panel">
      <h3>Your subscriptions</h3><p class="hint">Packages are billed monthly. Payment is arranged through <a href="/hosting/support" style="color:#18E888">hosting support</a>.</p>
      <div class="pnl-kv">
        {{range .Bills}}
        <div class="r"><span class="k">{{.Name}} &middot; {{.Tier}} &middot; {{.Up}} upvotes</span><span class="v">{{.DueTxt}} / month</span></div>
        {{else}}
        <div class="r"><span class="k">No paid packages yet</span><span class="v">Choose one under Manage plan</span></div>
        {{end}}
        <div class="r"><span class="k"><strong>Amount due</strong></span><span class="v" style="color:#18E888;font-size:1.05rem">{{.TotalDue}}</span></div>
        <div class="r"><span class="k">Next charge</span><span class="v">{{.NextCharge}}</span></div>
        <div class="r"><span class="k">Pass</span><span class="v">{{.PassTier}}</span></div>
      </div>
      <div style="margin-top:16px;display:flex;gap:10px;flex-wrap:wrap">
        <a class="pnl-btn-green" href="/hosting/support">Arrange payment</a>
        <a class="pnl-mini-btn" href="/hosting/dashboard">Manage packages</a>
      </div>
    </div>
  </div>
</div></div>
{{template "panel-foot" .}}
{{end}}

{{define "panel-pass"}}
{{template "panel-head" .}}
<div class="pnl">{{template "panel-rail" .}}<div class="pnl-main">
  <div class="pnl-top"><a class="pnl-back" href="/hosting/dashboard" title="Back to dashboard">&#8592;</a><h1>Pulse</h1></div>
  <div class="pnl-body">
    <div class="pnl-hero">
      <div style="flex:1">
        <h2><span class="pnl-grad">{{.PassTier}}</span></h2>
        <div class="pnl-sub">Your NSM pass — every hosting feature is included free.</div>
        <a class="pnl-btn-green" href="/u/{{.User.Username}}">Manage profile</a>
      </div>
      <div class="pnl-pass"><img class="av pav" src="/avatars/u/{{.User.Username}}/128.png?v=1" alt="" onerror="this.style.display='none'"><div><div class="lbl">Pulse Pass</div><div class="nm">{{.User.Username}} <span class="pnl-arr">&#8250;</span></div><div class="badges"><span class="badge">{{.PassTier}}</span><span class="badge">Free forever</span></div></div></div>
    </div>
    <div class="pnl-panel"><h3>What's included</h3><p class="hint">Up to 5 servers, 2048 slots each, backups, schedules, one-click apps, the Plus scripting agent and hosting support chat.</p></div>
    <div class="pnl-panel">
      <h3>Pulse plans</h3>
      <p class="hint">Your plan lights up and stays selected — pick another any time from a server's Manage plan.</p>
      <div class="pnl-tiers pnl-tiers-pass" id="pass-tiers">
        {{range .Tiers}}<button class="pnl-tier pnl-plan-card{{if eq $.PlanTier .Name}} pnl-on pnl-plan-lit{{end}}" data-up="{{.Upvotes}}" onclick="pnlPassPlan(this)"><span class="tname">{{.Name}}</span><span class="tup">{{.Upvotes}} upvotes</span><span class="tprice" data-price></span></button>{{end}}
      </div>
    </div>
  </div>
  <script>
  (function(){document.querySelectorAll('.pnl-tier [data-price]').forEach(function(sp){
    var t=sp.closest('.pnl-tier'),up=parseInt(t.getAttribute('data-up')||'0',10);
    sp.textContent=up<=10?'Free':'€'+Math.max(2.99,Math.round(up*0.0002*100)/100).toFixed(2)+'/mo';
  });})();
  function pnlPassPlan(btn){document.querySelectorAll('#pass-tiers .pnl-tier').forEach(function(t){t.classList.remove('pnl-on','pnl-plan-lit');});btn.classList.add('pnl-on','pnl-plan-lit');}
  </script>
</div></div>
{{template "panel-foot" .}}
{{end}}

{{define "panel-news"}}
{{template "panel-head" .}}
<div class="pnl">{{template "panel-rail" .}}<div class="pnl-main">
  <div class="pnl-top"><a class="pnl-back" href="/hosting/dashboard" title="Back to dashboard">&#8592;</a><h1>News</h1></div>
  <div class="pnl-body">
    <div class="pnl-panel"><h3>Platform news</h3><p class="hint">Live from the NSM forum announcements — updated automatically.</p>
      {{range .Announcements}}
      <div class="pnl-news-item{{if .Pinned}} pnl-news-pin{{end}}">
        <div class="nn">{{.Title}}{{if .Pinned}} <span class="pnl-pill ok">pinned</span>{{end}}</div>
        <div class="nm2">by {{.Author}} &middot; {{unixfmt .UpdatedAt}}</div>
        <p>{{.Body}}</p>
      </div>
      {{else}}
      <div class="pnl-news-item"><p>No announcements yet — check back soon.</p></div>
      {{end}}
    </div>
  </div>
</div></div>
{{template "panel-foot" .}}
{{end}}

{{define "panel-incidents"}}
{{template "panel-head" .}}
<div class="pnl">{{template "panel-rail" .}}<div class="pnl-main">
  <div class="pnl-top"><a class="pnl-back" href="/hosting/dashboard" title="Back to dashboard">&#8592;</a><h1>Incidents</h1></div>
  <div class="pnl-body">
    <div class="pnl-panel">
      <h3>Platform incidents</h3><p class="hint">Live from the <a href="/status" style="color:#18E888">status page</a>.</p>
      <div class="pnl-tickets">
        {{range .Incidents}}
        <div class="pnl-ticket"><span class="id">{{unixfmt .Started}}</span><span class="subj">{{.Name}}</span>
          <span class="pnl-pill {{if .Resolved}}off{{else}}bad{{end}}">{{if .Resolved}}resolved{{else}}open{{end}}</span></div>
        {{else}}
        <div class="pnl-ticket">No incidents recorded. Everything is running.</div>
        {{end}}
      </div>
    </div>
  </div>
</div></div>
{{template "panel-foot" .}}
{{end}}
