{{define "panel-dashboard"}}
{{template "panel-head" .}}
<div class="pnl">
  {{template "panel-rail" .}}
  <div class="pnl-main">
    <div class="pnl-top"><a class="pnl-back" href="/" title="Back to NSM website">&#8592;</a><h1>Dashboard</h1><div class="sp"></div>
      <a class="pnl-icon-btn" href="/hosting/support" title="Support">&#9993;{{if .SupportOpen}}<span class="dot">{{.SupportOpen}}</span>{{end}}</a>
      <a class="pnl-icon-btn" href="/hosting/incidents" title="Incidents">&#9888;</a>
    </div>
    <div class="pnl-body">
      <div class="pnl-hero-panel">
        <div class="pnl-hero-top">
          <div class="pnl-hero-left">
            <h2><span id="pnl-greet">{{.Greeting}}</span>, <span class="pnl-grad">{{.User.Username}}</span></h2>
            <div class="pnl-sub"><span class="pnl-live-dot"></span> {{.Online}} online &middot; {{.Total}} service{{if ne .Total 1}}s{{end}} total &middot; up to {{.MaxServers}} per account</div>
            <a class="pnl-btn-green" href="/hosting/create">&#128722; Deploy server</a>
          </div>
          <div class="pnl-pass pnl-pass-link" id="pnl-pass" onclick="location.href='/u/{{.User.Username}}'">
            <div class="pnl-pass-banner"></div>
            <div class="pnl-pass-glow"></div>
            <img class="av pav" src="/avatars/u/{{.User.Username}}/128.png?v=1" alt="" onerror="this.style.display='none'">
            <div>
              <div class="lbl">Pulse Pass</div>
              <div class="nm">{{.User.Username}} <span class="pnl-arr">&#8250;</span></div>
              <div class="badges"><span class="badge">{{.PassTier}}</span><span class="badge">NSM Hosting</span></div>
              <div class="foot">Free forever &middot; every feature included</div>
            </div>
            <a class="manage manage-ring" href="/u/{{.User.Username}}">&#9998; Manage</a>
            <div class="pnl-pass-colors" title="Banner colour" onclick="event.stopPropagation()">
              <span class="pc-lbl">banner</span>
              <button onclick="event.stopPropagation();pnlPassColor('#4c2a86','#1b1030')" style="background:linear-gradient(135deg,#4c2a86,#1b1030)"></button>
              <button onclick="event.stopPropagation();pnlPassColor('#0e5c3a','#072418')" style="background:linear-gradient(135deg,#0e5c3a,#072418)"></button>
              <button onclick="event.stopPropagation();pnlPassColor('#1e3a8a','#0c1a3e')" style="background:linear-gradient(135deg,#1e3a8a,#0c1a3e)"></button>
              <button onclick="event.stopPropagation();pnlPassColor('#7c2d12','#2a1006')" style="background:linear-gradient(135deg,#7c2d12,#2a1006)"></button>
              <button onclick="event.stopPropagation();pnlPassColor('#334155','#111827')" style="background:linear-gradient(135deg,#334155,#111827)"></button>
            </div>
          </div>
        </div>

        <div class="pnl-support-card" onclick="location.href='/hosting/support'">
          <div>
            <div class="lbl">Support</div>
            <div class="big">{{.SupportOpen}} open</div>
            <div class="up">{{.SupportAgo}} &middot; <a href="/support" style="color:#18E888">NSM tickets &#8599;</a></div>
          </div>
          <div class="chev">&#8250;</div>
        </div>

        <div class="pnl-chips">
          <div class="pnl-chip"><span class="material-icons-outlined">error_outline</span> Incidents <b>No incidents</b></div>
          <div class="pnl-chip"><span class="material-icons-outlined">shield</span> DDoS <b>No attacks</b></div>
          <div class="pnl-chip"><span class="material-icons-outlined">credit_card</span> Billing <b><a href="/hosting/billing" style="color:inherit;text-decoration:underline">{{.DueText}}</a></b></div>
          <div class="pnl-chip"><span class="material-icons-outlined">chat_bubble_outline</span> Discord <b><a href="https://discord.gg/UXj5QfCX88" target="_blank" rel="noopener" class="pnl-chip-link">click</a></b></div>
          <div class="pnl-chip"><span class="material-icons-outlined">cake</span> Birthday <b>Not provided</b></div>
        </div>
      </div>

      <div id="services">
        <div class="pnl-infra-head">
          <div>
            <div class="pnl-eyebrow">Infrastructure</div>
            <h2 class="pnl-h2">My services</h2>
          </div>
          <button class="pnl-customize" id="pnl-customize" onclick="pnlCustomize(this)">&#9881; Customize Dashboard <span class="cnt">1</span></button>
        </div>
        <div class="pnl-grid" id="pnl-grid">
          {{range .Servers}}
          <div class="pnl-card{{if ne .Status "online"}} is-off{{end}}" id="svc-{{.ID}}">
            <div class="row1">
              <span class="kind">NSM</span>
              <span class="pnl-pill {{if eq .Status "online"}}ok{{else}}off{{end}}" data-live-pill="{{.ID}}">{{.Status}}</span>
              <button class="pnl-fav {{if .Favorite}}on{{end}}" title="Favourite" onclick="pnlFav('{{.ID}}',this)">&#9733;</button>
            </div>
            <div class="nm">
              <span class="ic">&#9635;</span>
              <a href="/dashboard/{{.ID}}">{{.Name}}</a>
              <button class="pnl-copy" title="Copy name" onclick="pnlCopy('{{.Name}}')">&#128203;</button>
            </div>
            <span class="pnl-badge-imported">&#8599; Imported from NSM</span>
            <div class="pnl-meta">
              <div class="r"><span class="k"><span class="material-icons-outlined">lan</span> IP / Port</span><span class="v">{{$.HostPublic}} : {{.GameTCPPort}} <button class="pnl-copy" onclick="pnlCopy('{{$.HostPublic}}:{{.GameTCPPort}}')">&#128203;</button></span></div>
              <div class="r"><span class="k"><span class="material-icons-outlined">inventory_2</span> Package</span><span class="v">{{$.PKG.Slots}} slots &middot; {{$.PKG.RAMGB}} GB RAM &middot; {{$.PKG.DiskGB}} GB</span></div>
              <div class="r"><span class="k"><span class="material-icons-outlined">desktop_windows</span> System</span><span class="v">{{$.SystemName}}</span></div>
              <div class="r"><span class="k"><span class="material-icons-outlined">location_on</span> Location</span><span class="v">{{.Region}}</span></div>
              <div class="r"><span class="k"><span class="material-icons-outlined">schedule</span> Uptime</span><span class="v" data-uptime="{{.ID}}">{{if .LastStarted}}since {{.LastStarted}}{{else}}offline{{end}}</span></div>
            </div>
            <div class="pnl-card-actions" data-pwr-row="{{.ID}}">
              <a class="pnl-mini-btn green" href="/dashboard/{{.ID}}">Manage</a>
              <button class="pnl-mini-btn red" data-pwr="stop" onclick="pnlPower('{{.ID}}','stop',this)"{{if ne .Status "online"}} style="display:none"{{end}}>Stop</button>
              <button class="pnl-mini-btn green" data-pwr="start" onclick="pnlPower('{{.ID}}','start',this)"{{if eq .Status "online"}} style="display:none"{{end}}>Start</button>
              <button class="pnl-mini-btn" data-pwr="restart" onclick="pnlPower('{{.ID}}','restart',this)">Restart</button>
            </div>
          </div>
          {{end}}
          {{if lt .Total .MaxServers}}
          <a class="pnl-plus-card" href="/hosting/create" title="Deploy another NSM server">
            <span class="plus">+</span>
            <span class="plus-t">Deploy another server</span>
            <span class="plus-s">fresh city in about a minute</span>
          </a>
          {{end}}
        </div>
      </div>
    </div>
  </div>
</div>
<a class="pnl-fab" href="/hosting/support" title="Hosting support chat">&#128172;</a>
<script>
function pnlToast(msg){
  var t=document.getElementById('pnl-toast');
  if(!t){t=document.createElement('div');t.id='pnl-toast';document.body.appendChild(t);}
  t.textContent=msg;t.classList.add('show');
  clearTimeout(window.__nsmToastT);
  window.__nsmToastT=setTimeout(function(){t.classList.remove('show');},4200);
}
function pnlCopy(t){navigator.clipboard&&navigator.clipboard.writeText(t);}
function pnlPassColor(a,b){var r=document.documentElement.style;r.setProperty('--pnl-pass-a',a);r.setProperty('--pnl-pass-b',b);var p=document.getElementById('pnl-pass');if(p){p.style.setProperty('--pnl-pass-a',a);p.style.setProperty('--pnl-pass-b',b);}try{localStorage.setItem('nsmPassColor',JSON.stringify([a,b]));}catch(e){}}
(function(){try{var c=JSON.parse(localStorage.getItem('nsmPassColor')||'null');if(c){document.documentElement.style.setProperty('--pnl-pass-a',c[0]);document.documentElement.style.setProperty('--pnl-pass-b',c[1]);}}catch(e){}
  var h=new Date().getHours();var g=h<12?'Good morning':h<18?'Good afternoon':'Good evening';document.getElementById('pnl-greet').textContent=g;})();
var pnlACCENTS=[['#18E888','#0d9d5f','Green'],['#22d3ee','#0e7490','Cyan'],['#3b82f6','#1d4ed8','Blue'],['#a855f7','#7e22ce','Purple'],['#ec4899','#be185d','Pink'],['#f97316','#c2410c','Orange']];
function pnlSetAccent(a,b){var r=document.documentElement.style;
  r.setProperty('--pnl-accent',a);r.setProperty('--pnl-accent2',b);
  try{localStorage.setItem('nsmAccent',JSON.stringify([a,b]));}catch(e){}}
function pnlCustomize(btn){
  var pop=document.getElementById('pnl-accent-pop');
  if(pop){pop.remove();if(btn)btn.classList.remove('pnl-on');return;}
  pop=document.createElement('div');pop.id='pnl-accent-pop';
  var h='<div class="ap-t">Dashboard colour</div><div class="ap-row">';
  pnlACCENTS.forEach(function(c){h+='<button class="ap-sw" title="'+c[2]+'" onclick="pnlSetAccent(\''+c[0]+'\',\''+c[1]+'\')" style="background:linear-gradient(135deg,'+c[0]+','+c[1]+')"></button>';});
  h+='</div><div class="ap-row ap-foot"><button class="pnl-mini-btn" onclick="pnlCompact(this)">Compact cards</button><button class="pnl-mini-btn" onclick="pnlSetAccent(\'#18E888\',\'#0d9d5f\')">Reset</button></div>';
  pop.innerHTML=h;
  btn.parentNode.appendChild(pop);
  btn.classList.add('pnl-on');
}
function pnlCompact(){var g=document.getElementById('pnl-grid');if(!g)return;var on=g.classList.toggle('pnl-compact');try{localStorage.setItem('nsmCompact',on?'1':'0');}catch(e){}}
(function(){
  try{var c=JSON.parse(localStorage.getItem('nsmAccent')||'null');if(c)pnlSetAccent(c[0],c[1]);}catch(e){}
  try{if(localStorage.getItem('nsmCompact')==='1'){var g=document.getElementById('pnl-grid');if(g)g.classList.add('pnl-compact');}}catch(e){}
})();
function pnlApplyCard(id,status){
  var card=document.getElementById('svc-'+id); if(card)card.classList.toggle('is-off',status!=='online');
  var row=document.querySelector('[data-pwr-row="'+id+'"]'); if(!row)return;
  var stop=row.querySelector('[data-pwr="stop"]'),start=row.querySelector('[data-pwr="start"]');
  var online=status==='online';
  if(stop){stop.style.display=online?'':'none';stop.disabled=false;}
  if(start){start.style.display=online?'none':'';start.disabled=false;}
}
function pnlPower(id,a,btn){
  if(btn)btn.disabled=true;
  fetch('/api/host/'+id+'/power/'+a,{method:'POST',credentials:'same-origin',cache:'no-store'}).then(function(r){return r.text();}).then(function(t){
    var d={};try{d=JSON.parse(t);}catch(e){throw new Error('server sent an unexpected response'+(t?': '+String(t).slice(0,120):''));}
    if(d&&d.error)throw new Error(d.error);
    pnlToast('Power: '+a+' requested');
    setTimeout(function(){pnlCardPoll();},1200);
  }).catch(function(e){pnlToast('Power action failed: '+String(e.message||e));if(btn)btn.disabled=false;});
}
function pnlFav(id,btn){btn.classList.toggle('on');}
function pnlServices(e){if(location.pathname==='/hosting/dashboard'){e.preventDefault();var el=document.getElementById('services');if(el)el.scrollIntoView({behavior:'smooth',block:'start'});}}
function pnlCardPoll(){
  document.querySelectorAll('[data-live-pill]').forEach(function(el){
    var id=el.getAttribute('data-live-pill');
    fetch('/api/host/'+id+'/stats').then(function(r){return r.json();}).then(function(d){
      el.textContent=d.status;el.className='pnl-pill '+(d.status==='online'?'ok':d.status==='error'?'bad':'off');
      pnlApplyCard(id,d.status);
    }).catch(function(){});
  });
}
window.__nsmTimers=window.__nsmTimers||[];
window.__nsmTimers.push(setInterval(pnlCardPoll,10000));
pnlCardPoll();
</script>
{{template "panel-foot" .}}
{{end}}

{{define "panel-manage"}}
