<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AFX Support</title>
  <link rel="icon" type="image/png" href="/img/afx-icon.png">
  <link rel="stylesheet" href="/css/style.css?v=078m">
</head>
<body class="afx-hc-body">
  <!-- Zendesk Help Center Header -->
  <header class="afx-hc-header">
    <div class="wrap afx-hc-hbar">
      <a href="/support" class="afx-hc-brand">
        <img src="/img/afx-icon.png" alt="AFX" style="width:30px;height:30px;border-radius:7px">
        <img src="/img/nsm-icon.png" alt="NSM" style="width:26px;height:26px">
        <span>AFX <strong>Support</strong></span>
      </a>

      <div class="afx-hc-nav">
        <a href="/">NSM Home</a>
        <a href="/servers">Server List</a>
        <a href="/keymaster">AFX Portal</a>
        <a href="/forum">Community Forum</a>
        {{if .User}}
        <a href="#my-requests">My Requests ({{len .MyTickets}})</a>
        {{if .IsStaff}}
        <a href="#staff-requests" style="color:#00f8b9;font-weight:700">Staff Queue ({{len .AllTickets}})</a>
        {{end}}
        {{end}}
        <a href="#submit-ticket" class="btn btn-ghost btn-sm">Submit a request</a>
        {{if .User}}
        <a href="/u/{{.User.Username}}" class="user-chip">
          <img src="{{.User.AvatarPath}}" alt="{{.User.Username}}" class="nav-avatar">
          <span>{{.User.EffectiveDisplayName}}</span>
        </a>
        {{else}}
        <a href="/login?next=/support" class="btn btn-primary btn-sm">Sign in</a>
        {{end}}
      </div>
    </div>
  </header>

  <!-- Zendesk Help Center Hero Banner with Instant Search -->
  <section class="afx-hc-hero">
    <div class="wrap afx-hc-hero-inner">
      <span class="afx-eyebrow" style="margin-bottom:10px;display:inline-flex">AFX HELP CENTER &amp; KNOWLEDGE BASE</span>
      <h1>How can we help you today?</h1>
      <div class="afx-hc-search-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" id="afx-hc-search" placeholder="Search articles, server setup, account linking, or error codes..." autocomplete="off">
      </div>
      <div class="afx-hc-popular-tags">
        <span>Popular:</span>
        <button type="button" class="nsm-loaf" data-hc-filter="login">In-App Sign In</button>
        <button type="button" class="nsm-loaf" data-hc-filter="keymaster">Server Keys</button>
        <button type="button" class="nsm-loaf" data-hc-filter="connect">Connect to Server</button>
        <button type="button" class="nsm-loaf" data-hc-filter="nta~">Founder Account</button>
      </div>
    </div>
  </section>

  <!-- Main Help Center Content -->
  <main class="wrap" style="padding:40px 24px 64px">
    {{if .Msg}}<div class="alert alert-ok" style="margin-bottom:20px">{{.Msg}}</div>{{end}}
    {{if .Error}}<div class="alert alert-err" style="margin-bottom:20px">{{.Error}}</div>{{end}}

    <!-- 6 Zendesk Category Blocks -->
    <div class="afx-hc-blocks-grid" id="afx-hc-categories">
      <a href="#promoted-articles" class="afx-hc-block" data-hc-cat="client login">
        <div class="afx-hc-block-icon"><img src="/img/nsm-icon.png" alt="NSM" style="width:28px;height:28px"></div>
        <h3>NSM Client &amp; Technical Support</h3>
        <p>Launching <code>NSM.exe</code>, clearing CEF cache, Direct Connect, audio/graphics settings, and game verification.</p>
      </a>

      <a href="/keymaster" class="afx-hc-block" data-hc-cat="keymaster portal server key">
        <div class="afx-hc-block-icon"><img src="/img/afx-icon.png" alt="AFX" style="width:28px;height:28px;border-radius:6px"></div>
        <h3>AFX Portal &amp; Registration Keys</h3>
        <p>Issuing, rotating, and revoking <code>nsm_srv_...</code> server keys in AFX Portal and binding IP endpoints.</p>
      </a>

      <a href="/docs#server-setup" class="afx-hc-block" data-hc-cat="server hosting cfg onesync">
        <div class="afx-hc-block-icon"><img src="/img/nsm-icon.png" alt="Server" style="width:28px;height:28px"></div>
        <h3>Dedicated Server Administration</h3>
        <p>Configuring <code>nsm-server.exe</code>, <code>server-local.cfg</code>, heartbeats on <code>/api/serverlist/ingress</code>, and OneSync.</p>
      </a>

      <a href="/account" class="afx-hc-block" data-hc-cat="account login nta~ profile avatar">
        <div class="afx-hc-block-icon"><img src="/img/afx-icon.png" alt="Account" style="width:28px;height:28px;border-radius:6px"></div>
        <h3>AFX Account &amp; In-App Sign-In</h3>
        <p>Linking your account inside <code>NSM.exe</code>, email verification, two-step authentication (2FA), and custom profiles.</p>
      </a>

      <a href="/marketplace" class="afx-hc-block" data-hc-cat="marketplace resources scripts mlo">
        <div class="afx-hc-block-icon"><img src="/img/afx-icon.png" alt="Marketplace" style="width:28px;height:28px;border-radius:6px"></div>
        <h3>AFX Marketplace &amp; Resources</h3>
        <p>Downloading verified NSM resources, installing scripts and custom MLOs, and managing granted assets.</p>
      </a>

      <a href="/docs#natives" class="afx-hc-block" data-hc-cat="scripting lua js csharp natives">
        <div class="afx-hc-block-icon"><img src="/img/nsm-icon.png" alt="Scripting" style="width:28px;height:28px"></div>
        <h3>Scripting, NUI &amp; Native Reference</h3>
        <p>Building Lua, JavaScript, and C# resources, CEF NUI interfaces, state bags, and server events.</p>
      </a>
    </div>

    <!-- My Support Requests (Strictly Private to the Logged-In User) -->
    <div class="afx-portal-card" id="my-requests" style="margin-top:36px">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px">
        <div>
          <h2 style="margin:0;font-size:1.25rem;color:#fff">My Support Requests</h2>
          <p class="muted" style="margin:4px 0 0;font-size:0.85rem">
            Only you and AFX Support Staff can view your submitted support requests.
          </p>
        </div>
        <a href="#submit-ticket" class="btn btn-primary btn-sm">+ Submit New Request</a>
      </div>

      {{if .User}}
        {{if .MyTickets}}
        <div style="overflow-x:auto">
          <table class="zd-requests-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Subject</th>
                <th>Category</th>
                <th>Created</th>
                <th>Last Activity</th>
                <th>Status</th>
                <th style="text-align:right">Action</th>
              </tr>
            </thead>
            <tbody>
              {{range .MyTickets}}
              <tr>
                <td><a href="/support/requests/{{.ID}}" style="font-family:var(--mono);color:#60a5fa;font-weight:700">#{{.ID}}</a></td>
                <td><a href="/support/requests/{{.ID}}" style="color:#fff;font-weight:600">{{.Subject}}</a></td>
                <td class="muted">{{.Category}}</td>
                <td class="muted">{{.CreatedStr}}</td>
                <td class="muted">{{.UpdatedStr}}</td>
                <td>
                  <span class="zd-status-pill status-{{.Status}}">{{.Status}}</span>
                </td>
                <td style="text-align:right">
                  <a href="/support/requests/{{.ID}}" class="btn btn-ghost btn-sm">View Request</a>
                </td>
              </tr>
              {{end}}
            </tbody>
          </table>
        </div>
        {{else}}
        <p class="muted" style="margin:0;font-size:0.9rem">You have not submitted any support requests yet. Use the <strong>Submit a Support Request</strong> form below to open a ticket.</p>
        {{end}}
      {{else}}
        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
          <p class="muted" style="margin:0;font-size:0.9rem">Sign in to your AFX account to view and manage your private support requests.</p>
          <a href="/login?next=/support" class="btn btn-primary btn-sm">Sign In to View My Requests</a>
        </div>
      {{end}}
    </div>

    <!-- Staff-Only All Users Support Queue (Visible ONLY to Staff, Admins & Owner nta~) -->
    {{if .IsStaff}}
    <div class="afx-portal-card" id="staff-requests" style="margin-top:24px;border-color:rgba(0,248,185,0.35)">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px">
        <div>
          <div style="display:flex;align-items:center;gap:8px">
            <span class="role role-owner">STAFF ONLY</span>
            <h2 style="margin:0;font-size:1.22rem;color:#fff">All Users' Support Requests ({{len .AllTickets}})</h2>
          </div>
          <p class="muted" style="margin:4px 0 0;font-size:0.84rem">
            Visible only to AFX Staff, Admins, and Founder (<code>nta~</code>). Regular users can only view their own tickets.
          </p>
        </div>
        <a href="/admin/users" class="btn btn-ghost btn-sm">Open Staff Control Panel &rarr;</a>
      </div>

      {{if .AllTickets}}
      <div style="overflow-x:auto">
        <table class="zd-requests-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Requester &amp; Email</th>
              <th>Subject</th>
              <th>Category</th>
              <th>Priority</th>
              <th>Updated</th>
              <th>Status</th>
              <th style="text-align:right">Action</th>
            </tr>
          </thead>
          <tbody>
            {{range .AllTickets}}
            <tr>
              <td><a href="/support/requests/{{.ID}}" style="font-family:var(--mono);color:#00f8b9;font-weight:700">#{{.ID}}</a></td>
              <td>
                <strong style="color:#fff">@{{.RequesterUsername}}</strong>
                <div class="muted" style="font-size:0.76rem">{{.RequesterEmail}}</div>
              </td>
              <td><a href="/support/requests/{{.ID}}" style="color:#fff;font-weight:600">{{.Subject}}</a></td>
              <td class="muted">{{.Category}}</td>
              <td class="muted">{{.Priority}}</td>
              <td class="muted">{{.UpdatedStr}}</td>
              <td><span class="zd-status-pill status-{{.Status}}">{{.Status}}</span></td>
              <td style="text-align:right">
                <a href="/support/requests/{{.ID}}" class="btn btn-primary btn-sm">Open &amp; Reply</a>
              </td>
            </tr>
            {{end}}
          </tbody>
        </table>
      </div>
      {{else}}
      <p class="muted" style="margin:0">No support requests in the queue yet.</p>
      {{end}}
    </div>
    {{end}}

    <!-- Closed Ticket Log: closed requests vanish from the working lists and are archived here -->
    {{if .User}}
    <div class="afx-portal-card" id="closed-log" style="margin-top:24px">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px">
        <div>
          <div style="display:flex;align-items:center;gap:8px">
            <span class="role" style="background:rgba(148,163,184,0.18);color:#94a3b8">ARCHIVE</span>
            <h2 style="margin:0;font-size:1.22rem;color:#fff">Closed Ticket Log ({{len .ClosedLog}})</h2>
          </div>
          <p class="muted" style="margin:4px 0 0;font-size:0.84rem">
            Closed requests are removed from the working lists above and kept here as a permanent record of what each ticket was about.
          </p>
        </div>
      </div>
      {{if .ClosedLog}}
      <div style="overflow-x:auto">
        <table class="zd-requests-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>What the ticket was about</th>
              <th>Category</th>
              <th>Requester</th>
              <th>Closed By</th>
              <th>Closed At</th>
            </tr>
          </thead>
          <tbody>
            {{range .ClosedLog}}
            <tr>
              <td><a href="/support/requests/{{.ID}}" style="font-family:var(--mono);color:#94a3b8;font-weight:700">#{{.ID}}</a></td>
              <td>
                <strong style="color:#cbd5e1">{{.Subject}}</strong>
                {{if .Excerpt}}<div class="muted" style="font-size:0.78rem;margin-top:2px">{{.Excerpt}}</div>{{end}}
              </td>
              <td class="muted">{{.Category}}</td>
              <td class="muted">@{{.RequesterUsername}}</td>
              <td class="muted">{{.ClosedBy}}</td>
              <td class="muted">{{.ClosedStr}}</td>
            </tr>
            {{end}}
          </tbody>
        </table>
      </div>
      {{else}}
      <p class="muted" style="margin:0">No closed tickets yet — closed requests will be archived here.</p>
      {{end}}
    </div>
    {{end}}

    <!-- Promoted Articles + Submit a Request 2-Column Section -->
    <div class="afx-hc-two-col" id="promoted-articles" style="margin-top:36px">
      <div>
        <h2 style="margin:0 0 16px;font-size:1.35rem;color:#fff">Promoted Knowledge-Base Articles</h2>
        <div class="nsm-faq-list" id="afx-hc-articles">
          <div class="nsm-faq-item open" data-hc-article="login sign in nsm.exe unknown auth discourse client">
            <button type="button" class="nsm-faq-q">
              <span>How to sign in to your AFX account inside NSM.exe</span>
              <span>+</span>
            </button>
            <div class="nsm-faq-a">
              <p style="margin:0 0 8px"><strong>1. Ensure <code>NSM-Masterlist.exe</code> is running on port 80:</strong> Start the local stack via <code>START-LOCALHOST.ps1</code> or run <code>NSM-Masterlist.exe -bind 127.0.0.1 -port 80</code>.</p>
              <p style="margin:0 0 8px"><strong>2. Sign in on AFX Portal or in-app:</strong> Click <strong>Sign In / Link Account</strong> in <code>NSM.exe</code>. If you are signed in on the web (<a href="/login" style="color:#00f8b9">/login</a>), <code>NSM.exe</code> links your account automatically within 1 second!</p>
              <p style="margin:0"><strong>3. Instant browser authorization:</strong> You can also visit <a href="/user-api-key/new" style="color:#00f8b9">https://nsmultiplayer.com/user-api-key/new</a> at any time and click <strong>Authorize NSM.exe</strong>.</p>
            </div>
          </div>

          <div class="nsm-faq-item" data-hc-article="nta~ owner account password claim setup">
            <button type="button" class="nsm-faq-q">
              <span>How to set up the nta~ Platform Founder account</span>
              <span>+</span>
            </button>
            <div class="nsm-faq-a">
              Open <a href="/login" style="color:#00f8b9">Login - AFX Portal (/login)</a> on <code>127.0.0.1</code>. On first run, use the <strong>One-Time Founder Setup (<code>nta~</code>)</strong> box to choose your owner password. Once configured, the setup popup disappears permanently and you can sign in directly as <code>nta~</code>.
            </div>
          </div>

          <div class="nsm-faq-item" data-hc-article="keymaster server key nsm_srv_ sv_nsmServerKey">
            <button type="button" class="nsm-faq-q">
              <span>How to generate a Server Key in AFX Portal and list your server</span>
              <span>+</span>
            </button>
            <div class="nsm-faq-a">
              Open <a href="/keymaster" style="color:#00f8b9">AFX Portal (/keymaster)</a>, enter your server's Display Name and optional IP:port, and click <strong>Generate Server Key</strong>. Copy the <code>sets sv_nsmServerKey "nsm_srv_..."</code> line into your <code>server.cfg</code> or <code>server-local.cfg</code> and launch <code>nsm-server.exe</code>.
            </div>
          </div>

          <div class="nsm-faq-item" data-hc-article="connect server list f8 console localhost">
            <button type="button" class="nsm-faq-q">
              <span>Connecting to a server via Server List or F8 Console</span>
              <span>+</span>
            </button>
            <div class="nsm-faq-a">
              Open <a href="/servers" style="color:#00f8b9">Server List - NSM (/servers)</a> and click <strong>Connect</strong> on any server row, or press <code>F8</code> inside <code>NSM.exe</code> and type <code>connect 127.0.0.1:30120</code>.
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Platform Status + Submit a Request -->
      <div style="display:flex;flex-direction:column;gap:20px">
        <div class="afx-portal-card" id="submit-ticket">
          <h3 style="margin:0 0 6px;font-size:1.12rem;color:#fff">Submit a Support Request</h3>
          <p class="muted" style="margin:0 0 14px;font-size:0.84rem">
            {{if .User}}Submit a report to AFX Support. You will be taken directly to your private request page where you and AFX Staff can reply.{{else}}You must be signed in to your AFX account to open a support request — this keeps every ticket tied to a real account.{{end}}
          </p>
          {{if .User}}
          <form method="post" action="/support/requests" class="form">
            <label>Your Email Address
              <input type="email" name="email" class="inp" value="{{if .User}}{{.User.Email}}{{end}}" placeholder="you@example.com" required>
            </label>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
              <label>Category
                <select name="category" class="inp">
                  <option value="Client &amp; Technical Support">Client &amp; Technical Support</option>
                  <option value="AFX Account, 2FA &amp; Email">AFX Account, 2FA &amp; Email</option>
                  <option value="Server Keys &amp; AFX Portal">Server Keys &amp; AFX Portal</option>
                  <option value="Player / Server Report">Player / Server Report</option>
                  <option value="Bug Report">Bug Report</option>
                </select>
              </label>
              <label>Priority
                <select name="priority" class="inp">
                  <option value="Normal" selected>Normal</option>
                  <option value="Low">Low</option>
                  <option value="High">High</option>
                  <option value="Urgent">Urgent</option>
                </select>
              </label>
            </div>
            <label>Subject
              <input type="text" name="subject" class="inp" placeholder="Brief summary of your report or issue" required>
            </label>
            <label>Server Endpoint / License Key (Optional)
              <input type="text" name="endpoint" class="inp" placeholder="e.g. 127.0.0.1:30120 or nsm_srv_...">
            </label>
            <label>Description
              <textarea name="body" class="inp" rows="4" placeholder="Include steps to reproduce, server endpoint, or error details..." required></textarea>
            </label>
            <button type="submit" class="btn btn-primary btn-block">Submit Support Report</button>
          </form>
          {{else}}
          <div style="padding:26px 18px;text-align:center;border:1px dashed rgba(255,255,255,0.14);border-radius:10px">
            <h4 style="margin:0 0 8px;color:#fff;font-size:1rem">Sign in required</h4>
            <p class="muted" style="margin:0 0 14px;font-size:0.85rem">Support requests are tied to AFX accounts so staff can follow up safely.</p>
            <a href="/login?next=/support%23submit-ticket" class="btn btn-primary btn-block">Sign In to Submit a Request</a>
          </div>
          {{end}}
        </div>

        <div class="afx-portal-card">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
            <h3 style="margin:0;font-size:1.05rem;color:#fff">AFX &amp; NSM Service Status</h3>
            <span class="role" style="background:rgba(0,248,185,0.18);color:#00f8b9">All Systems Operational</span>
          </div>
          <div class="afx-status-list">
            <div class="afx-status-row"><span>NSM Masterlist &amp; Protobuf Stream</span><strong style="color:#00f8b9">Operational</strong></div>
            <div class="afx-status-row"><span>AFX Portal &amp; Keymaster Auth</span><strong style="color:#00f8b9">Operational</strong></div>
            <div class="afx-status-row"><span>NSM.exe In-App Auth Bridge</span><strong style="color:#00f8b9">Operational</strong></div>
            <div class="afx-status-row"><span>AFX Forum &amp; Marketplace</span><strong style="color:#00f8b9">Operational</strong></div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer class="site-footer" style="margin-top:0">
    <div class="footer-bottom">
      <span>&copy; {{.Year}} AFX Support &amp; NSM Platform.</span>
      <div style="display:flex;gap:16px">
        <a href="/" style="color:rgba(240,244,248,0.65)">NSM Home</a>
        <a href="/servers" style="color:rgba(240,244,248,0.65)">Server List</a>
        <a href="/keymaster" style="color:rgba(240,244,248,0.65)">AFX Portal</a>
        <a href="/forum" style="color:rgba(240,244,248,0.65)">AFX Forum</a>
      </div>
    </div>
  </footer>
  <script src="/js/main.js?v=078m"></script>
</body>
</html>
