{{template "head" .}}
<section class="hero">
  <div class="container">
    <div class="spacer">
      <div class="copy">
        <h1>Create your server</h1>
        <p>One standard package, installed automatically. You need an NSM account — and every account can run one server.</p>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <div class="spacer">
      {{if .Error}}
      <div style="border:1px solid #e57373;border-radius:12px;padding:14px 18px;margin-bottom:22px;color:#ff9c9c">
        <strong>Could not create the server:</strong> {{.Error}}
      </div>
      {{end}}
      <div class="fx">
        <div class="c-lg-6 c-md-6 c-xs-12">
          <h2>Your package</h2>
          <table class="stat-table">
            <tr><td class="stat">Package</td><td>{{.PKG.Name}}</td></tr>
            <tr><td class="stat">Player slots</td><td>{{.PKG.Slots}}</td></tr>
            <tr><td class="stat">Memory</td><td>{{.PKG.RAMGB}} GB RAM allocation</td></tr>
            <tr><td class="stat">Storage</td><td>{{.PKG.DiskGB}} GB</td></tr>
            <tr><td class="stat">Price</td><td>Free</td></tr>
          </table>
          <p style="opacity:.8">The official server software is downloaded and installed for you, and your ports (from the 500-port pool, {{.First}}–{{.Last}}) are reserved and written into <code>server.cfg</code> automatically.</p>
        </div>
        <div class="c-lg-6 c-md-6 c-xs-12">
          <h2>Server details</h2>
          <form method="post" action="/hosting/create">
            <p><label>City name<br><input name="name" maxlength="40" placeholder="my-awesome-city" style="width:100%;padding:11px 14px;border-radius:10px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.06);color:inherit"></label></p>
            <p><label>Region<br>
              <select name="region" style="width:100%;padding:11px 14px;border-radius:10px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.06);color:inherit">
                <option value="us-east">US East</option>
                <option value="us-west">US West</option>
                <option value="eu-west">EU West</option>
                <option value="eu-central">EU Central</option>
                <option value="ap-singapore">Asia (Singapore)</option>
                <option value="ap-sydney">Australia (Sydney)</option>
              </select>
            </label></p>
            <p><button class="btn primary block" type="submit">Create my server</button></p>
            <p style="opacity:.75">Creating installs the server on our VPS — you manage it entirely from the dashboard. One server per NSM account.</p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
{{template "foot" .}}
