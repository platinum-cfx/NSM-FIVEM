{{template "head" .}}
<section class="hero zx-hero">
  <div class="container">
    <div class="spacer">
      <div class="zx-eyebrow"><span class="live-dot"></span> NSM HOSTING &mdash; CREATE</div>
      <h1 class="zx-hero-title">Create your server. <em>Go live.</em></h1>
      <div class="zx-hero-chips">
        <span class="zx-pill zx-pill-green">Free forever</span>
        <span class="zx-pill zx-pill-dark">One per account</span>
        <span class="zx-pill zx-pill-dark">Online in minutes</span>
      </div>
    </div>
  </div>
</section>

<main>
<section class="zx-band">
  <div class="container">
    <div class="spacer">
      {{if .Error}}
      <div class="zx-note-banner" style="border-color:rgba(231,80,80,.5);background:rgba(231,80,80,.1);color:#ff9c9c">
        <span class="material-icons-outlined" style="color:#ff9c9c">error_outline</span>
        <span><strong>Could not create the server:</strong> {{.Error}}</span>
      </div>
      {{end}}
      <form method="post" action="/hosting/create">
      <div class="zx-card-row" style="grid-template-columns:1.15fr .85fr">
        <div class="zx-order">
          <div class="zx-order-top"><span class="zx-pill zx-pill-green">Configure</span> Server details</div>
            <p style="margin:0 0 18px">
              <span class="zx-field-lbl">SERVER_NAME</span>
              <input name="name" maxlength="40" placeholder="my-awesome-city" style="width:100%;padding:12px 14px;border-radius:10px">
              <span class="zx-field-hint">Shown to players in the server list.</span>
            </p>
            <span class="zx-field-lbl">REGION</span>
            <div class="zx-loc-grid">
              <label class="zx-loc"><input type="radio" name="region" value="us-east" checked><span class="cd">US-E</span><span class="nm">US East</span></label>
              <label class="zx-loc"><input type="radio" name="region" value="us-west"><span class="cd">US-W</span><span class="nm">US West</span></label>
              <label class="zx-loc"><input type="radio" name="region" value="eu-west"><span class="cd">EU-W</span><span class="nm">EU West</span></label>
              <label class="zx-loc"><input type="radio" name="region" value="eu-central"><span class="cd">EU-C</span><span class="nm">EU Central</span></label>
              <label class="zx-loc"><input type="radio" name="region" value="ap-singapore"><span class="cd">AP-SE</span><span class="nm">Asia (Singapore)</span></label>
              <label class="zx-loc"><input type="radio" name="region" value="ap-sydney"><span class="cd">AP-SY</span><span class="nm">Australia (Sydney)</span></label>
            </div>
            <p class="zx-note" style="margin:18px 0 0">Creating installs the server on our VPS &mdash; you manage it entirely from the dashboard. One server per NSM account.</p>
        </div>
        <div class="zx-order">
          <div class="zx-order-top"><span class="zx-pill zx-pill-green">Order</span> Your package</div>
          <div class="zx-tierchips"><span class="zx-tierchip on">{{.PKG.Slots}} slots</span><span class="zx-tierchip">{{.PKG.RAMGB}} GB RAM</span><span class="zx-tierchip">{{.PKG.DiskGB}} GB</span><span class="zx-tierchip">{{.PKG.Ports}} ports</span></div>
          <div class="zx-price">€0 <span>/ forever</span></div>
          <ul class="zx-checks">
            <li>{{.PKG.Name}} &mdash; the standard package</li>
            <li>Official server software, installed for you</li>
            <li>Ports reserved automatically ({{.First}}&ndash;{{.Last}} pool)</li>
            <li>Console, files, Config tab &amp; private join link</li>
          </ul>
          <div class="zx-order-top" style="margin:6px 0 0"><span class="zx-pill zx-pill-dark">Due today</span> <strong style="color:#fff;font-family:var(--font-mono)">Free</strong></div>
          <button class="btn primary block" type="submit" style="width:100%;margin-top:14px">Create my server</button>
          <p class="zx-field-hint" style="text-align:center;margin-top:10px">No payment required &middot; delete anytime</p>
        </div>
      </div>
      </form>
    </div>
  </div>
</section>

{{template "foot" .}}
