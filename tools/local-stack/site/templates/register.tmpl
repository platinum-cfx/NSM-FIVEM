<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Account - AFX Portal</title>
  <link rel="icon" type="image/png" href="/img/afx-icon.png">
  <link rel="stylesheet" href="/css/style.css?v=078m">
</head>
<body class="afx-portal-auth-body">
  <div class="afx-portal-topbar">
    <a href="/" class="afx-portal-brand">
      <img src="/img/afx-icon.png" alt="AFX" style="width:28px;height:28px;border-radius:6px">
      <span>AFX <strong>Portal</strong></span>
    </a>
    <div class="afx-portal-top-links">
      <a href="/servers">Server List</a>
      <a href="/forum">AFX Forum</a>
      <a href="/marketplace">Marketplace</a>
      <a href="/docs">Documentation</a>
      <a href="/support">AFX Support</a>
    </div>
  </div>

  <main class="afx-portal-auth-main">
    <div class="afx-portal-auth-card">
      <div class="afx-portal-auth-logo">
        <img src="/img/afx-icon.png" alt="AFX" style="width:44px;height:44px;border-radius:10px">
        <img src="/img/nsm-afx-logo.png" alt="NSM Community" style="height:36px;width:auto">
      </div>

      <h1>Create your AFX Account</h1>
      <p class="muted" style="margin:0 0 20px;font-size:0.9rem;line-height:1.5">
        One unified AFX account for NSM.exe in-game login, server registration keys, custom avatars, and the community forum.
      </p>

      {{if .Error}}<div class="alert alert-err" style="margin-bottom:16px">{{.Error}}</div>{{end}}

      <form method="post" action="/register" class="form">
        <input type="hidden" name="next" value="{{.Next}}">
        <label>Username (3–24 characters)
          <input type="text" name="username" class="inp" required minlength="3" maxlength="24" placeholder="Choose your username" autofocus>
        </label>
        <label>Email Address (required — we send your 6-digit verification code)
          <input type="email" name="email" class="inp" required placeholder="you@example.com">
        </label>
        <label>Password (6+ characters)
          <input type="password" name="password" class="inp" required minlength="6" placeholder="Create a strong password">
        </label>
        <button type="submit" class="btn btn-primary btn-block" style="padding:12px 18px;font-size:0.95rem">Create AFX Account</button>
      </form>

      {{if .GoogleEnabled}}
      <div style="display:flex;align-items:center;gap:12px;margin:18px 0 4px">
        <span style="flex:1;height:1px;background:rgba(255,255,255,0.1)"></span>
        <span class="muted" style="font-size:0.78rem;text-transform:uppercase;letter-spacing:0.08em">or</span>
        <span style="flex:1;height:1px;background:rgba(255,255,255,0.1)"></span>
      </div>
      <a href="/auth/google{{if .Next}}?next={{urlquery .Next}}{{end}}" class="btn btn-ghost btn-block" style="padding:11px 18px;display:flex;align-items:center;justify-content:center;gap:10px">
        <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.2 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.2 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.1-4.1 5.6l6.2 5.2C41 34.9 44 30 44 24c0-1.3-.1-2.6-.4-3.9z"/></svg>
        Sign up with Google
      </a>
      {{end}}

      <div class="afx-portal-auth-links">
        <span>Already have an AFX account? <a href="/login{{if .Next}}?next={{.Next}}{{end}}">Sign in to AFX Portal</a></span>
      </div>
    </div>
  </main>
  <script src="/js/main.js?v=078m"></script>
</body>
</html>
