{{template "head" .}}
{{$s := .S}}{{$tab := .Tab}}
<link rel="stylesheet" href="/css/zapx.css?v=4">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<section class="zx-hero zx-host-hero" style="padding-bottom:20px">
  <div class="container">
    <div class="zx-ticker">
      <a class="zx-tick" href="/hosting/manage" data-no-spa="1">← NSM Hosting</a>
      <span class="zx-tick {{if eq $s.Status "online"}}zx-tick-ok{{end}}"><span class="live-dot" style="background:{{if eq $s.Status "online"}}var(--zx-green){{else}}#6d7f92{{end}}"></span> {{$s.Status}}</span>
      <span class="zx-tick">{{$s.Name}} &middot; {{.PKG.Name}} &middot; {{$s.Region}}</span>
    </div>
    <div class="zx-hero-lead" style="max-width:none">
      <p class="zx-eyebrow">Server dashboard</p>
      <h1 class="zx-h1" style="font-size:clamp(2rem,3.6vw,2.7rem)">{{$s.Name}}</h1>
      <div class="zx-hero-cta">
        <button class="btn primary" onclick="power('start')">START</button>
        <button class="btn zx-btn-ghost" onclick="power('stop')">STOP</button>
        <button class="btn zx-btn-ghost" onclick="power('restart')">RESTART</button>
        <a class="btn zx-btn-ghost" href="/join/{{$s.JoinCode}}" data-no-spa="1" target="_blank">OPEN JOIN LINK</a>
        <button class="btn zx-btn-ghost" onclick="deleteServer()" style="color:#ff9c9c;border-color:rgba(231,80,80,.5)">DELETE</button>
      </div>
      {{if $s.Note}}<p class="zx-note" style="color:#e8b45c">{{$s.Note}}</p>{{end}}
    </div>
  </div>
</section>

<section class="zx-picks" style="padding-top:26px">
  <div class="container">
  <div class="zx-panel-wrap">
    <nav class="zx-side">
      <div class="zx-side-head">NSM Panel</div>
      <a class="zx-side-item{{if eq $tab "console"}} zx-side-on{{end}}" href="/dashboard/{{$s.ID}}?tab=console" data-no-spa="1"><span class="zx-side-ic">&gt;</span> Console</a>
      <a class="zx-side-item{{if eq $tab "overview"}} zx-side-on{{end}}" href="/dashboard/{{$s.ID}}?tab=overview" data-no-spa="1"><span class="zx-side-ic">&#9678;</span> Overview</a>
      <a class="zx-side-item{{if eq $tab "config"}} zx-side-on{{end}}" href="/dashboard/{{$s.ID}}?tab=config" data-no-spa="1"><span class="zx-side-ic">&#9998;</span> Config</a>
      <a class="zx-side-item{{if eq $tab "files"}} zx-side-on{{end}}" href="/dashboard/{{$s.ID}}?tab=files" data-no-spa="1"><span class="zx-side-ic">&#8801;</span> Files</a>
      <a class="zx-side-item{{if eq $tab "ports"}} zx-side-on{{end}}" href="/dashboard/{{$s.ID}}?tab=ports" data-no-spa="1"><span class="zx-side-ic">#</span> Ports</a>
      <a class="zx-side-item" href="/hosting/manage" data-no-spa="1"><span class="zx-side-ic">&#8592;</span> My server</a>
    </nav>
    <div class="zx-panel-main">

  {{if eq $tab "console"}}
    <div class="zx-order">
      <div class="zx-order-top"><span class="zx-pill {{if eq $s.Status "online"}}zx-pill-green{{else}}zx-pill-dark{{end}}">{{$s.Status}}</span> Server console</div>
      <div class="zx-console" style="margin:0">
        <div class="zx-console-top"><span class="zx-dot g"></span>&nbsp; {{$s.Name}} — live output</div>
        <div class="zx-console-body" id="conout" style="max-height:440px;overflow-y:auto">waiting for output…</div>
      </div>
      <form id="cmdform" style="display:flex;gap:10px;margin-top:14px">
        <input id="cmdinput" style="flex:1" placeholder="type a server command and press Enter" autocomplete="off">
        <button class="btn primary" type="submit">SEND</button>
      </form>
      <p class="zx-note">Commands run inside your server process. If the server is offline, press Start above.</p>
    </div>
  {{end}}

  {{if eq $tab "overview"}}
    {{if .PkgWarn}}
    <div class="zx-order" style="border:1px solid rgba(255,120,90,.45)">
      <div class="zx-order-top"><span class="zx-pill" style="background:rgba(255,120,90,.2);color:#ffb199">Warning</span> Server files look wrong</div>
      <p class="zx-note" style="margin:0">{{.PkgWarn}}</p>
    </div>
    {{end}}
    <div class="zx-order" style="margin-bottom:18px">
      <div class="zx-order-top"><span class="zx-pill zx-pill-dark">Network</span> If players cannot connect</div>
      <p class="zx-note" style="margin:0">{{.Firewall}}</p>
    </div>
    <div class="zx-fact-grid" style="grid-template-columns:repeat(4,minmax(0,1fr))">
      <div class="zx-fact"><span class="num" id="u-cpu">—</span><span class="lbl">CPU usage</span></div>
      <div class="zx-fact"><span class="num" id="u-ram">—</span><span class="lbl">RAM usage</span></div>
      <div class="zx-fact"><span class="num" id="u-disk">—</span><span class="lbl">disk usage</span></div>
      <div class="zx-fact"><span class="num" id="u-uptime">—</span><span class="lbl">uptime</span></div>
    </div>
    <div class="zx-order" style="margin-top:22px">
      <div class="zx-order-top"><span class="zx-pill {{if eq $s.Status "online"}}zx-pill-green{{else}}zx-pill-dark{{end}}">Status</span> Server details</div>
      <ul class="zx-checks" style="margin:0">
        <li>Name: <strong>{{$s.Name}}</strong> &nbsp;·&nbsp; Server ID: <code>{{$s.ID}}</code></li>
        <li>Status: <strong id="u-status">{{$s.Status}}</strong> &nbsp;·&nbsp; Players online: {{.Players}}</li>
        <li>Endpoint (players never see this): <code>{{$s.Endpoint}}</code></li>
        <li>Game port (TCP + UDP): <code>{{$s.GameUDPPort}}</code></li>
        <li>Server version: <code>{{if $s.ExeRel}}{{$s.ExeRel}}{{else}}—{{end}}</code></li>
        <li>Package: {{.PKG.Name}} — {{.PKG.Slots}} slots, {{.PKG.RAMGB}} GB RAM allocation, {{.PKG.DiskGB}} GB storage</li>
        {{if $s.LastStarted}}<li>Last started: <span class="zx-reltime" data-t="{{$s.LastStarted}}">{{$s.LastStarted}}</span></li>{{end}}
      </ul>
    </div>
    <div class="zx-order" style="margin-top:18px">
      <div class="zx-order-top"><span class="zx-pill zx-pill-green">Join</span> Your private join link</div>
      <p style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
        <code id="joinurl" style="background:rgba(118,192,67,.12);color:var(--zx-green-hi);padding:10px 14px;border-radius:10px;font-size:.95rem">{{.JoinBase}}/join/{{$s.JoinCode}}</code>
        <button class="btn" onclick="navigator.clipboard.writeText(document.getElementById('joinurl').textContent)">COPY</button>
      </p>
    </div>
  {{end}}

  {{if eq $tab "config"}}
    <div class="zx-order">
      <div class="zx-order-top"><span class="zx-pill zx-pill-green">Config</span> server.cfg — the configuration your server runs on</div>
      <p class="zx-note" style="margin:0 0 12px">Everything your server loads lives here: its name, slots, resources (<code>ensure</code> lines) and connection settings. Edit below and press <strong>Save</strong>, then restart the server for changes to take effect. (FileZilla users: this same file is <code>/server.cfg</code> at the FTP root.)</p>
      <textarea id="cfgtext" spellcheck="false" style="width:100%;min-height:420px;font:13px/1.5 ui-monospace,Consolas,monospace;background:rgba(10,14,22,.75);color:#d8e2f0;border:1px solid rgba(118,192,67,.25);border-radius:12px;padding:14px">loading…</textarea>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:12px">
        <button class="btn primary" onclick="cfgSave()">SAVE CONFIG</button>
        <button class="btn" onclick="cfgSaveRestart()">SAVE &amp; RESTART SERVER</button>
        <span id="cfgmsg" style="color:var(--zx-green-hi)"></span>
      </div>
    </div>
  {{end}}

  {{if eq $tab "files"}}
    <div class="zx-order">
      <div class="zx-order-top"><span class="zx-pill zx-pill-green">Files</span> FileZilla access</div>
      <ul class="zx-checks" style="margin:0 0 16px">
        <li>To edit your server configuration use the <strong>Config</strong> tab — or open <code>/server.cfg</code> right here in the Manager below / over FTP</li>
        <li>Protocol: <strong>FTP — Plain</strong> or <strong>FTP over explicit TLS</strong> (AUTH TLS) — both work</li>
        <li>Server: <code>{{.Host}}:{{$s.FTPPort}}</code> — use this exact port (NOT 21; port 21 is a different service)</li>
        <li>The root folder IS your server: <code>server.cfg</code>, <code>resources/</code> and the server files are right there — going up stays at the root</li>
        <li>The FTP greeting must say <code>220 NSM Hosting FTP ready</code> — if it does not, you are on the wrong service</li>
        <li>User: <code>{{$s.FTPUser}}</code> (your NSM name) &nbsp; Password: <code>{{$s.FTPPass}}</code></li>
        <li>Passive mode on &mdash; data port <code>{{$s.PassivePort}}</code></li>
      </ul>
      <a class="btn primary" href="/api/host/{{$s.ID}}/filezilla.xml" data-no-spa="1">DOWNLOAD FILEZILLA PROFILE</a>
    </div>
    <div class="zx-order" style="margin-top:18px">
      <div class="zx-order-top"><span class="zx-pill zx-pill-dark">Manager</span> Server files on the VPS</div>
      <p class="zx-note" style="margin:0 0 10px">Path: <code id="fpath">/</code></p>
      <div id="filetable" style="min-height:120px"></div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:12px">
        <button class="btn" onclick="fmUp()">↑ Up</button>
        <button class="btn" onclick="fmMkdir()">New folder</button>
        <form id="upform" method="post" action="/api/host/{{$s.ID}}/upload" enctype="multipart/form-data" data-no-spa="1" style="display:flex;gap:8px">
          <input type="hidden" name="path" id="uppath" value="">
          <input type="file" name="file" required>
          <button class="btn primary" type="submit">Upload</button>
        </form>
      </div>
    </div>
    <div class="zx-order" id="editor" style="margin-top:18px;display:none">
      <div class="zx-order-top"><span class="zx-pill zx-pill-dark">Edit</span> <span id="edname"></span></div>
      <textarea id="edtext" rows="14" style="width:100%;font-family:ui-monospace,Consolas,monospace"></textarea>
      <div style="display:flex;gap:10px;margin-top:12px">
        <button class="btn primary" onclick="fmSave()">Save file</button>
        <button class="btn" onclick="document.getElementById('editor').style.display='none'">Close</button>
      </div>
    </div>
  {{end}}

  {{if eq $tab "ports"}}
    <div class="zx-order">
      <div class="zx-order-top"><span class="zx-pill zx-pill-green">Network</span> Your ports</div>
      <p style="color:var(--zx-mut)">Reserved from the NSM hosting pool <strong>{{.First}}–{{.Last}}</strong> (500 ports, TCP and UDP). Ports stay reserved while your server exists — even while it is stopped.</p>
      <p class="zx-note" style="margin:10px 0 0"><strong>Firewall:</strong> {{.Firewall}}</p>
      <table class="stat-table" style="width:100%;margin-top:8px">
        <tr><td class="stat">Game TCP</td><td>{{$s.GameTCPPort}}</td><td>player connections &amp; query — written to server.cfg</td></tr>
        <tr><td class="stat">Game UDP</td><td>{{$s.GameUDPPort}}</td><td>game traffic — written to server.cfg</td></tr>
        <tr><td class="stat">Files</td><td>{{$s.FTPPort}}</td><td>FileZilla control port</td></tr>
        <tr><td class="stat">Data</td><td>{{$s.PassivePort}}</td><td>FileZilla passive transfers</td></tr>
        {{range $p := $s.ExtraPorts}}
        <tr><td class="stat">Extra</td><td>{{$p}}</td><td>reserved for your services</td></tr>
        {{end}}
      </table>
      <div style="display:flex;gap:10px;margin-top:16px;align-items:center">
        <button class="btn primary" onclick="allocPort()">ALLOCATE ANOTHER PORT</button>
        <span class="zx-note" id="portmsg" style="margin:0"></span>
      </div>
    </div>
  {{end}}

    </div>
  </div>
  </div>
</section>

<script>
(function () {
  var ID = "{{$s.ID}}";
  function post(url, body) {
    return fetch(url, {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body || {})});
  }
  window.power = function (a) {
    post('/api/host/' + ID + '/power/' + a).then(function () { location.reload(); });
  };
  window.deleteServer = function () {
    if (!confirm('Delete this server permanently? Its files and ports will be released.')) return;
    post('/api/host/' + ID + '/delete').then(function () { window.location.href = '/hosting/manage'; });
  };
  window.allocPort = function () {
    post('/api/host/' + ID + '/ports').then(function (r) { return r.json(); }).then(function (d) {
      if (d.port) { location.reload(); }
      else { document.getElementById('portmsg').textContent = d.error || 'failed'; }
    });
  };

  // ---- console (live, auto-refresh) ----
  var out = document.getElementById('conout');
  if (out) {
    var since = 0;
    function poll() {
      fetch('/api/host/' + ID + '/console?since=' + since).then(function (r) { return r.json(); }).then(function (d) {
        if (d.lines && d.lines.length) {
          if (out.textContent.indexOf('waiting for output') === 0) out.textContent = '';
          d.lines.forEach(function (l) { out.textContent += l.line + '\n'; });
          since = d.seq;
          out.scrollTop = out.scrollHeight;
        }
      }).catch(function () {});
    }
    poll();
    setInterval(poll, 2000);
    document.getElementById('cmdform').addEventListener('submit', function (e) {
      e.preventDefault();
      var v = document.getElementById('cmdinput').value.trim();
      if (!v) return;
      post('/api/host/' + ID + '/command', {cmd: v}).then(function () { document.getElementById('cmdinput').value = ''; poll(); });
    });
  }

  // ---- real metrics (overview) ----
  if (document.getElementById('u-cpu')) {
    function fmtUp(s) {
      if (!s) return '—';
      var d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
      return (d ? d + 'd ' : '') + h + 'h ' + m + 'm';
    }
    function usage() {
      fetch('/api/host/' + ID + '/usage').then(function (r) { return r.json(); }).then(function (d) {
        document.getElementById('u-cpu').textContent = d.cpu < 0 ? 'n/a' : Math.round(d.cpu) + '%';
        document.getElementById('u-ram').textContent = d.ramMB < 0 ? 'n/a' : d.ramMB + ' MB';
        document.getElementById('u-disk').textContent = d.diskMB + ' MB';
        document.getElementById('u-uptime').textContent = d.online ? fmtUp(d.uptimeSec) : 'offline';
      }).catch(function () {});
    }
    usage();
    setInterval(usage, 5000);
    var rt = document.querySelector('.zx-reltime');
    if (rt) rt.textContent = new Date(parseInt(rt.getAttribute('data-t'), 10) * 1000).toLocaleString();
  }

  // ---- file manager (real server filesystem) ----
  var cur = '';
  window.fmList = function (p) {
    cur = p || '';
    fetch('/api/host/' + ID + '/files?path=' + encodeURIComponent(cur)).then(function (r) { return r.json(); }).then(function (d) {
      document.getElementById('fpath').textContent = '/' + (d.path || '');
      document.getElementById('uppath').value = d.path || '';
      var t = document.getElementById('filetable');
      if (!d.entries || !d.entries.length) { t.innerHTML = '<p class="zx-note">empty folder</p>'; return; }
      var html = '<table class="stat-table" style="width:100%"><tr><td class="stat">Name</td><td class="stat">Size</td><td></td></tr>';
      d.entries.forEach(function (e) {
        var sz = e.dir ? '—' : e.size + ' B';
        var open = e.dir ? 'fmList(\'' + e.path + '\')' : 'fmEdit(\'' + e.path + '\')';
        html += '<tr><td><a href="#" onclick="' + open + ';return false">' + e.name + '</a></td><td>' + sz + '</td>' +
          '<td><a href="#" onclick="fmDownload(\'' + e.path + '\');return false">download</a> · ' +
          '<a href="#" onclick="fmRename(\'' + e.path + '\');return false">rename</a> · ' +
          '<a href="#" onclick="fmDel(\'' + e.path + '\');return false">delete</a></td></tr>';
      });
      html += '</table>';
      t.innerHTML = html;
    });
  };
  window.fmUp = function () {
    var i = cur.lastIndexOf('/');
    fmList(i < 0 ? '' : cur.substring(0, i));
  };
  window.fmEdit = function (p) {
    fetch('/api/host/' + ID + '/file?path=' + encodeURIComponent(p)).then(function (r) { return r.json(); }).then(function (d) {
      document.getElementById('editor').style.display = 'block';
      document.getElementById('edname').textContent = p;
      document.getElementById('edtext').value = d.content || '';
    });
  };
  window.fmSave = function () {
    post('/api/host/' + ID + '/file/write', {path: document.getElementById('edname').textContent, content: document.getElementById('edtext').value})
      .then(function () { fmList(cur); });
  };
  window.fmDownload = function (p) {
    window.location.href = '/api/host/' + ID + '/file/download?path=' + encodeURIComponent(p);
  };
  window.fmRename = function (p) {
    var n = prompt('Rename to:', p.split('/').pop());
    if (!n) return;
    var dir = p.indexOf('/') < 0 ? '' : p.substring(0, p.lastIndexOf('/') + 1);
    post('/api/host/' + ID + '/file/op', {op: 'rename', path: p, to: dir + n}).then(function () { fmList(cur); });
  };
  window.fmDel = function (p) {
    if (!confirm('Delete ' + p + '?')) return;
    post('/api/host/' + ID + '/file/op', {op: 'delete', path: p}).then(function () { fmList(cur); });
  };
  window.fmMkdir = function () {
    var n = prompt('Folder name:');
    if (!n) return;
    post('/api/host/' + ID + '/file/op', {op: 'mkdir', path: (cur ? cur + '/' : '') + n}).then(function () { fmList(cur); });
  };
  if (document.getElementById('filetable')) fmList('');

  // ---- config editor (server.cfg) ----
  if (document.getElementById('cfgtext')) {
    fetch('/api/host/' + ID + '/file?path=server.cfg').then(function (r) { return r.json(); }).then(function (d) {
      var ta = document.getElementById('cfgtext');
      ta.value = d.content || d.error || '';
    });
    window.cfgSave = function () {
      post('/api/host/' + ID + '/file/write', {path: 'server.cfg', content: document.getElementById('cfgtext').value})
        .then(function (r) { return r.json(); }).then(function (d) {
          document.getElementById('cfgmsg').textContent = d.ok ? 'Saved. Restart the server to apply changes.' : ('Save failed: ' + (d.error || ''));
        });
    };
    window.cfgSaveRestart = function () {
      document.getElementById('cfgmsg').textContent = 'Saving…';
      post('/api/host/' + ID + '/file/write', {path: 'server.cfg', content: document.getElementById('cfgtext').value})
        .then(function () { return post('/api/host/' + ID + '/power/restart'); })
        .then(function () { document.getElementById('cfgmsg').textContent = 'Saved — restarting the server…'; });
    };
  }
})();
</script>
{{template "foot" .}}
