{{template "head" .}}

<section class="wrap section auth-wrap" style="max-width:560px">
  <!-- Discourse syntheticAuth() DOMParser fields consumed by NSM.exe in-app login -->
  <div style="display:none" aria-hidden="true">
    <input type="hidden" name="authenticity_token" value="nsm-csrf-token">
    <input type="hidden" name="application_name" value="{{.AppName}}">
    <input type="hidden" name="nonce" value="{{.Nonce}}">
    <input type="hidden" name="client_id" value="{{.ClientID}}">
    <input type="hidden" name="auth_redirect" value="{{.AuthRedirect}}">
    <input type="hidden" name="public_key" value="{{.PublicKey}}">
    <input type="hidden" name="scopes" value="{{if .Scopes}}{{.Scopes}}{{else}}session_info,read,write{{end}}">
  </div>

  <div class="auth-card">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
      <span class="brand-mark">NSM</span>
      <div>
        <h1 style="margin:0;font-size:22px">NSM Client Account Authorization</h1>
        <p class="muted" style="margin:2px 0 0;font-size:13px">Sign in on the website to log in inside the NSM desktop application</p>
      </div>
    </div>

    {{if .Error}}<div class="alert alert-err" style="margin-bottom:14px">{{.Error}}</div>{{end}}

    {{if .Authorized}}
      <div class="alert alert-ok" style="margin-bottom:16px">
        <strong>Signed in to NSM as {{.User.EffectiveDisplayName}} (@{{.User.Username}})!</strong><br>
        Your NSM desktop client is receiving your encrypted session key right now. You can return to the NSM window.
      </div>
      <div style="display:flex;align-items:center;gap:12px;padding:14px;background:var(--bg2);border:1px solid var(--line);border-radius:10px;margin-bottom:16px">
        <img src="{{.User.AvatarPath}}" alt="{{.User.Username}}" class="nav-avatar" style="width:48px;height:48px">
        <div>
          <div style="font-weight:700">{{.User.EffectiveDisplayName}} <span class="role role-{{.User.Role}}">{{.User.Role}}</span></div>
          <div class="muted" style="font-size:12px">{{.User.EffectiveTitle}}</div>
        </div>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        {{if .RedirectURI}}
        <a href="{{.RedirectURI}}" id="nsm-deep-link" class="btn btn-primary">Open NSM Client</a>
        {{end}}
        <a href="/account" class="btn btn-ghost">Customize My Profile &amp; Avatar</a>
        <a href="/servers" class="btn btn-ghost">Browse Servers</a>
      </div>
      {{if .RedirectURI}}
      <script>
        setTimeout(function() {
          window.location.href = {{.RedirectURI}};
        }, 250);
      </script>
      {{end}}

    {{else if .User}}
      <p class="muted" style="margin-bottom:14px">
        <strong>{{.AppName}}</strong> is requesting permission to link with your NSM account:
      </p>
      <div style="display:flex;align-items:center;gap:12px;padding:14px;background:var(--bg2);border:1px solid var(--line);border-radius:10px;margin-bottom:18px">
        <img src="{{.User.AvatarPath}}" alt="{{.User.Username}}" class="nav-avatar" style="width:48px;height:48px">
        <div>
          <div style="font-weight:700">{{.User.EffectiveDisplayName}} <span class="role role-{{.User.Role}}">{{.User.Role}}</span></div>
          <div class="muted" style="font-size:12px">@{{.User.Username}} &bull; {{.User.EffectiveTitle}}</div>
        </div>
      </div>
      <form method="post" action="/user-api-key/new" class="form">
        <input type="hidden" name="action" value="authorize">
        <input type="hidden" name="authenticity_token" value="nsm-csrf-token">
        <input type="hidden" name="client_id" value="{{.ClientID}}">
        <input type="hidden" name="nonce" value="{{.Nonce}}">
        <input type="hidden" name="public_key" value="{{.PublicKey}}">
        <input type="hidden" name="application_name" value="{{.AppName}}">
        <input type="hidden" name="auth_redirect" value="{{.AuthRedirect}}">
        <input type="hidden" name="scopes" value="{{if .Scopes}}{{.Scopes}}{{else}}session_info,read,write{{end}}">
        <button type="submit" class="btn btn-primary btn-block btn-lg">Authorize &amp; Sign In to NSM Client</button>
      </form>
      <p class="muted" style="margin-top:14px;font-size:12px;text-align:center">
        Not {{.User.Username}}? <a href="/logout">Switch account</a>
      </p>

    {{else}}
      <p class="muted" style="margin-bottom:16px">
        Sign in with your NSM account (or create one below) to log in inside the <strong>NSM Client</strong>.
      </p>
      <form method="post" action="/user-api-key/new" class="form" style="margin-bottom:20px">
        <input type="hidden" name="action" value="login">
        <input type="hidden" name="authenticity_token" value="nsm-csrf-token">
        <input type="hidden" name="client_id" value="{{.ClientID}}">
        <input type="hidden" name="nonce" value="{{.Nonce}}">
        <input type="hidden" name="public_key" value="{{.PublicKey}}">
        <input type="hidden" name="application_name" value="{{.AppName}}">
        <input type="hidden" name="auth_redirect" value="{{.AuthRedirect}}">
        <input type="hidden" name="scopes" value="{{if .Scopes}}{{.Scopes}}{{else}}session_info,read,write{{end}}">
        <label>Username or Email
          <input type="text" name="username" class="inp" required autofocus placeholder="e.g. Cravenz or cravenz@owner.local">
        </label>
        <label>Password
          <input type="password" name="password" class="inp" required placeholder="Your password">
        </label>
        <button type="submit" class="btn btn-primary btn-block">Sign In &amp; Connect NSM Client</button>
      </form>

      <div style="border-top:1px solid var(--line);padding-top:16px">
        <h3 style="font-size:16px;margin-bottom:10px">New to NSM? Create an Account &amp; Sign In</h3>
        <form method="post" action="/user-api-key/new" class="form">
          <input type="hidden" name="action" value="register">
          <input type="hidden" name="client_id" value="{{.ClientID}}">
          <input type="hidden" name="nonce" value="{{.Nonce}}">
          <input type="hidden" name="public_key" value="{{.PublicKey}}">
          <input type="hidden" name="application_name" value="{{.AppName}}">
          <input type="hidden" name="auth_redirect" value="{{.AuthRedirect}}">
          <div class="g2">
            <label>Username (3–24 chars)
              <input type="text" name="username" class="inp" required minlength="3" maxlength="24">
            </label>
            <label>Email (optional)
              <input type="email" name="email" class="inp">
            </label>
          </div>
          <label>Password (6+ characters)
            <input type="password" name="password" class="inp" required minlength="6">
          </label>
          <button type="submit" class="btn btn-ghost btn-block">Create Account &amp; Connect NSM Client</button>
        </form>
      </div>
    {{end}}
  </div>
</section>

{{template "foot" .}}
