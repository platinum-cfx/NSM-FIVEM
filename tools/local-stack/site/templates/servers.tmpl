{{define "nsm_server_launcher"}}
<div class="mp-app-frame" id="nsm-mp-app">
  <!-- NSM.exe Top NavBar (HomeButton + ListTypeTabs + ServerFiltersWithDirectConnect + PlatformStats + UserBar + Settings) -->
  <header class="mp-navbar">
    <div class="mp-navbar-left">
      <a href="/" class="mp-home-btn" title="Home — NSM">
        <img src="/img/nsm-icon.png" alt="NSM" class="mp-brand-icon">
      </a>

      <!-- ListTypeTabs (Tabular.Root size="large") -->
      <div class="mp-tabular-root" role="tablist" aria-label="Server Lists">
        <button type="button" class="mp-tabular-item active" data-tab="all" title="Browse All Servers">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <span class="mp-tab-label">Servers</span>
          <span class="mp-tab-badge" id="nsm-tab-count-all">{{len .Servers}}</span>
        </button>
        <button type="button" class="mp-tabular-item" data-tab="supporters" title="Supporters &amp; Boosted Servers">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="color:#00f8b9"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span class="mp-tab-label">Supporters</span>
        </button>
        <button type="button" class="mp-tabular-item" data-tab="history" title="Recently Joined Servers">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="color:#2096f3"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span class="mp-tab-label">History</span>
          <span class="mp-tab-badge" id="nsm-tab-count-history">0</span>
        </button>
        <button type="button" class="mp-tabular-item" data-tab="favorites" title="Favorite Servers">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="color:#f40552"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <span class="mp-tab-label">Favorites</span>
          <span class="mp-tab-badge" id="nsm-tab-count-favorites">0</span>
        </button>
      </div>

      <!-- ServerFiltersWithDirectConnect inside NavBar -->
      <div class="mp-navbar-filters">
        <div class="nsm-search-box" id="nsm-search-box">
          <span class="nsm-search-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </span>
          <div class="nsm-search-chips" id="nsm-search-chips"></div>
          <input type="text" id="nsm-server-search" placeholder="Search servers, tags, locales, or enter IP:port..." autocomplete="off">
          <button type="button" class="nsm-search-clear" id="nsm-search-clear" style="display:none" title="Clear search">&times;</button>

          <!-- DirectConnect Popover when typing IP:port -->
          <div class="mp-direct-connect-popover" id="nsm-direct-connect-popover" style="display:none">
            <div class="mp-dc-row">
              <span class="mp-dc-label" id="nsm-dc-label">Direct Connect to <code>127.0.0.1:30120</code></span>
              <button type="button" class="nsm-btn nsm-btn-primary nsm-btn-sm" id="nsm-dc-btn">Press Enter to Connect</button>
            </div>
          </div>
        </div>

        <!-- FilterPopover -->
        <div class="nsm-popover-anchor">
          <button type="button" class="nsm-ctrl-btn" id="nsm-filter-btn" title="Filter Servers">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            <span>Filters</span>
            <span class="nsm-filter-badge" id="nsm-filter-badge" style="display:none">0</span>
          </button>

          <div class="nsm-popover nsm-filter-popover" id="nsm-filter-popover" style="display:none">
            <div class="nsm-popover-section">
              <label class="nsm-checkbox-row">
                <input type="checkbox" id="nsm-hide-empty">
                <span class="nsm-checkbox-indicator"></span>
                <span>Hide Empty Servers</span>
              </label>
              <label class="nsm-checkbox-row">
                <input type="checkbox" id="nsm-hide-full">
                <span class="nsm-checkbox-indicator"></span>
                <span>Hide Full Servers</span>
              </label>
            </div>

            <div class="nsm-facet-tabs">
              <button type="button" class="nsm-facet-tab active" data-facet-tab="tags">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                Tags
              </button>
              <button type="button" class="nsm-facet-tab" data-facet-tab="locales">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                Locales
              </button>
            </div>

            <div class="nsm-facet-search-wrap">
              <input type="text" id="nsm-facet-search" placeholder="Search tags..." autocomplete="off">
            </div>

            <div class="nsm-facet-list" id="nsm-facet-tags-list"></div>
            <div class="nsm-facet-list" id="nsm-facet-locales-list" style="display:none"></div>
          </div>
        </div>

        <!-- SortPopover -->
        <div class="nsm-popover-anchor">
          <button type="button" class="nsm-ctrl-btn" id="nsm-sort-btn" title="Sort Servers">
            <span id="nsm-sort-label">Players</span>
            <span id="nsm-sort-dir-icon" class="nsm-sort-arrow">&#8595;</span>
          </button>

          <div class="nsm-popover nsm-sort-popover" id="nsm-sort-popover" style="display:none">
            <div class="nsm-sort-item" data-sort="boosts">
              <span class="label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg>
                Boosts
              </span>
              <span class="value" data-sort-ind="boosts"></span>
            </div>
            <div class="nsm-sort-item" data-sort="name">
              <span class="label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg>
                Name
              </span>
              <span class="value" data-sort-ind="name"></span>
            </div>
            <div class="nsm-sort-item active" data-sort="players">
              <span class="label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Players
              </span>
              <span class="value" data-sort-ind="players">&#8595;</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right side of NavBar: External Platform Links + PlatformStats + UserBar + Settings -->
    <div class="mp-navbar-right">
      <div class="mp-ext-links">
        <a href="/keymaster" class="mp-ext-link" title="Open AFX Portal">AFX Portal</a>
        <a href="/forum" class="mp-ext-link" title="Open AFX Forum">Forum</a>
        <a href="/marketplace" class="mp-ext-link" title="Open AFX Marketplace">Marketplace</a>
        <a href="/docs" class="mp-ext-link" title="Open NSM Documentation">Docs</a>
        <a href="/support" class="mp-ext-link" title="Open AFX Support">Support</a>
        {{if and .User .User.IsStaffOrHigher}}
        <a href="/admin/users" class="mp-ext-link" style="color:#6ea8ff;font-weight:700" title="Staff Panel">Staff</a>
        {{end}}
      </div>

      <div class="mp-platform-stats" title="Live NSM Masterlist Players &amp; Servers">
        <span class="mp-stat-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          <strong data-stat="players">{{if .Stats}}{{index .Stats "Players"}}{{else}}0{{end}}</strong>
        </span>
        <span class="mp-stat-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="7" rx="1.5"/><rect x="2" y="14" width="20" height="7" rx="1.5"/></svg>
          <strong id="nsm-visible-count">{{len .Servers}}</strong>
        </span>
      </div>

      {{if .User}}
      <a href="/u/{{.User.Username}}" class="mp-user-bar" title="Signed in as @{{.User.Username}} — Click for Profile">
        <img src="{{.User.AvatarPath}}" alt="{{.User.Username}}" class="mp-user-avatar">
        <span class="mp-user-name">{{.User.EffectiveDisplayName}}</span>
      </a>
      {{else}}
      <a href="/login" class="mp-user-bar mp-user-signin" title="Sign in to AFX &amp; NSM">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span>Sign In</span>
      </a>
      {{end}}

      <button type="button" class="mp-icon-btn" id="nsm-settings-btn" title="NSM Settings">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      </button>
    </div>
  </header>

  <!-- NSM.exe ServersPage Body: Left .list + Right .pinned (PinnedServers / Live Server Inspector) -->
  <div class="mp-page-body">
    <!-- Left: .list (exact NSM.exe ServerListItem rows) -->
    <div class="mp-servers-list-pane" id="nsm-server-list-body">
      <div class="mp-list-col-header">
        <span>ICON</span>
        <span>SERVER NAME &amp; GAMEMODE</span>
        <span>TAGS / ACTIONS</span>
        <span style="text-align:right">LOCALE &amp; BOOST</span>
        <span style="text-align:right">PLAYERS</span>
      </div>
      {{if .Servers}}
        {{range .Servers}}
        <div class="nsm-server-row"
             data-ep="{{.EndPoint}}"
             data-join-code="{{.JoinCode}}"
             data-name="{{.CleanName}}"
             data-raw-name="{{.Hostname}}"
             data-desc="{{.Desc}}"
             data-gametype="{{.GameType}}"
             data-mapname="{{.MapName}}"
             data-clients="{{.Clients}}"
             data-maxclients="{{.MaxClients}}"
             data-upvotes="{{.Upvotes}}"
             data-burst="{{.BurstPower}}"
             data-featured="{{if .Featured}}1{{else}}0{{end}}"
             data-locale="{{.Locale}}"
             data-country="{{.Country}}"
             data-onesync="{{.OneSync}}"
             data-gamebuild="{{.GameBuild}}"
             data-purelevel="{{.PureLevel}}"
             data-resources="{{.Resources}}"
             data-serverversion="{{.ServerVersion}}"
             data-tags="{{range $i, $t := .Tags}}{{if $i}},{{end}}{{$t}}{{end}}">
          <!-- ServerIcon (40x40 rounded square) -->
          <div class="nsm-srv-icon">
            <img src="/api/servers/icon/{{.EndPoint}}/{{.IconVersion}}.png" alt="" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
            <span class="nsm-srv-icon-fallback" style="display:none">{{.Initial}}</span>
          </div>

          <!-- Title + Description Loaf -->
          <div class="nsm-srv-title-col">
            <div style="display:flex;align-items:center;gap:6px;min-width:0">
              <span class="nsm-loaf" data-featured-badge="{{.EndPoint}}" style="{{if not .Featured}}display:none;{{end}}background:rgba(245,158,11,0.18);border:1px solid rgba(245,158,11,0.55);color:#fbbf24;font-weight:700;font-size:0.68rem;padding:1px 6px;flex-shrink:0">&#9733; FEATURED</span>
              <span class="nsm-srv-hostname" data-colorize="{{.Hostname}}">{{.CleanName}}</span>
            </div>
            {{if .Desc}}
            <span class="nsm-srv-desc-loaf">{{.Desc}}</span>
            {{else if .GameType}}
            <span class="nsm-srv-desc-loaf">{{.GameType}}{{if .MapName}} &bull; {{.MapName}}{{end}}</span>
            {{end}}
          </div>

          <!-- Tags (hide-on-hover) -->
          <div class="nsm-srv-tags hide-on-hover">
            {{if .GameType}}<span class="nsm-loaf">{{.GameType}}</span>{{end}}
            {{range .Tags}}
            <span class="nsm-loaf" data-tag-click="{{.}}">{{.}}</span>
            {{end}}
          </div>

          <!-- Actions (show-on-hover): Connect + Owner Feature -->
          <div class="nsm-srv-actions show-on-hover" onclick="event.stopPropagation()">
            <button type="button" class="nsm-connect-btn" data-connect-ep="{{.EndPoint}}">
              <svg viewBox="0 0 24 24" fill="currentColor" style="width:12px;height:12px"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Connect
            </button>
            {{if and $.User $.User.IsFounderAccount}}
            <button type="button" class="nsm-details-btn" data-feature-ep="{{.EndPoint}}" style="{{if .Featured}}background:rgba(245,158,11,0.24);border-color:#f59e0b;color:#fbbf24{{end}}" title="Owner (nta~): Toggle Featured Server">
              &#9733; {{if .Featured}}Featured{{else}}Feature{{end}}
            </button>
            {{end}}
          </div>

          <!-- Country Flag + Power (Upvote/Burst) -->
          <div class="nsm-srv-meta" onclick="event.stopPropagation()">
            <span class="nsm-country-pill" title="Locale: {{.Locale}}">{{.Country}}</span>
            <button type="button" class="nsm-power-pill" data-upvote-ep="{{.EndPoint}}" title="Server Boost / Upvote Power (Click to Boost)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              <span data-upvote-count="{{.EndPoint}}">{{.Upvotes}}</span>
            </button>
          </div>

          <!-- Favorite Star -->
          <div class="nsm-srv-fav show-on-hover" onclick="event.stopPropagation()">
            <button type="button" class="nsm-fav-btn" data-fav-ep="{{.EndPoint}}" title="Toggle Favorite">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </button>
          </div>

          <!-- Players Count -->
          <div class="nsm-srv-players">
            <span class="cur">{{.Clients}}</span><span class="sep">/</span><span class="max">{{.MaxClients}}</span>
          </div>
        </div>
        {{end}}
      {{else}}
        <div class="nsm-empty-list" id="nsm-empty-initial">
          <div class="nsm-empty-icon">
            <img src="/img/nsm-icon.png" alt="NSM" style="width:36px;height:36px">
          </div>
          <h3>No Live Servers Reporting Right Now</h3>
          <p>Start <code>nsm-server.exe +exec server-local.cfg</code> or issue a server key in <a href="/keymaster" style="color:#00f8b9">AFX Portal</a> — live servers appear here automatically in real time.</p>
        </div>
      {{end}}
    </div>

    <!-- Right: .pinned (NSM.exe PinnedServers + Live Selected Server Inspector Panel) -->
    <aside class="mp-pinned-pane" id="nsm-pinned-pane">
      <!-- Featured Servers Box (PinnedServers in NSM.exe & Web) -->
      <div class="mp-pinned-box" id="nsm-featured-servers-box" style="margin-bottom:14px;border-color:rgba(245,158,11,0.35);background:linear-gradient(180deg,rgba(245,158,11,0.08),rgba(15,23,42,0.75))">
        <div class="mp-pinned-hdr">
          <span style="color:#fbbf24;font-weight:700">
            <svg viewBox="0 0 24 24" fill="currentColor" style="width:14px;height:14px;color:#fbbf24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            FEATURED SERVERS
          </span>
          {{if and .User .User.IsFounderAccount}}
          <span style="font-size:0.7rem;color:#fbbf24;opacity:0.9">Owner Controls Active (nta~)</span>
          {{end}}
        </div>
        <div id="nsm-featured-servers-list" style="display:flex;flex-direction:column;gap:8px;margin-top:8px">
          {{if .FeaturedServers}}
            {{range .FeaturedServers}}
            <div class="nsm-featured-card" data-featured-card="{{.EndPoint}}" style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 10px;border-radius:8px;background:rgba(15,23,42,0.75);border:1px solid rgba(245,158,11,0.35);cursor:pointer">
              <div style="min-width:0;flex:1">
                <span style="color:#fff;font-weight:700;font-size:0.86rem;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" data-colorize="{{.Hostname}}">{{.CleanName}}</span>
                <div style="font-size:0.73rem;color:rgba(240,244,248,0.65);display:flex;gap:10px;margin-top:2px">
                  <span>{{.Clients}}/{{.MaxClients}} players</span>
                  <span style="color:#00f8b9">&#9889; <span data-upvote-count="{{.EndPoint}}">{{.Upvotes}}</span></span>
                </div>
              </div>
              <button type="button" class="nsm-connect-btn" data-connect-ep="{{.EndPoint}}" style="padding:5px 10px;font-size:0.75rem">Connect</button>
            </div>
            {{end}}
          {{else}}
            <p id="nsm-featured-empty" style="font-size:0.78rem;color:rgba(240,244,248,0.55);margin:2px 0">
              {{if and .User .User.IsFounderAccount}}Click <strong>&#9733; Feature</strong> on any server row or inspector below to pin it to Featured Servers on both nsmultiplayer.com and NSM.exe.{{else}}Official featured NSM servers pinned by nta~ appear here.{{end}}
            </p>
          {{end}}
        </div>
      </div>

      <div class="mp-inspector-card" id="nsm-inspector-card">
        <div class="mp-inspector-banner" id="nsm-insp-banner">
          <div class="mp-inspector-banner-overlay">
            <div class="nsm-srv-icon nsm-srv-icon-lg">
              <span class="nsm-srv-icon-fallback" id="nsm-insp-initial">N</span>
            </div>
            <div style="min-width:0;flex:1">
              <div class="mp-insp-badge">SELECTED SERVER</div>
              <h3 id="nsm-insp-title">Select a Server</h3>
              <p id="nsm-insp-desc">Click any server row on the left to inspect its live players, resources, tags, and connect in NSM.exe.</p>
            </div>
          </div>
        </div>

        <div class="mp-inspector-body">
          <div class="mp-insp-actions">
            <button type="button" class="nsm-btn nsm-btn-primary" id="nsm-insp-connect" style="flex:1;justify-content:center">
              <svg viewBox="0 0 24 24" fill="currentColor" style="width:14px;height:14px"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Connect in NSM.exe
            </button>
            <button type="button" class="nsm-ctrl-btn" id="nsm-insp-boost" title="Upvote / Boost Server">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="color:#00f8b9"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              <span id="nsm-insp-upvotes">0</span>
            </button>
            {{if and .User .User.IsFounderAccount}}
            <button type="button" class="nsm-ctrl-btn" id="nsm-insp-feature" title="Owner (nta~): Toggle Featured Server" style="color:#fbbf24;border-color:rgba(245,158,11,0.45)">
              <span id="nsm-insp-feature-label">&#9733; Feature</span>
            </button>
            {{end}}
          </div>

          <div class="mp-insp-stats-grid">
            <div class="mp-insp-stat">
              <span class="lbl">Players</span>
              <strong id="nsm-insp-players">0 / 48</strong>
            </div>
            <div class="mp-insp-stat">
              <span class="lbl">Join Code</span>
              <code id="nsm-insp-ep">&mdash;</code>
            </div>
            <div class="mp-insp-stat">
              <span class="lbl">Resources</span>
              <strong id="nsm-insp-res">0 loaded</strong>
            </div>
            <div class="mp-insp-stat">
              <span class="lbl">Locale / Sync</span>
              <strong id="nsm-insp-locale">en-US &bull; OneSync</strong>
            </div>
          </div>

          <div class="mp-insp-section">
            <div class="mp-insp-sec-title">AFX Share / Join URL</div>
            <div class="nsm-f8-box">
              <code id="nsm-insp-join">https://nsmultiplayer.com/join/&lt;code&gt;</code>
              <button type="button" class="nsm-copy-mini" id="nsm-insp-copy-join">Copy</button>
            </div>
          </div>

          <div class="mp-insp-section">
            <div class="mp-insp-sec-title">Quick Console Connect</div>
            <div class="nsm-f8-box">
              <code id="nsm-insp-f8">connect &lt;code&gt;</code>
              <button type="button" class="nsm-copy-mini" id="nsm-insp-copy">Copy</button>
            </div>
          </div>

          <div class="mp-insp-section">
            <div class="mp-insp-sec-title">Server Tags</div>
            <div class="nsm-tag-cloud" id="nsm-insp-tags">
              <span class="nsm-loaf">nsm</span>
              <span class="nsm-loaf">afx</span>
              <span class="nsm-loaf">roleplay</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Pinned / Regional Top Servers Box -->
      <div class="mp-pinned-box">
        <div class="mp-pinned-hdr">
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;color:#00f8b9"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            HOST YOUR OWN NSM SERVER
          </span>
          <a href="/keymaster">AFX Portal &rarr;</a>
        </div>
        <p style="font-size:0.8rem;color:rgba(240,244,248,0.65);margin:6px 0 10px;line-height:1.45">
          Generate a free <code>nsm_srv_...</code> license key in AFX Portal and launch <code>nsm-server.exe</code> to list your server here in real time.
        </p>
      </div>
    </aside>
  </div>

  <!-- NSM.exe Settings Modal -->
  <div class="mp-modal-backdrop" id="nsm-settings-modal" style="display:none">
    <div class="mp-modal-card">
      <div class="mp-modal-hdr">
        <div style="display:flex;align-items:center;gap:10px">
          <img src="/img/nsm-icon.png" alt="NSM" style="width:24px;height:24px">
          <h3>NSM Client &amp; Browser Settings</h3>
        </div>
        <button type="button" class="mp-modal-close" id="nsm-settings-close">&times;</button>
      </div>
      <div class="mp-modal-body">
        <div class="mp-setting-row">
          <div>
            <strong>Player Nickname</strong>
            <p>Your in-game display name when joining NSM servers</p>
          </div>
          <input type="text" id="nsm-setting-nick" placeholder="{{if .User}}{{.User.Username}}{{else}}NSMPlayer{{end}}" class="mp-setting-input">
        </div>
        <div class="mp-setting-row">
          <div>
            <strong>Interface Theme</strong>
            <p>Switch between NSM Dark Navy Glass and Light mode</p>
          </div>
          <select id="nsm-setting-theme" class="mp-setting-input">
            <option value="dark">NSM Dark Glass (Default)</option>
            <option value="light">NSM Light Mode</option>
          </select>
        </div>
        <div class="mp-setting-row">
          <div>
            <strong>Default Localhost Server Port</strong>
            <p>Used for 1-click Localhost connection</p>
          </div>
          <input type="text" id="nsm-setting-port" value="30120" class="mp-setting-input" style="width:110px">
        </div>
        <div class="mp-setting-row">
          <div>
            <strong>AFX Account Status</strong>
            <p>Linked to NSM Masterlist &amp; In-Game Profile</p>
          </div>
          {{if .User}}
          <a href="/account" class="nsm-btn nsm-btn-primary nsm-btn-sm">@{{.User.Username}} ({{.User.Role}})</a>
          {{else}}
          <a href="/login" class="nsm-btn nsm-btn-primary nsm-btn-sm">Sign In via AFX Portal</a>
          {{end}}
        </div>
      </div>
    </div>
  </div>
</div>
{{end}}

