{{template "head" .}}
<style>
  /* ===== NSM Server List — modern UI (scoped to this page) ===== */
  #nsm-mp-app {
    --sl-bg: #0a1020;
    --sl-card: rgba(19, 28, 48, 0.92);
    --sl-card2: rgba(13, 21, 38, 0.96);
    --sl-line: rgba(255, 255, 255, 0.08);
    --sl-line-hi: rgba(0, 248, 185, 0.35);
    --sl-text: #f0f4f8;
    --sl-mut: rgba(240, 244, 248, 0.58);
    --sl-mint: #00f8b9;
    --sl-blue: #2f7bff;
    --sl-gold: #fbbf24;
    padding: 26px 0 60px;
    background:
      radial-gradient(900px 320px at 12% -40px, rgba(47, 123, 255, 0.16), transparent 70%),
      radial-gradient(760px 300px at 88% -60px, rgba(0, 248, 185, 0.12), transparent 70%);
    min-height: calc(100vh - 220px);
  }
  #nsm-mp-app .sl-wrap { max-width: 1120px; margin: 0 auto; padding: 0 22px; }

  /* Hero */
  #nsm-mp-app .sl-hero { margin: 6px 0 22px; }
  #nsm-mp-app .sl-hero h1 {
    margin: 0 0 6px; font-size: 2.35rem; font-weight: 800; letter-spacing: -0.02em; color: var(--sl-text);
  }
  #nsm-mp-app .sl-hero h1 .sl-grad {
    background: linear-gradient(92deg, #2f7bff 0%, #00f8b9 55%, #7de0ff 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  #nsm-mp-app .sl-sub { margin: 0 0 16px; color: var(--sl-mut); font-size: 1.02rem; }
  #nsm-mp-app .sl-stat-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  #nsm-mp-app .sl-pill {
    display: inline-flex; align-items: center; gap: 8px; padding: 7px 13px; border-radius: 999px;
    background: rgba(19, 28, 48, 0.85); border: 1px solid var(--sl-line); color: var(--sl-text);
    font-size: 0.83rem; font-weight: 600;
  }
  #nsm-mp-app .sl-pill .sl-num { font-size: 0.98rem; font-weight: 800; color: var(--sl-mint); }
  #nsm-mp-app .sl-live-dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--sl-mint);
    box-shadow: 0 0 0 0 rgba(0, 248, 185, 0.55); animation: slPulse 2s infinite;
  }
  @keyframes slPulse {
    0% { box-shadow: 0 0 0 0 rgba(0, 248, 185, 0.5); }
    70% { box-shadow: 0 0 0 7px rgba(0, 248, 185, 0); }
    100% { box-shadow: 0 0 0 0 rgba(0, 248, 185, 0); }
  }
  #nsm-mp-app .sl-pill.sl-locked { color: var(--sl-mut); font-weight: 500; }

  /* Search + sort */
  #nsm-mp-app .sl-controls {
    display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 18px 0 26px;
  }
  #nsm-mp-app .sl-search {
    flex: 1 1 300px; position: relative; max-width: 460px;
  }
  #nsm-mp-app .sl-search input {
    width: 100%; box-sizing: border-box; padding: 11px 14px 11px 40px; border-radius: 12px;
    background: rgba(19, 28, 48, 0.85); border: 1px solid var(--sl-line); color: var(--sl-text);
    font-size: 0.95rem; outline: none; transition: border-color .15s, box-shadow .15s;
  }
  #nsm-mp-app .sl-search input:focus { border-color: var(--sl-line-hi); box-shadow: 0 0 0 3px rgba(0, 248, 185, 0.12); }
  #nsm-mp-app .sl-search svg { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; color: var(--sl-mut); }
  #nsm-mp-app .sl-sort { display: flex; gap: 6px; background: rgba(19, 28, 48, 0.7); border: 1px solid var(--sl-line); border-radius: 12px; padding: 4px; }
  #nsm-mp-app .sl-sort button {
    border: 0; background: transparent; color: var(--sl-mut); font-weight: 600; font-size: 0.82rem;
    padding: 7px 13px; border-radius: 9px; cursor: pointer; transition: all .15s;
  }
  #nsm-mp-app .sl-sort button:hover { color: var(--sl-text); }
  #nsm-mp-app .sl-sort button.sl-active { background: linear-gradient(135deg, rgba(47, 123, 255, 0.35), rgba(0, 248, 185, 0.25)); color: #fff; }

  /* Section headers */
  #nsm-mp-app .sl-sec { margin: 0 0 34px; }
  #nsm-mp-app .sl-sec-head { display: flex; align-items: baseline; gap: 12px; margin: 0 0 14px; }
  #nsm-mp-app .sl-sec-head h2 { margin: 0; font-size: 1.28rem; font-weight: 800; color: var(--sl-text); letter-spacing: -0.01em; }
  #nsm-mp-app .sl-sec-head .sl-count { color: var(--sl-mut); font-size: 0.86rem; font-weight: 600; }
  #nsm-mp-app .sl-hint { color: var(--sl-mut); font-size: 0.8rem; margin-left: auto; }
  #nsm-mp-app .sl-hint.sl-gold { color: rgba(251, 191, 36, 0.85); }

  /* Grid + cards */
  #nsm-mp-app .sl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 14px; }
  #nsm-mp-app .sl-card {
    position: relative; display: flex; flex-direction: column; gap: 12px; padding: 16px;
    background: linear-gradient(180deg, var(--sl-card), var(--sl-card2));
    border: 1px solid var(--sl-line); border-radius: 16px;
    transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease;
  }
  #nsm-mp-app .sl-card:hover {
    transform: translateY(-3px); border-color: var(--sl-line-hi);
    box-shadow: 0 14px 34px rgba(2, 8, 23, 0.55), 0 0 0 1px rgba(0, 248, 185, 0.12);
  }
  #nsm-mp-app .sl-card.sl-featured {
    border-color: rgba(251, 191, 36, 0.4);
    background: linear-gradient(180deg, rgba(38, 32, 18, 0.55), var(--sl-card2));
  }
  #nsm-mp-app .sl-card.sl-featured:hover { border-color: rgba(251, 191, 36, 0.7); box-shadow: 0 14px 34px rgba(2, 8, 23, 0.55), 0 0 0 1px rgba(251, 191, 36, 0.2); }
  #nsm-mp-app .sl-card-top { display: flex; gap: 12px; align-items: center; min-width: 0; }
  #nsm-mp-app .sl-icon {
    width: 52px; height: 52px; border-radius: 13px; overflow: hidden; flex-shrink: 0;
    background: linear-gradient(135deg, rgba(47, 123, 255, 0.4), rgba(0, 248, 185, 0.28));
    display: flex; align-items: center; justify-content: center;
  }
  #nsm-mp-app .sl-icon img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #nsm-mp-app .sl-icon span { font-size: 1.35rem; font-weight: 800; color: #fff; }
  #nsm-mp-app .sl-name-col { min-width: 0; flex: 1; }
  #nsm-mp-app .sl-name {
    display: flex; align-items: center; gap: 7px; min-width: 0;
    font-size: 1.02rem; font-weight: 700; color: var(--sl-text); text-decoration: none;
  }
  #nsm-mp-app .sl-name .sl-name-txt { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #nsm-mp-app .sl-name:hover .sl-name-txt { color: var(--sl-mint); }
  #nsm-mp-app .sl-star-badge {
    flex-shrink: 0; display: inline-flex; align-items: center; gap: 4px;
    background: rgba(251, 191, 36, 0.16); border: 1px solid rgba(251, 191, 36, 0.5); color: var(--sl-gold);
    font-size: 0.64rem; font-weight: 800; letter-spacing: 0.04em; padding: 2px 7px; border-radius: 999px;
  }
  #nsm-mp-app .sl-desc {
    color: var(--sl-mut); font-size: 0.82rem; margin-top: 3px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  #nsm-mp-app .sl-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  #nsm-mp-app .sl-tag {
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.02em; color: rgba(240, 244, 248, 0.72);
    background: rgba(255, 255, 255, 0.06); border: 1px solid var(--sl-line); padding: 2px 8px; border-radius: 999px;
    max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  /* Big stats */
  #nsm-mp-app .sl-stats { display: flex; gap: 10px; }
  #nsm-mp-app .sl-stat {
    flex: 1; display: flex; flex-direction: column; gap: 2px; padding: 10px 12px;
    background: rgba(255, 255, 255, 0.035); border: 1px solid var(--sl-line); border-radius: 12px;
  }
  #nsm-mp-app .sl-stat .sl-stat-lbl { font-size: 0.64rem; font-weight: 800; letter-spacing: 0.09em; color: var(--sl-mut); }
  #nsm-mp-app .sl-stat .sl-stat-val { font-size: 1.28rem; font-weight: 800; color: var(--sl-text); line-height: 1.15; }
  #nsm-mp-app .sl-stat .sl-stat-val small { font-size: 0.82rem; font-weight: 700; color: var(--sl-mut); }
  #nsm-mp-app .sl-stat.sl-click { cursor: pointer; transition: border-color .15s, background .15s; }
  #nsm-mp-app .sl-stat.sl-click:hover { border-color: rgba(0, 248, 185, 0.4); background: rgba(0, 248, 185, 0.07); }
  #nsm-mp-app .sl-stat.sl-click .sl-stat-val { color: var(--sl-mint); }
  #nsm-mp-app .sl-stat.sl-click.sl-bumped { animation: slPop .35s ease; }
  @keyframes slPop { 40% { transform: scale(1.04); } }

  /* Actions */
  #nsm-mp-app .sl-actions { display: flex; gap: 8px; margin-top: auto; }
  #nsm-mp-app .sl-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 7px;
    border-radius: 11px; font-weight: 700; font-size: 0.86rem; cursor: pointer;
    padding: 9px 12px; border: 1px solid var(--sl-line); background: rgba(255, 255, 255, 0.05); color: var(--sl-text);
    transition: all .15s; text-decoration: none;
  }
  #nsm-mp-app .sl-btn:hover { border-color: rgba(255, 255, 255, 0.22); background: rgba(255, 255, 255, 0.1); }
  #nsm-mp-app .sl-btn svg { width: 13px; height: 13px; }
  #nsm-mp-app .sl-btn.sl-primary {
    flex: 1; border: 0; color: #04121c;
    background: linear-gradient(135deg, #2f7bff, #00f8b9);
  }
  #nsm-mp-app .sl-btn.sl-primary:hover { filter: brightness(1.08); }
  #nsm-mp-app .sl-btn.sl-icon-btn { padding: 9px 11px; }
  #nsm-mp-app .sl-btn.sl-gold { color: var(--sl-gold); border-color: rgba(251, 191, 36, 0.4); background: rgba(251, 191, 36, 0.1); }
  #nsm-mp-app .sl-btn.sl-gold:hover { background: rgba(251, 191, 36, 0.2); border-color: rgba(251, 191, 36, 0.65); }

  /* Empty states + toast */
  #nsm-mp-app .sl-empty {
    padding: 26px 18px; text-align: center; color: var(--sl-mut); font-size: 0.92rem;
    border: 1px dashed var(--sl-line); border-radius: 14px;
  }
  #nsm-mp-app .sl-empty strong { color: var(--sl-text); }
  #sl-toast {
    position: fixed; left: 50%; bottom: 26px; transform: translateX(-50%) translateY(12px);
    background: rgba(15, 23, 42, 0.97); border: 1px solid rgba(0, 248, 185, 0.45); color: var(--sl-text);
    padding: 11px 18px; border-radius: 12px; font-size: 0.9rem; font-weight: 600;
    opacity: 0; pointer-events: none; transition: all .22s ease; z-index: 9999;
    box-shadow: 0 12px 34px rgba(2, 8, 23, 0.6);
  }
  #sl-toast.sl-show { opacity: 1; transform: translateX(-50%) translateY(0); }

  @media (max-width: 560px) {
    #nsm-mp-app .sl-hero h1 { font-size: 1.8rem; }
    #nsm-mp-app .sl-grid { grid-template-columns: 1fr; }
  }
</style>

<div id="nsm-mp-app">
  <div class="sl-wrap">

    <!-- ===================== HERO ===================== -->
    <header class="sl-hero">
      <h1><span class="sl-grad">Server List</span></h1>
      <p class="sl-sub">Live NSM &amp; AFX servers — pick one and jump in.</p>
      <div class="sl-stat-row">
        <span class="sl-pill"><span class="sl-live-dot"></span><span class="sl-num">{{.Stats.Servers}}</span> servers online</span>
        <span class="sl-pill"><span class="sl-num">{{.Stats.Players}}</span> players online</span>
        <span class="sl-pill sl-locked">&#128274; Join codes keep every server IP private</span>
        {{if and .User .User.IsFounderAccount}}
        <span class="sl-pill" style="border-color:rgba(251,191,36,0.5);color:#fbbf24">&#9733; Founder mode — Feature buttons enabled</span>
        {{end}}
      </div>
    </header>

    <!-- ===================== SEARCH + SORT ===================== -->
    <div class="sl-controls">
      <div class="sl-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
        <input id="sl-search" type="text" placeholder="Search servers, tags, gamemodes…" autocomplete="off">
      </div>
      <div class="sl-sort" id="sl-sort">
        <button type="button" class="sl-active" data-sort="players">Players</button>
        <button type="button" data-sort="upvotes">Upvotes</button>
        <button type="button" data-sort="name">Name</button>
      </div>
    </div>

    <!-- ===================== FEATURED ===================== -->
    <section class="sl-sec" id="sl-featured-sec">
      <div class="sl-sec-head">
        <h2>&#9733; Featured Servers</h2>
        {{if and .User .User.IsFounderAccount}}
        <span class="sl-hint sl-gold">Click ★ Feature on any card to pin or unpin it here and in NSM.exe.</span>
        {{else}}
        <span class="sl-hint">Official servers pinned by nta~</span>
        {{end}}
      </div>
      <div class="sl-grid" id="sl-featured-grid">
        {{range .FeaturedServers}}
        <article class="sl-card sl-featured"
                 data-ep="{{.EndPoint}}"
                 data-join-code="{{.JoinCode}}"
                 data-name="{{.CleanName}}"
                 data-clients="{{.Clients}}"
                 data-upvotes="{{.Upvotes}}"
                 data-search="{{.CleanName}} {{.Desc}} {{.GameType}} {{range .Tags}}{{.}} {{end}}">
          <div class="sl-card-top">
            <div class="sl-icon">
              <img src="/api/servers/icon/{{.EndPoint}}/{{.IconVersion}}.png" alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
              <span style="display:none">{{.Initial}}</span>
            </div>
            <div class="sl-name-col">
              <a class="sl-name" href="/join/{{if .JoinCode}}{{.JoinCode}}{{else}}{{.EndPoint}}{{end}}">
                <span class="sl-name-txt">{{.CleanName}}</span>
                <span class="sl-star-badge">&#9733; FEATURED</span>
              </a>
              <div class="sl-desc">{{if .Desc}}{{.Desc}}{{else}}{{.GameType}}{{if .MapName}} &bull; {{.MapName}}{{end}}{{end}}</div>
            </div>
          </div>
          <div class="sl-stats">
            <div class="sl-stat">
              <span class="sl-stat-lbl">PLAYERS</span>
              <span class="sl-stat-val">{{.Clients}} <small>/ {{.MaxClients}}</small></span>
            </div>
            <div class="sl-stat sl-click" data-sl-upvote="{{.EndPoint}}" title="Click to boost this server">
              <span class="sl-stat-lbl">UPVOTES</span>
              <span class="sl-stat-val"><span data-upvote-count="{{.EndPoint}}">{{.Upvotes}}</span></span>
            </div>
          </div>
          <div class="sl-actions">
            <button type="button" class="sl-btn sl-primary" data-sl-connect="{{.EndPoint}}">
              <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Connect
            </button>
            <button type="button" class="sl-btn sl-icon-btn" data-sl-share="{{if .JoinCode}}{{.JoinCode}}{{else}}{{.EndPoint}}{{end}}" title="Copy join link (hides IP)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
            </button>
            {{if and $.User $.User.IsFounderAccount}}
            <button type="button" class="sl-btn sl-icon-btn sl-gold" data-sl-feature="{{.EndPoint}}" data-sl-featured="1" title="Owner (nta~): toggle Featured">
              <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </button>
            {{end}}
          </div>
        </article>
        {{else}}
        <div class="sl-empty" id="sl-featured-empty" style="grid-column:1/-1">
          Official featured NSM servers pinned by <strong>nta~</strong> appear here.
        </div>
        {{end}}
      </div>
    </section>

    <!-- ===================== ALL SERVERS ===================== -->
    <section class="sl-sec">
      <div class="sl-sec-head">
        <h2>All Servers</h2>
        <span class="sl-count">{{len .Servers}} listed</span>
      </div>
      <div class="sl-grid" id="sl-all-grid">
        {{range .Servers}}
        {{if not .Featured}}
        <article class="sl-card"
                 data-ep="{{.EndPoint}}"
                 data-join-code="{{.JoinCode}}"
                 data-name="{{.CleanName}}"
                 data-clients="{{.Clients}}"
                 data-upvotes="{{.Upvotes}}"
                 data-search="{{.CleanName}} {{.Desc}} {{.GameType}} {{range .Tags}}{{.}} {{end}}">
          <div class="sl-card-top">
            <div class="sl-icon">
              <img src="/api/servers/icon/{{.EndPoint}}/{{.IconVersion}}.png" alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
              <span style="display:none">{{.Initial}}</span>
            </div>
            <div class="sl-name-col">
              <a class="sl-name" href="/join/{{if .JoinCode}}{{.JoinCode}}{{else}}{{.EndPoint}}{{end}}">
                <span class="sl-name-txt">{{.CleanName}}</span>
              </a>
              <div class="sl-desc">{{if .Desc}}{{.Desc}}{{else}}{{.GameType}}{{if .MapName}} &bull; {{.MapName}}{{end}}{{end}}</div>
            </div>
          </div>
          {{if .Tags}}
          <div class="sl-tags">
            {{range $i, $t := .Tags}}{{if lt $i 4}}<span class="sl-tag">{{$t}}</span>{{end}}{{end}}
          </div>
          {{end}}
          <div class="sl-stats">
            <div class="sl-stat">
              <span class="sl-stat-lbl">PLAYERS</span>
              <span class="sl-stat-val">{{.Clients}} <small>/ {{.MaxClients}}</small></span>
            </div>
            <div class="sl-stat sl-click" data-sl-upvote="{{.EndPoint}}" title="Click to boost this server">
              <span class="sl-stat-lbl">UPVOTES</span>
              <span class="sl-stat-val"><span data-upvote-count="{{.EndPoint}}">{{.Upvotes}}</span></span>
            </div>
          </div>
          <div class="sl-actions">
            <button type="button" class="sl-btn sl-primary" data-sl-connect="{{.EndPoint}}">
              <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Connect
            </button>
            <button type="button" class="sl-btn sl-icon-btn" data-sl-share="{{if .JoinCode}}{{.JoinCode}}{{else}}{{.EndPoint}}{{end}}" title="Copy join link (hides IP)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
            </button>
            {{if and $.User $.User.IsFounderAccount}}
            <button type="button" class="sl-btn sl-icon-btn" data-sl-feature="{{.EndPoint}}" data-sl-featured="0" title="Owner (nta~): toggle Featured">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </button>
            {{end}}
          </div>
        </article>
        {{end}}
        {{else}}
        <div class="sl-empty" style="grid-column:1/-1">
          <strong>No servers online right now.</strong><br>
          Server owners: start your AFX server with a key — it appears here within one heartbeat.
        </div>
        {{end}}
      </div>
      <div class="sl-empty" id="sl-search-empty" style="display:none;margin-top:12px">
        No servers match your search.
      </div>
    </section>

  </div>
</div>
<div id="sl-toast"></div>

<script>
(function () {
  var toastEl = document.getElementById('sl-toast');
  var toastTimer = null;
  function toast(msg) {
    if (!toastEl) return;
    toastEl.textContent = msg;
    toastEl.classList.add('sl-show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { toastEl.classList.remove('sl-show'); }, 2200);
  }
  function allCards() {
    return Array.prototype.slice.call(document.querySelectorAll('#nsm-mp-app .sl-card'));
  }
  function gridFor(card) { return card.closest('#sl-featured-grid') ? 'featured' : 'all'; }

  /* ---- Connect (launches NSM.exe via the fivem:// deep link) ---- */
  document.addEventListener('click', function (e) {
    var b = e.target.closest('[data-sl-connect]');
    if (!b) return;
    var ep = b.getAttribute('data-sl-connect');
    if (!ep) return;
    try { if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText('connect ' + ep); } catch (err) {}
    window.location.href = 'fivem://connect/' + ep;
    toast('Launching NSM.exe…');
  });

  /* ---- Share (copy the IP-hiding join link) ---- */
  document.addEventListener('click', function (e) {
    var b = e.target.closest('[data-sl-share]');
    if (!b) return;
    var ref = b.getAttribute('data-sl-share');
    var url = 'https://nsmultiplayer.com/join/' + ref;
    function done() { toast('Join link copied — server IP stays hidden'); }
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(done, function () { window.prompt('Copy join link:', url); });
      } else {
        window.prompt('Copy join link:', url);
      }
    } catch (err) { window.prompt('Copy join link:', url); }
  });

  /* ---- Upvote / boost ---- */
  document.addEventListener('click', function (e) {
    var b = e.target.closest('[data-sl-upvote]');
    if (!b) return;
    var ep = b.getAttribute('data-sl-upvote');
    if (!ep) return;
    fetch('/api/servers/upvote', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
      body: JSON.stringify({ endpoint: ep })
    }).then(function (r) {
      if (r.status === 401) {
        window.location.href = '/login?next=' + encodeURIComponent(window.location.pathname);
        return null;
      }
      return r.json();
    }).then(function (data) {
      if (!data || typeof data.upvotes !== 'number') return;
      var nodes = document.querySelectorAll('[data-upvote-count="' + CSS.escape(ep) + '"]');
      for (var i = 0; i < nodes.length; i++) nodes[i].textContent = String(data.upvotes);
      var card = document.querySelector('#nsm-mp-app .sl-card[data-ep="' + CSS.escape(ep) + '"]');
      if (card) {
        card.setAttribute('data-upvotes', String(data.upvotes));
        var block = card.querySelector('.sl-stat.sl-click');
        if (block) { block.classList.remove('sl-bumped'); void block.offsetWidth; block.classList.add('sl-bumped'); }
      }
      toast('Boosted! Upvote power: ' + data.upvotes);
    }).catch(function () {});
  });

  /* ---- Founder: toggle Featured (relocates the card between sections) ---- */
  function setFeaturedUI(card, isFeat) {
    card.classList.toggle('sl-featured', isFeat);
    var name = card.querySelector('.sl-name');
    if (name) {
      var badge = name.querySelector('.sl-star-badge');
      if (isFeat && !badge) {
        badge = document.createElement('span');
        badge.className = 'sl-star-badge';
        badge.innerHTML = '&#9733; FEATURED';
        name.appendChild(badge);
      } else if (!isFeat && badge) {
        badge.remove();
      }
    }
    var btn = card.querySelector('[data-sl-feature]');
    if (btn) {
      btn.setAttribute('data-sl-featured', isFeat ? '1' : '0');
      btn.classList.toggle('sl-gold', isFeat);
      btn.querySelector('svg').setAttribute('fill', isFeat ? 'currentColor' : 'none');
    }
  }
  document.addEventListener('click', function (e) {
    var b = e.target.closest('[data-sl-feature]');
    if (!b) return;
    var ep = b.getAttribute('data-sl-feature');
    if (!ep) return;
    fetch('/api/servers/feature', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
      body: JSON.stringify({ endpoint: ep })
    }).then(function (r) { return r.json(); }).then(function (data) {
      if (!data || !data.ok) { toast('Only the founder (nta~) can feature servers'); return; }
      var isFeat = !!data.featured;
      var card = document.querySelector('#nsm-mp-app .sl-card[data-ep="' + CSS.escape(ep) + '"]');
      if (!card) return;
      setFeaturedUI(card, isFeat);
      var featGrid = document.getElementById('sl-featured-grid');
      var allGrid = document.getElementById('sl-all-grid');
      if (isFeat && featGrid) {
        var empty = document.getElementById('sl-featured-empty');
        if (empty) empty.remove();
        featGrid.insertBefore(card, featGrid.firstChild);
      } else if (!isFeat && allGrid) {
        allGrid.insertBefore(card, allGrid.firstChild);
      }
      toast(isFeat ? 'Server featured on NSM' : 'Server removed from Featured');
    }).catch(function () {});
  });

  /* ---- Search ---- */
  var searchInput = document.getElementById('sl-search');
  if (searchInput) {
    searchInput.addEventListener('input', function () {
      var q = this.value.trim().toLowerCase();
      var visible = 0;
      allCards().forEach(function (card) {
        var hay = (card.getAttribute('data-search') || card.getAttribute('data-name') || '').toLowerCase();
        var show = !q || hay.indexOf(q) !== -1;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      var se = document.getElementById('sl-search-empty');
      if (se) se.style.display = (q && visible === 0) ? '' : 'none';
    });
  }

  /* ---- Sort ---- */
  var sortBox = document.getElementById('sl-sort');
  if (sortBox) {
    sortBox.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-sort]');
      if (!btn) return;
      var buttons = sortBox.querySelectorAll('button');
      for (var i = 0; i < buttons.length; i++) buttons[i].classList.toggle('sl-active', buttons[i] === btn);
      var key = btn.getAttribute('data-sort');
      var dir = (key === 'name') ? 1 : -1;
      var grid = document.getElementById('sl-all-grid');
      if (!grid) return;
      var cards = Array.prototype.slice.call(grid.querySelectorAll('.sl-card'));
      cards.sort(function (a, b) {
        if (key === 'name') {
          return dir * (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
        }
        var av = parseInt(a.getAttribute('data-' + (key === 'upvotes' ? 'upvotes' : 'clients')), 10) || 0;
        var bv = parseInt(b.getAttribute('data-' + (key === 'upvotes' ? 'upvotes' : 'clients')), 10) || 0;
        return dir * (av - bv) || (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
      });
      cards.forEach(function (c) { grid.appendChild(c); });
    });
  }
})();
</script>
{{template "foot" .}}
