<!DOCTYPE html>
<html lang="en" class="discourse-dark-theme">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Users - AFX Forum</title>
  <link rel="icon" type="image/png" href="/img/nsm-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=085a">
</head>
<body class="dc-ember-body users-page">
  <header class="d-header">
    <div class="d-header-wrap">
      <div class="d-header-left">
        <button type="button" class="btn-sidebar-toggle" onclick="document.getElementById('d-sidebar').classList.toggle('collapsed')" title="Toggle sidebar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <a href="/forum" class="d-logo-link">
          <img src="/img/nsm-icon.png" alt="NSM" class="d-logo-mark">
          <span class="d-logo-text">AFX <strong>Forum</strong></span>
        </a>
        <nav class="d-top-links">
          <a href="/">nsmultiplayer.com</a>
          <a href="/servers">Server List</a>
          <a href="/keymaster">AFX Portal</a>
          <a href="/marketplace">Marketplace</a>
          <a href="/docs">Docs</a>
          <a href="/support">Support</a>
          {{if and .User .User.IsStaffOrHigher}}
          <a href="/admin/users" style="color:#6ea8ff !important;font-weight:700">Staff</a>
          {{end}}
        </nav>
      </div>

      <div class="d-header-icons">
        <form method="get" action="/u" class="d-header-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="search" name="q" value="{{.Query}}" placeholder="Filter by username, handle, GitHub...">
        </form>

        {{if .User}}
        {{if .User.IsStaffOrHigher}}
        <a href="/admin/users" class="d-btn d-btn-default">Staff</a>
        {{end}}
        <a href="/u/{{.User.Username}}" class="d-header-user" title="{{.User.EffectiveDisplayName}} (@{{.User.Username}})">
          <img src="{{.User.AvatarPath}}" alt="{{.User.Username}}" class="d-header-avatar">
          <span class="d-header-username">{{.User.EffectiveDisplayName}}</span>
        </a>
        {{else}}
        <a href="/register?next=/u" class="d-btn d-btn-primary">Sign Up</a>
        <a href="/login?next=/u" class="d-btn d-btn-default">Log In</a>
        {{end}}
      </div>
    </div>
  </header>

  <div id="main-outlet-wrapper" class="d-outlet-wrapper">
    <aside id="d-sidebar" class="sidebar-wrapper">
      <div class="sidebar-sections">
        <div class="sidebar-section">
          <ul class="sidebar-section-content">
            <li>
              <a href="/forum" class="sidebar-section-link">
                <span class="sidebar-section-link-prefix">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                </span>
                <span class="sidebar-section-link-content-text">Topics</span>
              </a>
            </li>
            <li>
              <a href="/forum?tab=categories" class="sidebar-section-link">
                <span class="sidebar-section-link-prefix">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                </span>
                <span class="sidebar-section-link-content-text">Categories</span>
              </a>
            </li>
            <li>
              <a href="/u" class="sidebar-section-link active">
                <span class="sidebar-section-link-prefix">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </span>
                <span class="sidebar-section-link-content-text">Users</span>
              </a>
            </li>
          </ul>
        </div>

        <div class="sidebar-section">
          <div class="sidebar-section-header">CATEGORIES</div>
          <ul class="sidebar-section-content">
            {{range .Categories}}
            <li>
              <a href="/forum/c/{{.Slug}}" class="sidebar-section-link">
                <span class="sidebar-section-link-prefix">
                  <span class="prefix-square" style="background:{{.Color}}"></span>
                </span>
                <span class="sidebar-section-link-content-text">{{.Name}}</span>
                <span class="sidebar-section-link-suffix">{{.TopicCount}}</span>
              </a>
            </li>
            {{end}}
          </ul>
        </div>
      </div>
    </aside>

    <main id="main-outlet" class="d-main-outlet">
      <div class="directory">
        <div class="list-controls">
          <div class="navigation-container">
            <ul class="nav-pills">
              <li><a href="/u?period=all" class="{{if eq .Period "all"}}active{{end}}">All Time</a></li>
              <li><a href="/u?period=yearly" class="{{if eq .Period "yearly"}}active{{end}}">Year</a></li>
              <li><a href="/u?period=quarterly" class="{{if eq .Period "quarterly"}}active{{end}}">Quarter</a></li>
              <li><a href="/u?period=monthly" class="{{if eq .Period "monthly"}}active{{end}}">Month</a></li>
              <li><a href="/u?period=weekly" class="{{if eq .Period "weekly"}}active{{end}}">Week</a></li>
              <li><a href="/u?period=daily" class="{{if eq .Period "daily"}}active{{end}}">Today</a></li>
            </ul>
            <div class="navigation-controls">
              <span class="d-muted">{{.TotalUsers}} users</span>
            </div>
          </div>
        </div>

        <table class="topic-list d-users-directory-table">
          <thead>
            <tr>
              <th>Username</th>
              <th class="num"><span class="d-icon-heart">&#10084;</span> Received</th>
              <th class="num"><span class="d-icon-heart">&#10084;</span> Given</th>
              <th class="num">Topics Created</th>
              <th class="num">Replies Posted</th>
              <th class="num">Topics Viewed</th>
              <th class="num">Posts Read</th>
              <th class="num">Days Visited</th>
            </tr>
          </thead>
          <tbody>
            {{range .Users}}
            <tr class="topic-list-item">
              <td class="topic-list-data">
                <div class="d-user-dir-cell">
                  <a href="/u/{{.User.Username}}">
                    <img src="{{.User.AvatarPath}}" alt="{{.User.Username}}" width="45" height="45" class="avatar" style="{{.User.AvatarRingStyleAttr}}">
                  </a>
                  <div class="d-user-dir-info">
                    <div class="d-user-dir-name">
                      <a href="/u/{{.User.Username}}"><strong>{{.User.EffectiveDisplayName}}</strong></a>
                      <span class="d-muted">@{{.User.Username}}</span>
                      {{if .User.IsFounderAccount}}
                      <span class="d-role-tag role-founder">&#9813; FOUNDER</span>
                      {{else}}
                      <span class="d-role-tag role-{{.User.Role}}">{{.User.Role}}</span>
                      {{end}}
                      {{if .User.HasPartnerBadge}}<span class="d-role-tag role-partner">&#8734; PARTNER</span>{{end}}
                      {{if .User.HasPulse}}<span class="d-role-tag role-pulse">&#9889; {{.User.EffectivePulseTier}}</span>{{end}}
                    </div>
                    <div class="d-user-dir-title">{{.User.EffectiveTitle}}</div>
                    <div class="d-user-dir-socials">
                      {{if .User.DiscordTag}}<span class="d-social-pill d-social-community">Handle: {{.User.DiscordTag}}</span>{{end}}
                      {{if .User.GitHub}}<a href="{{.User.GitHubURL}}" class="d-social-pill d-social-github" rel="noopener">github.com/{{.User.GitHubHandle}}</a>{{end}}
                      {{if .User.Steam}}<a href="{{.User.SteamURL}}" class="d-social-pill d-social-steam" rel="noopener">Steam: {{.User.Steam}}</a>{{end}}
                      {{if $.User}}<a href="/u/{{$.User.Username}}?tab=messages&amp;with={{.User.Username}}" class="d-social-pill" style="background:rgba(47,123,255,0.22)!important;border-color:rgba(47,123,255,0.5);color:#fff!important">&#9993; Message @{{.User.Username}}</a>{{end}}
                    </div>
                  </div>
                </div>
              </td>
              <td class="num topic-list-data"><strong>{{.LikesReceived}}</strong></td>
              <td class="num topic-list-data">{{.LikesGiven}}</td>
              <td class="num topic-list-data">{{.TopicsCreated}}</td>
              <td class="num topic-list-data">{{.RepliesPosted}}</td>
              <td class="num topic-list-data">{{.TopicsViewed}}</td>
              <td class="num topic-list-data">{{.PostsRead}}</td>
              <td class="num topic-list-data">{{.DaysVisited}}</td>
            </tr>
            {{end}}
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script src="/js/main.js?v=078m"></script>
</body>
</html>
