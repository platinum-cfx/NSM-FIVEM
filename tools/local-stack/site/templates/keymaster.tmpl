<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{if .Title}}{{.Title}}{{else}}AFX Portal — NSM Keymaster{{end}}</title>
  <link rel="icon" type="image/png" href="/img/afx-icon.png">
  <link rel="stylesheet" href="/css/style.css?v=078m">
</head>
<body class="afx-portal-body">
{{if .User}}
  <div class="afx-portal-shell">
    <!-- Left Sidebar (1:1 Portal Sidebar) -->
    <aside class="afx-portal-sidebar">
      <a href="/" class="afx-portal-brand" style="padding:18px 20px;border-bottom:1px solid rgba(255,255,255,0.08)">
        <img src="/img/afx-icon.png" alt="AFX" style="width:30px;height:30px;border-radius:7px">
        <span>AFX <strong>Portal</strong></span>
      </a>

      <nav class="afx-portal-nav">
        <div class="afx-portal-nav-group">PORTAL</div>
        <a href="/keymaster" class="afx-portal-nav-item active">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="7" rx="1.5"/><rect x="2" y="14" width="20" height="7" rx="1.5"/></svg>
          <span>Servers (Keymaster)</span>
        </a>
        <a href="/marketplace" class="afx-portal-nav-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
          <span>Granted Assets</span>
        </a>
        <a href="/account" class="afx-portal-nav-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span>Personal &amp; Profile</span>
        </a>
        <a href="/user-api-key/new" class="afx-portal-nav-item">
          <img src="/img/nsm-icon.png" alt="NSM" style="width:16px;height:16px">
          <span>Link NSM.exe App</span>
        </a>

        <div class="afx-portal-nav-group" style="margin-top:18px">AFX &amp; NSM SUITE</div>
        <a href="/servers" class="afx-portal-nav-item">
          <span>Server List - NSM &nearr;</span>
        </a>
        <a href="/forum" class="afx-portal-nav-item">
          <span>AFX Forum &nearr;</span>
        </a>
        <a href="/marketplace" class="afx-portal-nav-item">
          <span>AFX Marketplace &nearr;</span>
        </a>
        <a href="/docs" class="afx-portal-nav-item">
          <span>NSM Documentation &nearr;</span>
        </a>
        <a href="/support" class="afx-portal-nav-item">
          <span>AFX Support &nearr;</span>
        </a>
      </nav>

      <div class="afx-portal-sidebar-foot">
        <a href="/account" class="afx-portal-user-box">
          <img src="{{.User.AvatarPath}}" alt="{{.User.Username}}">
          <div style="min-width:0;flex:1">
            <strong>{{.User.EffectiveDisplayName}}</strong>
            <span>@{{.User.Username}} &bull; {{.User.Role}}</span>
          </div>
        </a>
      </div>
    </aside>

    <!-- Main Workspace -->
    <div class="afx-portal-content">
      <header class="afx-portal-header" style="background:linear-gradient(120deg,rgba(47,123,255,0.16),rgba(0,248,185,0.10) 55%,rgba(15,23,42,0));border-bottom:1px solid rgba(255,255,255,0.09)">
        <div>
          <span style="font-size:0.76rem;text-transform:uppercase;letter-spacing:0.08em;color:#00f8b9;font-weight:700">AFX PORTAL &bull; SERVER MANAGEMENT</span>
          <h1 style="margin:2px 0 0;font-size:1.55rem;color:#fff;letter-spacing:-0.01em">Server Registration Keys (Keymaster)</h1>
          <p class="muted" style="margin:4px 0 0;font-size:0.84rem">Issue keys, boost your listing with upvotes, and run up to <strong style="color:#00f8b9">2048 player slots</strong> — free, no paid key required.</p>
        </div>
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <a href="/download-server" data-no-spa="1" class="btn btn-primary btn-sm">Download NSM-Server.zip</a>
          <a href="/servers" class="nsm-ctrl-btn">View Live Server List &nearr;</a>
          <a href="/logout" class="nsm-ctrl-btn">Sign Out</a>
        </div>
      </header>

      <div class="afx-portal-inner">
        {{if .Error}}<div class="alert alert-err" style="margin-bottom:18px">{{.Error}}</div>{{end}}
        {{if .Msg}}<div class="alert alert-ok" style="margin-bottom:18px">{{.Msg}}</div>{{end}}

        {{if .NewKey}}
        <div class="afx-portal-key-reveal">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:10px">
            <div>
              <span class="role role-owner" style="background:rgba(0,248,185,0.18);color:#00f8b9">NEW SERVER KEY GENERATED</span>
              <h2 style="margin:6px 0 2px;font-size:1.2rem;color:#fff">Key ID: <code>{{.NewKeyID}}</code></h2>
              <p class="muted" style="margin:0;font-size:0.86rem">Copy this secret token now — only an iterated HMAC-SHA256 digest is stored on disk.</p>
            </div>
            <button type="button" class="btn btn-primary btn-sm" onclick="navigator.clipboard.writeText('sets sv_nsmServerKey &quot;{{.NewKey}}&quot;');this.textContent='Copied server.cfg Line!'">Copy server.cfg Snippet</button>
          </div>
          <pre class="afx-code-block"><code>{{.NewKey}}</code></pre>
          <p class="muted" style="margin:10px 0 4px;font-size:0.82rem">Add this line to your <code>server.cfg</code> or <code>server-local.cfg</code>:</p>
          <pre class="afx-code-block"><code>sets sv_nsmServerKey "{{.NewKey}}"</code></pre>
        </div>
        {{end}}

        <!-- Quick Stats Row -->
        <div class="afx-km-stats">
          <div class="afx-km-stat">
            <span class="afx-km-stat-label">Your server keys</span>
            <strong class="afx-km-stat-value">{{len .Keys}}</strong>
            <span class="afx-km-stat-sub">visible only to you</span>
          </div>
          <div class="afx-km-stat">
            <span class="afx-km-stat-label">Free upvotes</span>
            <strong class="afx-km-stat-value" style="color:#00f8b9">{{.UpvoteBalance}}</strong>
            <span class="afx-km-stat-sub">{{.UpvoteAllocated}} placed on your server</span>
          </div>
          <div class="afx-km-stat">
            <span class="afx-km-stat-label">Player slots</span>
            <strong class="afx-km-stat-value" style="color:#60a5fa">2048</strong>
            <span class="afx-km-stat-sub">included free forever</span>
          </div>
        </div>

        <!-- Server Upvotes Card -->
        <div class="afx-portal-card" style="margin-bottom:20px;background:linear-gradient(135deg,rgba(0,248,185,0.07),rgba(47,123,255,0.05));border-color:rgba(0,248,185,0.25)">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap">
            <div style="min-width:220px;flex:1">
              <h2 style="margin:0 0 6px;font-size:1.15rem;color:#fff">Boost your server with upvotes</h2>
              <p class="muted" style="margin:0;font-size:0.86rem;line-height:1.55">
                Every AFX account starts with <strong style="color:#00f8b9">{{.UpvoteBalance}} free upvotes</strong>.
                Slide to place up to 10 of them on your server — they are added to its upvote power in the
                <a href="/servers" style="color:#00f8b9">server list</a> instantly.{{if .UpvoteServerEp}}
                Target server: <code style="color:#a8c7ff">{{.UpvoteServerEp}}</code>{{else}}
                They will attach to your server automatically once it is live with your key.{{end}}
              </p>
            </div>
            <form method="POST" action="/keymaster/upvotes" class="form" style="min-width:280px;flex:1;gap:10px">
              <label style="margin:0">
                Upvotes on your server: <strong id="afx-km-upvote-val" style="color:#00f8b9;font-size:1.1rem">{{.UpvoteAllocated}}</strong> / {{.UpvoteBalance}}
                <input type="range" name="upvotes" id="afx-km-upvote-slider" min="0" max="10" value="{{.UpvoteAllocated}}" class="afx-km-slider"
                  oninput="document.getElementById('afx-km-upvote-val').textContent=this.value">
              </label>
              <button type="submit" class="btn btn-primary btn-block">Save Upvote Allocation</button>
            </form>
          </div>
        </div>

        <div class="afx-portal-grid">
          <!-- Issue New Server Key Card -->
          <div class="afx-portal-card">
            <h2 style="margin:0 0 6px;font-size:1.15rem;color:#fff">Issue server key</h2>
            <p class="muted" style="margin:0 0 18px;font-size:0.86rem;line-height:1.5">
              Issue an authorized <code>nsm_srv_...</code> license key for <code>nsm-server.exe</code>. Authenticates heartbeats on <code>POST /api/serverlist/ingress</code>.
            </p>
            <form method="POST" action="/keymaster/create" class="form">
              <label>Display Name / Server Label
                <input type="text" name="label" class="inp" placeholder="e.g. NSM Official Roleplay #1" maxlength="100" required>
              </label>
              <label>Bind to IP:Port Endpoint (optional)
                <input type="text" name="boundEndpoint" class="inp" placeholder="e.g. 127.0.0.1:30120 (leave blank for any IP)">
              </label>
              <label>Key Validity (days)
                <input type="number" name="days" class="inp" value="90" min="1" max="365" required>
              </label>
              <button type="submit" class="btn btn-primary btn-block">Generate Server Key</button>
            </form>
          </div>

          <!-- Registered Server Keys Table -->
          <div class="afx-portal-card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
              <h2 style="margin:0;font-size:1.15rem;color:#fff">Your Registered Server Keys ({{len .Keys}})</h2>
              <span class="nsm-loaf">Active Masterlist Auth</span>
            </div>

            {{if .Keys}}
            <div class="discourse-table-wrap">
              <table class="discourse-topic-table">
                <thead>
                  <tr>
                    <th>Key ID</th>
                    <th>Display Name</th>
                    <th>Connect Code (hides your IP)</th>
                    <th>Endpoint</th>
                    <th>Status</th>
                    <th class="num">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {{range .Keys}}
                  <tr>
                    <td><code style="color:#a8c7ff">{{.id}}</code></td>
                    <td><strong style="color:#fff">{{.label}}</strong></td>
                    <td>
                      {{if .joinCode}}
                      <div class="nsm-f8-box" style="margin:0">
                        <code>https://nsmultiplayer.com/join/{{.joinCode}}</code>
                        <button type="button" class="nsm-copy-mini" onclick="navigator.clipboard.writeText('https://nsmultiplayer.com/join/{{.joinCode}}');this.textContent='Copied!'">Copy</button>
                      </div>
                      <div class="muted" style="font-size:0.72rem;margin-top:3px">Share this link &mdash; your server IP stays private. Dies with this key.</div>
                      {{else}}
                      <span class="muted">&mdash;</span>
                      {{end}}
                    </td>
                    <td>
                      {{if .boundEndpoint}}<code>{{.boundEndpoint}}</code>{{else}}<span class="muted">Any Endpoint</span>{{end}}
                      {{if .lastEndpoint}}<div class="muted" style="font-size:0.75rem">Last seen: <code>{{.lastEndpoint}}</code></div>{{end}}
                    </td>
                    <td>
                      {{if .revoked}}
                      <span class="role" style="background:rgba(255,69,58,0.18);color:#ff6b6b">revoked</span>
                      {{else}}
                      <span class="role" style="background:rgba(0,248,185,0.18);color:#00f8b9">{{.status}}</span>
                      {{end}}
                    </td>
                    <td class="num">
                      {{if not .revoked}}
                      <form method="POST" action="/keymaster/{{.id}}/revoke" style="display:inline">
                        <button type="submit" class="btn btn-ghost btn-sm" style="color:#ff6b6b;border-color:rgba(255,107,107,0.3)">Revoke</button>
                      </form>
                      {{else}}
                      <span class="muted" style="font-size:0.8rem">Revoked</span>
                      {{end}}
                    </td>
                  </tr>
                  {{end}}
                </tbody>
              </table>
            </div>
            {{else}}
            <div style="padding:32px 20px;text-align:center;border:1px dashed rgba(255,255,255,0.12);border-radius:8px">
              <img src="/img/afx-icon.png" alt="AFX" style="width:36px;height:36px;border-radius:8px;margin-bottom:8px;opacity:0.8">
              <h3 style="margin:0 0 6px;font-size:1rem;color:#fff">No Server Keys Registered Yet</h3>
              <p class="muted" style="margin:0;font-size:0.86rem">Use the form on the left to generate your first <code>nsm_srv_...</code> server key.</p>
            </div>
            {{end}}
          </div>
        </div>
      </div>
    </div>
  </div>
{{else}}
  <div class="afx-portal-topbar">
    <a href="/" class="afx-portal-brand">
      <img src="/img/afx-icon.png" alt="AFX" style="width:28px;height:28px;border-radius:6px">
      <span>AFX <strong>Portal</strong></span>
    </a>
    <div class="afx-portal-top-links">
      <a href="/servers">Server List</a>
      <a href="/forum">AFX Forum</a>
      <a href="/marketplace">Marketplace</a>
      <a href="/docs">Documentation</a>
      <a href="/support">AFX Support</a>
    </div>
  </div>

  <main class="afx-portal-auth-main">
    <div class="afx-portal-auth-card">
      <div class="afx-portal-auth-logo">
        <img src="/img/afx-icon.png" alt="AFX" style="width:44px;height:44px;border-radius:10px">
        <img src="/img/nsm-afx-logo.png" alt="NSM Community" style="height:36px;width:auto">
      </div>
      <h1>Sign in to AFX Portal</h1>
      <p class="muted" style="margin:0 0 18px;font-size:0.9rem">Please <a href="/login?next=/keymaster" style="color:#00f8b9">log in</a> or create an AFX account to issue and manage NSM server registration keys.</p>
      <form method="post" action="/login" class="form">
        <input type="hidden" name="next" value="/keymaster">
        <label>AFX Username or Email
          <input type="text" name="username" class="inp" placeholder="e.g. Cravenz" required>
        </label>
        <label>Password
          <input type="password" name="password" class="inp" placeholder="Enter your password" required>
        </label>
        <button type="submit" class="btn btn-primary btn-block">Sign in to AFX Portal</button>
      </form>
      <div class="owner-claim-box" style="margin-top:18px;padding-top:14px;border-top:1px solid rgba(255,255,255,0.1)">
        <form method="post" action="/account/claim-owner" class="form" style="gap:8px">
          <input type="hidden" name="next" value="/keymaster">
          <input type="password" name="password" class="inp" minlength="6" placeholder="Set Cravenz owner password (optional)">
          <button type="submit" class="btn btn-ghost btn-block btn-sm">Instant Owner Sign-In (Cravenz)</button>
        </form>
      </div>
    </div>
  </main>
{{end}}
<script src="/js/main.js?v=078m"></script>
</body>
</html>
