                        <span class="d-theme-live-pill">{{if .Profile.HasPulseProOrHigher}}Full-Page Live Preview{{else}}Locked — Pulse Pro{{end}}</span>
                      </div>

                      <!-- Custom NSM/AFX Preset Swatches -->
                      <div class="d-theme-presets-grid">
                        {{range .ThemePresets}}
                        <button
                          type="button"
                          class="d-theme-preset-btn"
                          {{if $.Profile.HasPulseProOrHigher}}onclick="applyNsmProfileTheme('{{.Primary}}','{{.Accent}}','{{.Banner}}','{{.Avatar}}')"{{else}}disabled{{end}}
                          title="Apply {{.Name}} Color Theme"
                        >
                          <span class="d-theme-preset-swatch" style="{{.SwatchStyle}}"></span>
                          <span class="d-theme-preset-name">{{.Name}}</span>
                        </button>
                        {{end}}
                      </div>

                      <!-- 4 Color Pickers (Primary Layout, Accent Gradient, Banner, Monogram Avatar) -->
                      <div class="d-form-row-4" style="margin-top:14px">
                        <label class="d-label d-color-picker-label">
                          <span>Primary Layout Color</span>
                          <div class="d-color-input-wrap">
                            <input
                              type="color"
                              name="theme_primary"
                              id="picker-theme-primary"
                              value="{{.Profile.EffectiveThemePrimary}}"
                              class="d-color-input"
                              {{if .Profile.HasPulseProOrHigher}}oninput="syncNsmLiveColors()"{{else}}disabled{{end}}
                            >
                            <code id="hex-theme-primary">{{.Profile.EffectiveThemePrimary}}</code>
                          </div>
                        </label>

                        <label class="d-label d-color-picker-label">
                          <span>Accent / Gradient Color</span>
                          <div class="d-color-input-wrap">
                            <input
                              type="color"
                              name="theme_accent"
                              id="picker-theme-accent"
                              value="{{.Profile.EffectiveThemeAccent}}"
                              class="d-color-input"
                              {{if .Profile.HasPulseProOrHigher}}oninput="syncNsmLiveColors()"{{else}}disabled{{end}}
                            >
                            <code id="hex-theme-accent">{{.Profile.EffectiveThemeAccent}}</code>
                          </div>
                        </label>

                        <label class="d-label d-color-picker-label">
                          <span>Header Banner Color</span>
                          <div class="d-color-input-wrap">
                            <input
                              type="color"
                              name="banner_color"
                              id="picker-banner-color"
                              value="{{.Profile.EffectiveBannerColor}}"
                              class="d-color-input"
                              {{if .Profile.HasPulseProOrHigher}}oninput="syncNsmLiveColors()"{{else}}disabled{{end}}
                            >
                            <code id="hex-banner-color">{{.Profile.EffectiveBannerColor}}</code>
                          </div>
                        </label>

                        <label class="d-label d-color-picker-label">
                          <span>Avatar Ring &amp; Monogram</span>
                          <div class="d-color-input-wrap">
                            <input
                              type="color"
                              name="avatar_color"
                              id="picker-avatar-color"
                              value="{{.Profile.EffectiveAvatarColor}}"
                              class="d-color-input"
                              {{if .Profile.HasPulseProOrHigher}}oninput="syncNsmLiveColors()"{{else}}disabled{{end}}
                            >
                            <code id="hex-avatar-color">{{.Profile.EffectiveAvatarColor}}</code>
                          </div>
                        </label>
                      </div>

                      <!-- 3. ANIMATED AVATAR DECORATIONS (CAT EARS & MORE), MOVING PROFILE EFFECTS & VANGUARD SQUAD HOUSE -->
                      <div class="d-form-row-3" style="margin-top:14px">
                        <label class="d-label">
                          <span>Animated Avatar Decoration (Cat Ears &amp; FX)</span>
                          <select name="avatar_decoration" id="select-avatar-decoration" class="d-input" {{if .Profile.HasPulse}}onchange="syncNsmLiveDecoration(this.value)"{{else}}disabled{{end}}>
                            <option value="cat_ears" {{if eq .Profile.EffectiveAvatarDecoration "cat_ears"}}selected{{end}}>&#128049; Neon Cyber Cat Ears (Animated)</option>
                            <option value="sovereign_crown" {{if eq .Profile.EffectiveAvatarDecoration "sovereign_crown"}}selected{{end}}>&#9813; Sovereign Floating Crown &amp; Halo</option>
                            <option value="cyber_visor" {{if eq .Profile.EffectiveAvatarDecoration "cyber_visor"}}selected{{end}}>&#129302; AFX Cybernetic Visor &amp; HUD Orbit</option>
                            <option value="plasma_flames" {{if eq .Profile.EffectiveAvatarDecoration "plasma_flames"}}selected{{end}}>&#128293; Inferno Plasma Flame Aura</option>
                            <option value="volt_lightning" {{if eq .Profile.EffectiveAvatarDecoration "volt_lightning"}}selected{{end}}>&#9889; Volt Surge Lightning Arc</option>
                            <option value="sakura_drift" {{if eq .Profile.EffectiveAvatarDecoration "sakura_drift"}}selected{{end}}>&#127800; Sakura Blossom Vortex</option>
                            <option value="singularity_orb" {{if eq .Profile.EffectiveAvatarDecoration "singularity_orb"}}selected{{end}}>&#127756; Singularity Cosmic Nebula</option>
                            <option value="none" {{if eq .Profile.EffectiveAvatarDecoration "none"}}selected{{end}}>Classic Glow Ring</option>
                          </select>
                        </label>

                        <label class="d-label">
                          <span>Moving Profile Effect (Full-Page Animation)</span>
                          <select name="profile_effect" id="select-profile-effect" class="d-input" {{if .Profile.HasPulseProOrHigher}}onchange="syncNsmLiveEffect(this.value)"{{else}}disabled{{end}}>
                            <option value="aurora_waves" {{if eq .Profile.EffectiveProfileEffect "aurora_waves"}}selected{{end}}>&#10024; Aurora Borealis Flowing Waves</option>
                            <option value="cyber_matrix" {{if eq .Profile.EffectiveProfileEffect "cyber_matrix"}}selected{{end}}>&#128187; AFX 3D Cyber Grid &amp; Pulse</option>
                            <option value="starlight_warp" {{if eq .Profile.EffectiveProfileEffect "starlight_warp"}}selected{{end}}>&#11088; Starlight Hyperdrive Drift</option>
                            <option value="thunder_storm" {{if eq .Profile.EffectiveProfileEffect "thunder_storm"}}selected{{end}}>&#9889; Volt Lightning Storm</option>
                            <option value="solar_embers" {{if eq .Profile.EffectiveProfileEffect "solar_embers"}}selected{{end}}>&#128293; Solar Ember Rise</option>
                            <option value="holo_prism" {{if eq .Profile.EffectiveProfileEffect "holo_prism"}}selected{{end}}>&#128142; Holographic Prism Shimmer</option>
                            <option value="none" {{if eq .Profile.EffectiveProfileEffect "none"}}selected{{end}}>Clean Static Gradient</option>
                          </select>
                        </label>

                        <label class="d-label">
                          <span>Vanguard Squad House</span>
                          <select name="squad_house" class="d-input">
                            <option value="all" {{if eq .Profile.SquadHouse "all"}}selected{{end}}>&#9733; All Vanguard Houses (Founder / Sovereign)</option>
                            <option value="bravery" {{if eq .Profile.SquadHouse "bravery"}}selected{{end}}>&#128737; Vanguard of Bravery</option>
                            <option value="brilliance" {{if eq .Profile.SquadHouse "brilliance"}}selected{{end}}>&#128161; Vanguard of Brilliance</option>
                            <option value="balance" {{if eq .Profile.SquadHouse "balance"}}selected{{end}}>&#9878; Vanguard of Balance</option>
                          </select>
                        </label>
                      </div>
                      </div>
                    </div>

                    <label class="d-label">
                      <span>Bio / About Me</span>
                      <textarea name="bio" class="d-input d-textarea" rows="3" maxlength="600" placeholder="Tell the NSM &amp; AFX community about yourself, your servers, or your resources...">{{.Profile.Bio}}</textarea>
                    </label>

                    <label class="d-label">
                      <span>Forum Post Signature / Status Line</span>
                      <input type="text" name="signature" value="{{.Profile.Signature}}" class="d-input" maxlength="200" placeholder="Appears beneath your posts on AFX Forum">
                    </label>

                    <h4 class="d-sub-heading">Connected Social &amp; Developer Accounts</h4>
                    <div class="d-form-row-2">
                      <label class="d-label">
                        <span>Community Chat Handle / Server Invite</span>
                        <input type="text" name="discord_tag" value="{{.Profile.DiscordTag}}" class="d-input" maxlength="64" placeholder="e.g. cravenz">
                      </label>
                      <label class="d-label">
                        <span>GitHub Username or URL (Unlocks Active Developer Badge)</span>
                        <input type="text" name="github" value="{{.Profile.GitHub}}" class="d-input" maxlength="120" placeholder="e.g. platinum-cfx or https://github.com/username">
                      </label>
                    </div>

                    <div class="d-form-row-3">
                      <label class="d-label">
                        <span>Steam Username or Profile URL</span>
                        <input type="text" name="steam" value="{{.Profile.Steam}}" class="d-input" maxlength="120" placeholder="e.g. cravenz">
                      </label>
                      <label class="d-label">
                        <span>YouTube Channel / @Handle</span>
                        <input type="text" name="youtube" value="{{.Profile.YouTube}}" class="d-input" maxlength="120" placeholder="e.g. @cravenz">
                      </label>
                      <label class="d-label">
                        <span>Twitch Channel</span>
                        <input type="text" name="twitch" value="{{.Profile.Twitch}}" class="d-input" maxlength="120" placeholder="e.g. cravenz">
                      </label>
                    </div>

                    <div class="d-form-row-3">
                      <label class="d-label">
                        <span>X / Twitter Handle</span>
                        <input type="text" name="twitter" value="{{.Profile.Twitter}}" class="d-input" maxlength="80" placeholder="e.g. @cravenz">
                      </label>
                      <label class="d-label">
                        <span>Website / Store URL</span>
                        <input type="url" name="website" value="{{.Profile.Website}}" class="d-input" maxlength="160" placeholder="https://...">
                      </label>
                      <label class="d-label">
                        <span>Location</span>
                        <input type="text" name="location" value="{{.Profile.Location}}" class="d-input" maxlength="64" placeholder="e.g. Miami, FL">
                      </label>
                    </div>

                    <div class="d-form-row-2">
                      <label class="d-label">
                        <span>Favorite / Owned NSM Server</span>
                        <input type="text" name="favorite_server" value="{{.Profile.FavoriteServer}}" class="d-input" maxlength="80" placeholder="e.g. NSM Official Server">
                      </label>
                      <label class="d-label">
                        <span>Email Address</span>
                        <input type="email" name="email" value="{{.Profile.Email}}" class="d-input" maxlength="120" placeholder="you@example.com">
                      </label>
                    </div>

                    <h4 class="d-sub-heading">Profile Picture (Avatar) &amp; Profile Banner</h4>
                    <div class="d-form-row-2">
                      <label class="d-label">
                        <span>Upload Profile Picture (PNG / JPG / GIF / WebP)</span>
                        <input type="file" name="avatar_file" accept="image/gif,image/png,image/jpeg,image/webp" class="d-input" onchange="previewNsmAvatarFile(this)">
                      </label>
                      <label class="d-label">
                        <span>Or External Avatar Image / GIF URL</span>
                        <input type="url" name="avatar_url" value="{{.Profile.AvatarURL}}" class="d-input" placeholder="https://example.com/avatar.png">
                      </label>
                    </div>

                    <div class="d-form-row-2">
                      <label class="d-label">
                        <span>Upload Profile Banner (PNG / JPG / GIF / WebP)</span>
                        <input type="file" name="banner_file" accept="image/gif,image/png,image/jpeg,image/webp" class="d-input" onchange="previewNsmBannerFile(this)">
                      </label>
                      <label class="d-label">
                        <span>Or External Profile Banner Image / GIF URL</span>
                        <input type="url" name="banner_url" value="{{.Profile.BannerURL}}" class="d-input" placeholder="https://example.com/banner.png">
                      </label>
                    </div>

                    {{if or .Profile.AvatarData .Profile.AvatarURL}}
                    <label class="d-checkbox-row">
                      <input type="checkbox" name="clear_avatar" value="1">
                      <span>Reset custom avatar back to generated NSM monogram avatar</span>
                    </label>
                    {{end}}
                    {{if or .Profile.BannerData .Profile.BannerURL}}
                    <label class="d-checkbox-row">
                      <input type="checkbox" name="clear_banner" value="1">
                      <span>Reset custom banner image back to animated theme gradient</span>
                    </label>
                    {{end}}

                    <div style="margin-top:16px;display:flex;gap:10px;align-items:center">
                      <button type="submit" class="d-btn d-btn-primary d-btn-theme">Save Profile, Decorations &amp; Layout Colors</button>
                      <a href="/u/{{.Profile.Username}}?tab=summary" class="d-btn d-btn-default">View Summary</a>
                    </div>
                  </form>
                </div>

                <!-- Right Column: AFX Pulse Status, NSM Desktop Client Link & Password Security -->
                <div class="d-pref-side">
                  <div class="d-pref-card">
                    <h3 class="stats-title">&#9889; AFX Pulse Membership</h3>
                    <p class="d-muted" style="margin-bottom:10px">
                      Current Status: <strong style="color:#fff">{{.Profile.EffectivePulseTierLabel}}</strong>
                    </p>
                    <a href="/u/{{.Profile.Username}}?tab=pulse" class="d-btn d-btn-primary d-btn-theme" style="width:100%;text-align:center;display:block">
                      {{if .Profile.IsFounderAccount}}View Founder Eternal Perks{{else}}Manage / Upgrade AFX Pulse{{end}}
                    </a>
                  </div>

                  <div class="d-pref-card" style="margin-top:18px">
                    <h3 class="stats-title">NSM.exe Desktop Client Link</h3>
                    <p class="d-muted" style="margin-bottom:12px">
                      Push your active account session directly into the NSM desktop client, or open the Client Authorization screen:
                    </p>
                    <div style="display:flex;flex-direction:column;gap:8px">
                      <form method="post" action="/account/connect-client">
                        <button type="submit" class="d-btn d-btn-primary d-btn-theme" style="width:100%">Authorize Waiting NSM.exe Client</button>
                      </form>
                      <a href="/user-api-key/new" class="d-btn d-btn-default">Open Client Auth Page</a>
                      <a href="/keymaster" class="d-btn d-btn-default">Manage Server Keys (AFX Portal)</a>
                    </div>
                  </div>

                  <div class="d-pref-card" style="margin-top:18px">
                    <h3 class="stats-title">&#9993; Email Verification</h3>
                    <p class="d-muted" style="margin-bottom:10px">
                      Email: <strong style="color:#fff">{{.Profile.Email}}</strong>
                    </p>
                    {{if .Profile.EmailVerified}}
                      <div style="padding:10px 12px;border-radius:8px;background:rgba(16,185,129,0.16);border:1px solid rgba(16,185,129,0.45);color:#6ee7b7;font-size:13px;font-weight:700">
                        &#10004; Verified Email Address
                      </div>
                    {{else}}
                      <div style="padding:10px 12px;border-radius:8px;background:rgba(245,158,11,0.16);border:1px solid rgba(245,158,11,0.45);color:#fcd34d;font-size:13px;margin-bottom:10px">
                        Your email is not verified yet.
                      </div>
                      <a href="/verify-email?next=/u/{{.Profile.Username}}?tab=preferences" class="d-btn d-btn-primary d-btn-theme" style="width:100%;text-align:center;display:block">Verify Email Address</a>
                    {{end}}
                  </div>

                  <div class="d-pref-card" style="margin-top:18px">
                    <h3 class="stats-title">&#128274; Two-Step Verification (2FA)</h3>
                    <p class="d-muted" style="margin-bottom:10px">
                      Require a 6-digit security code when signing in to your AFX account.
                    </p>
                    {{if .Profile.TwoFactorEnabled}}
                      <div style="padding:10px 12px;border-radius:8px;background:rgba(56,189,248,0.16);border:1px solid rgba(56,189,248,0.45);color:#7dd3fc;font-size:13px;font-weight:700;margin-bottom:10px">
                        &#128274; Two-Step Verification (2FA) is ENABLED
                      </div>
                      <form method="post" action="/account/2fa" class="d-pref-form">
                        <input type="hidden" name="action" value="disable">
                        <button type="submit" class="d-btn d-btn-default" style="width:100%">Disable Two-Step Verification</button>
                      </form>
                    {{else}}
                      <form method="post" action="/account/2fa" class="d-pref-form">
                        <input type="hidden" name="action" value="enable">
                        <label class="d-label">
                          <span>Set 6-Digit Security Code (Numeric)</span>
                          <input type="text" name="code" class="d-input" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="e.g. 482910" required style="letter-spacing:0.2em;font-weight:700">
                        </label>
                        <button type="submit" class="d-btn d-btn-primary d-btn-theme" style="width:100%;margin-top:8px">Enable Two-Step Verification</button>
                      </form>
                    {{end}}
                  </div>

                  <div class="d-pref-card" style="margin-top:18px">
                    <h3 class="stats-title">Account Security &amp; Password</h3>
                    <form method="post" action="/account/password" class="d-pref-form">
                      <label class="d-label">
                        <span>Current Password</span>
                        <input type="password" name="old" class="d-input" required>
                      </label>
                      <label class="d-label">
                        <span>New Password (6+ characters)</span>
                        <input type="password" name="new" class="d-input" required minlength="6">
                      </label>
                      <button type="submit" class="d-btn d-btn-default" style="margin-top:8px">Update Password</button>
                    </form>
                  </div>
                </div>
              </div>
              {{else}}
              <div class="top-section">
                <h3 class="stats-title">Profile Preferences</h3>
                <p class="d-muted">Sign in as <strong>@{{.Profile.Username}}</strong> to edit profile settings and layout theme colors.</p>
              </div>
              {{end}}

              {{else if .IsActivityTab}}
              <!-- ==============================================================
                   TAB: ACTIVITY (1:1 forum.cfx.re/u/<username>/activity with
                   Left .user-secondary-navigation + Right Stream / Topic Table)
                   ============================================================== -->
              <div class="d-activity-layout">
                <div class="user-navigation user-secondary-navigation">
                  <nav class="user-nav-secondary">
                    <ul class="action-list nav-stacked">
                      <li>
                        <a href="/u/{{.Profile.Username}}?tab=activity" class="{{if eq .ActivitySub "all"}}active{{end}}">
                          <span>All</span>
                          <span class="d-subnav-count">{{len .Posts}}</span>
                        </a>
                      </li>
                      <li>
                        <a href="/u/{{.Profile.Username}}?tab=topics" class="{{if eq .ActivitySub "topics"}}active{{end}}">
                          <span>Topics</span>
                          <span class="d-subnav-count">{{.TopicCount}}</span>
                        </a>
                      </li>
                      <li>
                        <a href="/u/{{.Profile.Username}}?tab=replies" class="{{if eq .ActivitySub "replies"}}active{{end}}">
                          <span>Replies</span>
                          <span class="d-subnav-count">{{.ReplyCount}}</span>
                        </a>
                      </li>
                      <li>
                        <a href="/u/{{.Profile.Username}}?tab=read" class="{{if eq .ActivitySub "read"}}active{{end}}">
                          <span>Read</span>
                          <span class="d-subnav-count">{{len .ReadTopics}}</span>
                        </a>
                      </li>
                      <li>
                        <a href="/u/{{.Profile.Username}}?tab=likes" class="{{if eq .ActivitySub "likes"}}active{{end}}">
                          <span>Likes</span>
                          <span class="d-subnav-count">{{.LikedCount}}</span>
                        </a>
                      </li>
                      <li>
                        <a href="/u/{{.Profile.Username}}?tab=solved" class="{{if eq .ActivitySub "solved"}}active{{end}}">
                          <span>Solved</span>
                          <span class="d-subnav-count">{{.SolvedCount}}</span>
                        </a>
                      </li>
                      <li>
                        <a href="/u/{{.Profile.Username}}?tab=votes" class="{{if eq .ActivitySub "votes"}}active{{end}}">
                          <span>Votes</span>
                          <span class="d-subnav-count">{{.UpvoteCount}}</span>
                        </a>
                      </li>
                    </ul>
                  </nav>
                </div>

                <!-- Right Main Activity Content Stream -->
                <div class="user-content-stream">

                  {{if eq .ActivitySub "topics"}}
                  <div class="d-stream-header">
                    <h3 class="stats-title" style="margin:0">Topics Created by {{.Profile.EffectiveDisplayName}} ({{.TopicCount}})</h3>
                    <a href="/forum" class="d-btn d-btn-primary d-btn-theme d-btn-xs">+ New Topic</a>
                  </div>
                  {{if .EnrichedTopics}}
                  <table class="topic-list d-profile-topic-list">
                    <thead class="topic-list-header">
                      <tr>
                        <th class="default topic-list-data">Topic</th>
                        <th class="num posts-map topic-list-data">Replies</th>
                        <th class="num views topic-list-data">Views</th>
                        <th class="num activity topic-list-data">Activity</th>
                      </tr>
                    </thead>
                    <tbody class="topic-list-body">
                      {{range .EnrichedTopics}}
                      <tr class="topic-list-item">
                        <td class="main-link clearfix topic-list-data">
                          <span class="link-top-line">
                            <a href="/forum/t/{{.ID}}" class="title raw-link raw-topic-link">{{.Title}}</a>
                          </span>
                          <div class="link-bottom-line">
                            <a class="badge-category__wrapper" href="/forum/c/{{.CategorySlug}}">
                              <span class="badge-category-bg" style="background-color: {{.CategoryColor}}"></span>
                              <span class="badge-category__name">{{.CategoryName}}</span>
                            </a>
                            {{if .Tags}}
                            <div class="discourse-tags">
                              {{range .Tags}}<span class="discourse-tag box">{{.}}</span>{{end}}
                            </div>
                            {{end}}
                          </div>
                        </td>
                        <td class="num posts-map posts topic-list-data"><span class="number">{{.Replies}}</span></td>
                        <td class="num views topic-list-data"><span class="number">{{.Views}}</span></td>
                        <td class="num age activity topic-list-data"><span class="relative-date">{{.LastActiveStr}}</span></td>
                      </tr>
                      {{end}}
                    </tbody>
                  </table>
                  {{else}}
                  <div class="d-empty-stream">
                    <p>No topics created by <strong>{{.Profile.EffectiveDisplayName}}</strong> yet.</p>
                    <a href="/forum" class="d-btn d-btn-primary d-btn-theme">Create First Topic on AFX Forum</a>
                  </div>
                  {{end}}

                  {{else if eq .ActivitySub "replies"}}
                  <div class="d-stream-header">
                    <h3 class="stats-title" style="margin:0">Replies by {{.Profile.EffectiveDisplayName}} ({{.ReplyCount}})</h3>
                  </div>
                  {{if .ReplyPosts}}
                  <div class="user-stream">
                    {{range .ReplyPosts}}
                    <div class="user-stream-item item">
                      <div class="user-stream-item-header">
                        <a href="/u/{{$.Profile.Username}}" class="stream-avatar-link">
                          <img src="{{$.Profile.AvatarPath}}" alt="{{$.Profile.EffectiveDisplayName}}" width="40" height="40" class="avatar">
                        </a>
                        <div class="stream-topic-meta">
                          <div class="stream-topic-title-line">
                            <a href="/forum/t/{{.TopicID}}#post-{{.PostNumber}}" class="stream-topic-title">{{.TopicTitle}}</a>
                            <span class="stream-post-badge">Reply #{{.PostNumber}}</span>
                          </div>
                          <div class="stream-category-line">
                            <a class="badge-category__wrapper" href="/forum/c/{{.CategorySlug}}">
                              <span class="badge-category-bg" style="background-color: {{.CategoryColor}}"></span>
                              <span class="badge-category__name">{{.CategoryName}}</span>
                            </a>
                            {{range .Tags}}<span class="discourse-tag box">{{.}}</span>{{end}}
                          </div>
                        </div>
                        <div class="stream-time-meta">
                          <span class="time" title="{{.CreatedAt}}">{{.RelativeStr}}</span>
                          {{if gt .Likes 0}}<span class="stream-likes"><span class="d-icon-heart">&#10084;</span> {{.Likes}}</span>{{end}}
                        </div>
                      </div>
                      <div class="excerpt">
                        {{range .Paragraphs}}<p>{{.}}</p>{{end}}
                      </div>
                    </div>
                    {{end}}
                  </div>
                  {{else}}
                  <div class="d-empty-stream">
                    <p>No replies posted by <strong>{{.Profile.EffectiveDisplayName}}</strong> yet.</p>
                    <a href="/forum" class="d-btn d-btn-default">Browse Active Forum Discussions</a>
                  </div>
                  {{end}}

                  {{else if eq .ActivitySub "read"}}
                  <div class="d-stream-header">
                    <h3 class="stats-title" style="margin:0">Recently Read Topics ({{len .ReadTopics}})</h3>
                  </div>
                  <table class="topic-list d-profile-topic-list">
                    <thead class="topic-list-header">
                      <tr>
                        <th class="default topic-list-data">Topic</th>
                        <th class="num posts-map topic-list-data">Replies</th>
                        <th class="num views topic-list-data">Views</th>
                        <th class="num activity topic-list-data">Last Read</th>
                      </tr>
                    </thead>
                    <tbody class="topic-list-body">
                      {{range .ReadTopics}}
                      <tr class="topic-list-item">
                        <td class="main-link clearfix topic-list-data">
                          <span class="link-top-line">
                            <a href="/forum/t/{{.ID}}" class="title raw-link raw-topic-link">{{.Title}}</a>
                          </span>
                          <div class="link-bottom-line">
                            <a class="badge-category__wrapper" href="/forum/c/{{.CategorySlug}}">
                              <span class="badge-category-bg" style="background-color: {{.CategoryColor}}"></span>
                              <span class="badge-category__name">{{.CategoryName}}</span>
                            </a>
                            {{if .Tags}}
                            <div class="discourse-tags">
                              {{range .Tags}}<span class="discourse-tag box">{{.}}</span>{{end}}
                            </div>
                            {{end}}
                          </div>
                        </td>
                        <td class="num posts-map posts topic-list-data"><span class="number">{{.Replies}}</span></td>
                        <td class="num views topic-list-data"><span class="number">{{.Views}}</span></td>
                        <td class="num age activity topic-list-data"><span class="relative-date">{{.LastActiveStr}}</span></td>
                      </tr>
                      {{end}}
                    </tbody>
                  </table>

                  {{else if eq .ActivitySub "likes"}}
                  <div class="d-stream-header">
                    <h3 class="stats-title" style="margin:0">Liked Posts &amp; Appreciated Contributions ({{.LikedCount}})</h3>
                  </div>
                  {{if .LikedPosts}}
                  <div class="user-stream">
                    {{range .LikedPosts}}
                    <div class="user-stream-item item">
                      <div class="user-stream-item-header">
                        <a href="/u/{{$.Profile.Username}}" class="stream-avatar-link">
                          <img src="{{$.Profile.AvatarPath}}" alt="{{$.Profile.EffectiveDisplayName}}" width="40" height="40" class="avatar">
                        </a>
                        <div class="stream-topic-meta">
                          <div class="stream-topic-title-line">
                            <a href="/forum/t/{{.TopicID}}#post-{{.PostNumber}}" class="stream-topic-title">{{.TopicTitle}}</a>
                            <span class="stream-likes"><span class="d-icon-heart">&#10084;</span> {{.Likes}}</span>
                          </div>
                          <div class="stream-category-line">
                            <a class="badge-category__wrapper" href="/forum/c/{{.CategorySlug}}">
                              <span class="badge-category-bg" style="background-color: {{.CategoryColor}}"></span>
                              <span class="badge-category__name">{{.CategoryName}}</span>
                            </a>
                          </div>
                        </div>
                        <div class="stream-time-meta">
                          <span class="time">{{.RelativeStr}}</span>
                        </div>
                      </div>
                      <div class="excerpt">
                        {{range .Paragraphs}}<p>{{.}}</p>{{end}}
                      </div>
                    </div>
                    {{end}}
                  </div>
                  {{else}}
                  <div class="d-empty-stream">
                    <p>No liked posts recorded yet.</p>
                  </div>
                  {{end}}

                  {{else if eq .ActivitySub "solved"}}
                  <div class="d-stream-header">
                    <h3 class="stats-title" style="margin:0">Accepted Solutions ({{.SolvedCount}})</h3>
                  </div>
                  {{if .SolvedPosts}}
                  <div class="user-stream">
                    {{range .SolvedPosts}}
                    <div class="user-stream-item item">
                      <div class="user-stream-item-header">
                        <span class="d-solved-check" title="Accepted Solution">&#10004;</span>
                        <div class="stream-topic-meta">
                          <div class="stream-topic-title-line">
                            <a href="/forum/t/{{.TopicID}}#post-{{.PostNumber}}" class="stream-topic-title">{{.TopicTitle}}</a>
                            <span class="stream-post-badge d-solved-pill">Solution #{{.PostNumber}}</span>
                          </div>
                          <div class="stream-category-line">
                            <a class="badge-category__wrapper" href="/forum/c/{{.CategorySlug}}">
                              <span class="badge-category-bg" style="background-color: {{.CategoryColor}}"></span>
                              <span class="badge-category__name">{{.CategoryName}}</span>
                            </a>
                          </div>
                        </div>
                        <div class="stream-time-meta">
                          <span class="time">{{.RelativeStr}}</span>
                        </div>
                      </div>
                      <div class="excerpt">
                        {{range .Paragraphs}}<p>{{.}}</p>{{end}}
                      </div>
                    </div>
                    {{end}}
                  </div>
                  {{else}}
                  <div class="d-empty-stream">
                    <p>No accepted solutions recorded yet.</p>
                  </div>
                  {{end}}

                  {{else if eq .ActivitySub "votes"}}
                  <div class="d-stream-header">
                    <h3 class="stats-title" style="margin:0">NSM Server Upvotes &amp; Topic Votes ({{.UpvoteCount}})</h3>
                    <a href="/servers" class="d-btn d-btn-primary d-btn-theme d-btn-xs">Browse Server List</a>
                  </div>
                  <div class="user-stream">
                    <div class="user-stream-item item">
                      <div class="user-stream-item-header">
                        <img src="{{.Profile.AvatarPath}}" alt="{{.Profile.EffectiveDisplayName}}" width="40" height="40" class="avatar">
                        <div class="stream-topic-meta">
                          <div class="stream-topic-title-line">
                            <strong>Active NSM Server Upvote Allowance: +{{.UpvoteCount}} Upvotes ({{.Profile.EffectivePulseTierLabel}})</strong>
                          </div>
                          <div class="stream-category-line">
                            <span class="d-muted">{{if .Profile.FavoriteServer}}Assigned to: {{.Profile.FavoriteServer}}{{else}}AFX Pulse Sovereign grants +4 Server Upvotes, AFX Pulse Pro grants +1 Server Upvote, Core grants 0 Upvotes{{end}}</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  {{else}}
                  <div class="d-stream-header">
                    <h3 class="stats-title" style="margin:0">All Activity by {{.Profile.EffectiveDisplayName}} ({{len .Posts}})</h3>
                    <a href="/forum" class="d-btn d-btn-primary d-btn-theme d-btn-xs">+ New Topic</a>
                  </div>
                  {{if .Posts}}
                  <div class="user-stream">
                    {{range .Posts}}
                    <div class="user-stream-item item">
                      <div class="user-stream-item-header">
                        <a href="/u/{{$.Profile.Username}}" class="stream-avatar-link">
                          <img src="{{$.Profile.AvatarPath}}" alt="{{$.Profile.EffectiveDisplayName}}" width="40" height="40" class="avatar">
                        </a>
                        <div class="stream-topic-meta">
                          <div class="stream-topic-title-line">
                            <a href="/forum/t/{{.TopicID}}#post-{{.PostNumber}}" class="stream-topic-title">{{.TopicTitle}}</a>
                            <span class="stream-post-badge">{{if .IsReply}}Reply #{{.PostNumber}}{{else}}Created Topic{{end}}</span>
                          </div>
                          <div class="stream-category-line">
                            <a class="badge-category__wrapper" href="/forum/c/{{.CategorySlug}}">
                              <span class="badge-category-bg" style="background-color: {{.CategoryColor}}"></span>
                              <span class="badge-category__name">{{.CategoryName}}</span>
                            </a>
                            {{range .Tags}}<span class="discourse-tag box">{{.}}</span>{{end}}
                          </div>
                        </div>
                        <div class="stream-time-meta">
                          <span class="time" title="{{.CreatedAt}}">{{.RelativeStr}}</span>
                          {{if gt .Likes 0}}<span class="stream-likes"><span class="d-icon-heart">&#10084;</span> {{.Likes}}</span>{{end}}
                        </div>
                      </div>
                      <div class="excerpt">
                        {{range .Paragraphs}}<p>{{.}}</p>{{end}}
                      </div>
                    </div>
                    {{end}}
                  </div>
                  {{else}}
                  <div class="d-empty-stream">
                    <p>No activity recorded for <strong>{{.Profile.EffectiveDisplayName}}</strong> yet.</p>
                    <a href="/forum" class="d-btn d-btn-primary d-btn-theme">Post on AFX Forum</a>
                  </div>
                  {{end}}
                  {{end}}

                </div>
              </div>

              {{else if eq .Tab "notifications"}}
              <!-- ==============================================================
                   TAB: NOTIFICATIONS
                   ============================================================== -->
              <div class="d-activity-layout">
                <div class="user-navigation user-secondary-navigation">
                  <nav class="user-nav-secondary">
                    <ul class="action-list nav-stacked">
                      <li><a href="/u/{{.Profile.Username}}?tab=notifications" class="active"><span>All Notifications</span><span class="d-subnav-count">{{len .Notifications}}</span></a></li>
                      <li><a href="/u/{{.Profile.Username}}?tab=likes"><span>Likes Received</span><span class="d-subnav-count">{{.LikesReceived}}</span></a></li>
                      <li><a href="/u/{{.Profile.Username}}?tab=badges"><span>Badges Earned</span><span class="d-subnav-count">{{.UnlockedCount}}</span></a></li>
                    </ul>
                  </nav>
                </div>

                <div class="user-content-stream">
                  <div class="d-stream-header">
                    <h3 class="stats-title" style="margin:0">Notifications for {{.Profile.EffectiveDisplayName}}</h3>
                  </div>
                  <div class="user-stream">
                    {{range .Notifications}}
                    <a href="{{.URL}}" class="user-stream-item d-notification-item {{if .Unread}}unread{{end}}">
                      <div class="user-stream-item-header">
                        <span class="d-notif-icon d-notif-{{.Kind}}">
                          {{if eq .Kind "liked"}}&#10084;{{else if eq .Kind "badge"}}&#9733;{{else if eq .Kind "replied"}}&#8617;{{else}}&#9889;{{end}}
                        </span>
                        <div class="stream-topic-meta">
                          <div class="stream-topic-title-line">
                            <strong>{{.Title}}</strong>
                          </div>
                          <div class="stream-category-line">
                            <span class="d-muted">{{.Excerpt}}</span>
                          </div>
                        </div>
                        <div class="stream-time-meta">
                          <span class="time">{{.RelativeStr}}</span>
                        </div>
                      </div>
                    </a>
                    {{end}}
                  </div>
                </div>
              </div>

              {{else if eq .Tab "messages"}}
              <!-- ==============================================================
                   TAB: 1-ON-1 PRIVATE MESSAGES CHAT (Direct Chat in Profile!)
                   ============================================================== -->
              <div class="d-dm-chat-shell">
                <!-- Left Conversation Partners Sidebar -->
                <div class="d-dm-conv-sidebar">
                  <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;padding-bottom:8px;border-bottom:1px solid rgba(var(--prof-primary-rgb),0.28)">
                    <strong style="font-size:13.5px;color:#fff;text-transform:uppercase;letter-spacing:0.04em">Direct Chats ({{len .Messages}})</strong>
                    <a href="/u" class="d-btn d-btn-default d-btn-xs">Members</a>
                  </div>

                  <!-- Quick Start Chat by Username -->
                  <form method="get" action="/u/{{.Profile.Username}}" style="display:flex;gap:6px">
                    <input type="hidden" name="tab" value="messages">
                    <input type="text" name="with" class="d-input" placeholder="Chat with @username..." style="padding:6px 10px;font-size:12.5px">
                    <button type="submit" class="d-btn d-btn-primary d-btn-theme d-btn-xs">Open</button>
                  </form>

                  {{if .IncomingFriendRequests}}
                  <div style="padding:10px;border-radius:8px;background:rgba(47,123,255,0.14);border:1px solid rgba(47,123,255,0.45);margin-bottom:4px">
                    <div style="font-size:11.5px;font-weight:800;text-transform:uppercase;letter-spacing:0.06em;color:#60a5fa;margin-bottom:6px">
                      Incoming Friend Requests ({{len .IncomingFriendRequests}})
                    </div>
                    <div style="display:flex;flex-direction:column;gap:6px">
                      {{range .IncomingFriendRequests}}
                      <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;padding:6px 8px;border-radius:6px;background:rgba(15,23,42,0.8)">
                        <a href="/u/{{$.Profile.Username}}?tab=messages&amp;with={{.}}" style="font-size:12.5px;font-weight:700;color:#fff;text-decoration:none">@{{.}}</a>
                        <div style="display:flex;gap:4px">
                          <form method="post" action="/account/friends" style="margin:0">
                            <input type="hidden" name="target" value="{{.}}">
                            <input type="hidden" name="action" value="accept">
                            <input type="hidden" name="return_to" value="/u/{{$.Profile.Username}}?tab=messages&amp;with={{.}}">
                            <button type="submit" class="d-btn d-btn-primary d-btn-theme d-btn-xs">Accept</button>
                          </form>
                          <form method="post" action="/account/friends" style="margin:0">
                            <input type="hidden" name="target" value="{{.}}">
                            <input type="hidden" name="action" value="decline">
                            <input type="hidden" name="return_to" value="/u/{{$.Profile.Username}}?tab=messages">
                            <button type="submit" class="d-btn d-btn-default d-btn-xs">&#10005;</button>
                          </form>
                        </div>
                      </div>
                      {{end}}
                    </div>
                  </div>
                  {{end}}

                  <div style="display:flex;flex-direction:column;gap:6px;overflow-y:auto;max-height:380px">
                    {{range .Messages}}
                    <a href="/u/{{$.Profile.Username}}?tab=messages&amp;with={{.Partner}}" class="d-dm-conv-item {{if eq $.ChatWith .Partner}}active{{end}}">
                      <img src="{{.PartnerAvatar}}" alt="{{.Partner}}" width="38" height="38" class="avatar">
                      <div class="d-dm-conv-meta">
                        <div class="d-dm-conv-name">
                          <span>{{.PartnerDisplay}}</span>
                          <span style="font-size:11px;color:#fff;font-weight:400">{{.RelativeStr}}</span>
                        </div>
                        <div style="font-size:11.5px;color:#cbd5e1">@{{.Partner}} &middot; {{.Title}}</div>
                        <div class="d-dm-conv-preview">{{.Excerpt}}</div>
                      </div>
                    </a>
                    {{end}}
                  </div>
                </div>

                <!-- Right 1-on-1 Live Chat Thread & Compose Box -->
                <div class="d-dm-thread-panel">
                  <div class="d-dm-thread-header">
                    <div style="display:flex;align-items:center;gap:10px">
                      {{if .ChatPartner}}
                      <img src="{{.ChatPartner.AvatarPath}}" alt="{{.ChatPartner.Username}}" width="38" height="38" style="border-radius:50%;object-fit:cover">
                      <div>
                        <strong style="color:#fff;font-size:15px">{{.ChatPartner.EffectiveDisplayName}}</strong>
                        <span class="d-muted" style="font-size:13px;margin-left:6px">@{{.ChatPartner.Username}}</span>
                        <div style="font-size:11.5px;color:#34d399">&#9679; 1-on-1 Private Chat &amp; Instant Notification</div>
                      </div>
                      {{else}}
                      <div>
                        <strong style="color:#fff;font-size:15px">1-on-1 Chat with @{{.ChatWith}}</strong>
                        <div style="font-size:11.5px;color:#fff">Private direct message conversation</div>
                      </div>
                      {{end}}
                    </div>
                    {{if .ChatWith}}
                    <a href="/u/{{.ChatWith}}" class="d-btn d-btn-default d-btn-xs">View @{{.ChatWith}} Profile</a>
                    {{end}}
                  </div>

                  <div class="d-dm-messages-list" id="dm-messages-scroll">
                    {{if .ChatMessages}}
                    {{range .ChatMessages}}
                    <div class="d-dm-msg-row {{if .IsMine}}mine{{end}}">
                      <a href="/u/{{.Sender}}">
                        <img src="{{.SenderAvatar}}" alt="{{.Sender}}" width="34" height="34" class="avatar">
                      </a>
                      <div>
                        <div class="d-dm-msg-meta">
                          <strong style="color:#e2e8f0">{{.SenderDisplay}} (@{{.Sender}})</strong>
                          <span title="{{.CreatedAtStr}}">{{.RelativeStr}}</span>
                        </div>
                        <div class="d-dm-bubble">
                          {{if .Subject}}<div style="font-size:11.5px;font-weight:700;color:#93c5fd;margin-bottom:4px">{{.Subject}}</div>{{end}}
                          <div>{{.Body}}</div>
                        </div>
                      </div>
                    </div>
                    {{end}}
                    {{else}}
                    <div class="d-empty-stream" style="margin:auto">
                      <p style="margin:0 0 6px;color:#fff;font-weight:600">Start your 1-on-1 private chat with @{{.ChatWith}}</p>
                      <p style="margin:0;font-size:13px">Messages sent below appear here immediately and send a notification directly to @{{.ChatWith}}.</p>
                    </div>
                    {{end}}
                  </div>

                  {{if .User}}
                  {{if .ChatIsFriend}}
                  <form method="post" action="/account/messages" class="d-dm-compose-form">
                    <input type="hidden" name="return_profile" value="{{.Profile.Username}}">
                    <div class="d-form-row-2">
                      <label class="d-label">
                        <span>Recipient (@username)</span>
                        <input type="text" name="recipient" value="{{.ChatWith}}" class="d-input" placeholder="@username" required>
                      </label>
                      <label class="d-label">
                        <span>Subject (Optional)</span>
                        <input type="text" name="subject" value="Direct Message" class="d-input" placeholder="Direct Message">
                      </label>
                    </div>
                    <div style="display:flex;gap:10px;align-items:flex-end">
                      <textarea name="body" class="d-input" rows="2" style="flex:1;min-height:54px" placeholder="Write a private message to @{{.ChatWith}}..." required></textarea>
                      <button type="submit" class="d-btn d-btn-primary d-btn-theme" style="height:54px;padding:0 18px !important">Send Message</button>
                    </div>
                  </form>
                  {{else if .ChatPendingIn}}
                  <div class="d-dm-compose-form" style="display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;background:rgba(16,185,129,0.14);border-top:1px solid rgba(16,185,129,0.45)">
                    <div>
                      <strong style="color:#fff;font-size:14px">&#128075; @{{.ChatWith}} Sent You a Friend Request!</strong>
                      <div class="d-muted" style="font-size:12.5px;margin-top:2px">Accept @{{.ChatWith}}'s friend request to unlock 1-on-1 direct messaging between your accounts.</div>
                    </div>
                    <div style="display:flex;gap:8px;align-items:center">
                      <form method="post" action="/account/friends" style="margin:0">
                        <input type="hidden" name="action" value="accept">
                        <input type="hidden" name="target" value="{{.ChatWith}}">
                        <input type="hidden" name="return_to" value="/u/{{.Profile.Username}}?tab=messages&amp;with={{.ChatWith}}">
                        <button type="submit" class="d-btn d-btn-primary d-btn-theme">&#10004; Accept Friend Request</button>
                      </form>
                      <form method="post" action="/account/friends" style="margin:0">
                        <input type="hidden" name="action" value="decline">
                        <input type="hidden" name="target" value="{{.ChatWith}}">
                        <input type="hidden" name="return_to" value="/u/{{.Profile.Username}}?tab=messages&amp;with={{.ChatWith}}">
                        <button type="submit" class="d-btn d-btn-default">Decline</button>
                      </form>
                    </div>
                  </div>
                  {{else if .ChatPendingOut}}
                  <div class="d-dm-compose-form" style="display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;background:rgba(245,158,11,0.14);border-top:1px solid rgba(245,158,11,0.45)">
                    <div>
                      <strong style="color:#fcd34d;font-size:14px">&#9203; Friend Request Sent to @{{.ChatWith}} — Waiting for Acceptance</strong>
                      <div class="d-muted" style="font-size:12.5px;margin-top:2px">@{{.ChatWith}} must accept your friend request on their account before you can message each other.</div>
                    </div>
                    <form method="post" action="/account/friends" style="margin:0">
                      <input type="hidden" name="action" value="cancel">
                      <input type="hidden" name="target" value="{{.ChatWith}}">
                      <input type="hidden" name="return_to" value="/u/{{.Profile.Username}}?tab=messages&amp;with={{.ChatWith}}">
                      <button type="submit" class="d-btn d-btn-default">Cancel Request</button>
                    </form>
                  </div>
                  {{else}}
                  <div class="d-dm-compose-form" style="display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;background:rgba(47,123,255,0.12);border-top:1px solid rgba(47,123,255,0.4)">
                    <div>
                      <strong style="color:#fff;font-size:14px">Add @{{.ChatWith}} as a Friend to Text Them</strong>
                      <div class="d-muted" style="font-size:12.5px;margin-top:2px">Send a friend request first — once @{{.ChatWith}} accepts on their account, you can message each other.</div>
                    </div>
                    <form method="post" action="/account/friends" style="margin:0;display:flex;gap:8px;align-items:center">
                      <input type="hidden" name="action" value="add">
                      <input type="text" name="target" value="{{.ChatWith}}" class="d-input" placeholder="@username" style="width:150px;margin:0" required>
                      <button type="submit" class="d-btn d-btn-primary d-btn-theme">+ Send Friend Request</button>
                    </form>
                  </div>
                  {{end}}
                  {{else}}
                  <div class="d-dm-compose-form" style="text-align:center">
                    <a href="/login?next=/u/{{.Profile.Username}}?tab=messages" class="d-btn d-btn-primary d-btn-theme">Log In to Send a Direct Message</a>
                  </div>
                  {{end}}
                </div>
              </div>

              {{else if eq .Tab "badges"}}
              <!-- ==============================================================
                   TAB: ALL 18 AFX & NSM BADGES & UNLOCK COMPENDIUM
                   ============================================================== -->
              <div class="top-section badges-section">
                <div class="d-stream-header">
                  <div>
                    <h3 class="stats-title" style="margin:0">Badges Earned by {{.Profile.EffectiveDisplayName}} ({{.UnlockedCount}} / {{.TotalBadgesCount}} Unlocked)</h3>
                    <p class="d-muted" style="font-size:13px;margin:4px 0 0">Complete collection of all 18 AFX &amp; NSM Platform Badges and how to unlock each one.</p>
                  </div>
                  <a href="/u/{{.Profile.Username}}?tab=pulse" class="d-btn d-btn-primary d-btn-theme d-btn-xs">&#9889; Unlock AFX Pulse Badges</a>
                </div>

                <div class="badge-group-list">
                  {{range .AllBadges}}
                  <div class="d-badge-card {{if .Unlocked}}badge-unlocked{{else}}badge-locked{{end}} rarity-{{.Rarity}}">
                    <div class="d-badge-icon" style="{{.ColorStyle}}">
                      <svg viewBox="0 0 24 24" fill="currentColor" style="width:28px;height:28px"><circle cx="12" cy="8" r="6"/><path d="M9 14l-2 8 5-3 5 3-2-8"/></svg>
                    </div>
                    <div class="d-badge-info">
                      <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap">
                        <h3>{{.Name}}</h3>
                        <span class="d-badge-rarity-pill rarity-{{.Rarity}}">{{.Rarity}}</span>
                      </div>
                      <p>{{.Desc}}</p>
                      <div class="d-badge-unlock-how">
                        {{if .Unlocked}}
                        <span class="d-unlocked-check">&#10004; Unlocked ({{.GrantedStr}})</span>
                        {{else}}
                        <span><strong>How to Unlock:</strong> {{.HowToUnlock}}</span>
                        {{end}}
                      </div>
                    </div>
                  </div>
                  {{end}}
                </div>
              </div>

              {{else}}
              <!-- ==============================================================
                   TAB: SUMMARY (1:1 discourse/app/templates/user/summary.gjs)
                   ============================================================== -->
              <div class="top-section stats-section">
                <h3 class="stats-title">Stats</h3>
                <ul>
                  <li class="stats-days-visited">
                    <div class="user-stat">
                      <span class="value">{{.DaysVisited}}</span>
                      <span class="label">days visited</span>
                    </div>
                  </li>
                  <li class="stats-time-read">
                    <div class="user-stat">
                      <span class="value">{{.ReadTime}}</span>
                      <span class="label">read time</span>
                    </div>
                  </li>
                  <li class="stats-recent-read">
                    <div class="user-stat">
                      <span class="value">{{.RecentReadTime}}</span>
                      <span class="label">recent read time</span>
                    </div>
                  </li>
                  <li class="stats-topics-entered">
                    <a href="/u/{{.Profile.Username}}?tab=read">
                      <div class="user-stat">
                        <span class="value" id="profile-realtime-topics-viewed">{{.TopicsViewed}}</span>
                        <span class="label">topics viewed</span>
                      </div>
                    </a>
                  </li>
                  <li class="stats-posts-read">
                    <a href="/u/{{.Profile.Username}}?tab=read">
                      <div class="user-stat">
                        <span class="value" id="profile-realtime-posts-read">{{.PostsRead}}</span>
                        <span class="label">posts read</span>
                      </div>
                    </a>
                  </li>
                  <li class="stats-likes-given">
                    <a href="/u/{{.Profile.Username}}?tab=likes">
                      <div class="user-stat">
                        <span class="value"><span class="d-icon-heart">&#10084;</span> {{.LikesGiven}}</span>
                        <span class="label">given</span>
                      </div>
                    </a>
                  </li>
                  <li class="stats-likes-received">
                    <a href="/u/{{.Profile.Username}}?tab=likes">
                      <div class="user-stat">
                        <span class="value"><span class="d-icon-heart">&#10084;</span> {{.LikesReceived}}</span>
                        <span class="label">received</span>
                      </div>
                    </a>
                  </li>
                  <li class="stats-topic-count">
                    <a href="/u/{{.Profile.Username}}?tab=topics">
                      <div class="user-stat">
                        <span class="value">{{.TopicCount}}</span>
                        <span class="label">topics created</span>
                      </div>
                    </a>
                  </li>
                  <li class="stats-post-count">
                    <a href="/u/{{.Profile.Username}}?tab=activity">
                      <div class="user-stat">
                        <span class="value">{{.PostCount}}</span>
                        <span class="label">posts created</span>
                      </div>
                    </a>
                  </li>
                  <li class="stats-server-boosts">
                    <a href="/u/{{.Profile.Username}}?tab=votes">
                      <div class="user-stat">
                        <span class="value">{{.UpvoteCount}}</span>
                        <span class="label">server upvotes</span>
                      </div>
                    </a>
                  </li>
                </ul>
              </div>

              <!-- 2. Top Replies & Top Topics (.top-section.replies-and-topics-section) -->
              <div class="top-section replies-and-topics-section">
                <div class="top-sub-section replies-section pull-left">
                  <h3 class="stats-title">Top Replies</h3>
                  {{if .Posts}}
                  <ul>
                    {{range .Posts}}
                    <li>
                      <span class="topic-info">
                        {{.CreatedAt}}
                        {{if gt .Likes 0}}&middot; <span class="d-icon-heart">&#10084;</span> {{.Likes}}{{end}}
                      </span>
                      <br>
                      <a href="/forum/t/{{.TopicID}}#post-{{.PostNumber}}">{{.TopicTitle}}</a>
                      {{if .Excerpt}}<div class="d-muted" style="font-size:13px;margin-top:4px">{{.Excerpt}}</div>{{end}}
                    </li>
                    {{end}}
                  </ul>
                  <p style="margin-top:10px"><a href="/u/{{.Profile.Username}}?tab=replies" class="d-more-link">More Replies &rarr;</a></p>
                  {{else}}
                  <p class="d-muted">No replies yet.</p>
                  {{end}}
                </div>

                <div class="top-sub-section topics-section pull-right">
                  <h3 class="stats-title">Top Topics</h3>
                  {{if .Topics}}
                  <ul>
                    {{range .Topics}}
                    <li>
                      <span class="topic-info">
                        {{.Views}} views &middot; {{len .Posts}} posts
                      </span>
                      <br>
                      <a href="/forum/t/{{.ID}}">{{.Title}}</a>
                    </li>
                    {{end}}
                  </ul>
                  <p style="margin-top:10px"><a href="/u/{{.Profile.Username}}?tab=topics" class="d-more-link">More Topics &rarr;</a></p>
                  {{else}}
                  <p class="d-muted">No topics yet.</p>
                  {{end}}
                </div>
              </div>

              <!-- 3. Top Categories & Connected Profiles (.top-section.top-categories-section) -->
              <div class="top-section top-categories-section">
                <div class="top-sub-section summary-category-list pull-left">
                  <h3 class="stats-title">Top Categories</h3>
                  <table>
                    <thead>
                      <tr>
                        <th class="category-link">Category</th>
                        <th class="topic-count">Topics</th>
                        <th class="reply-count">Replies</th>
                      </tr>
                    </thead>
                    <tbody>
                      {{range .TopCategories}}
                      <tr>
                        <td class="category-link">
                          <a class="badge-category__wrapper" href="/forum/c/{{.Slug}}">
                            <span class="badge-category-bg" style="background-color: {{.Color}}"></span>
                            <span class="badge-category__name">{{.Name}}</span>
                          </a>
                        </td>
                        <td class="topic-count"><a href="/u/{{$.Profile.Username}}?tab=topics">{{if gt .TopicCount 0}}{{.TopicCount}}{{else}}&ndash;{{end}}</a></td>
                        <td class="reply-count"><a href="/u/{{$.Profile.Username}}?tab=replies">{{if gt .ReplyCount 0}}{{.ReplyCount}}{{else}}&ndash;{{end}}</a></td>
                      </tr>
                      {{end}}
                    </tbody>
                  </table>
                </div>

                <div class="top-sub-section summary-user-list pull-right">
                  <h3 class="stats-title">Connected Accounts &amp; Most Liked By</h3>
                  <ul>
                    {{if .Profile.DiscordTag}}
                    <li>
                      <span class="topic-info">Community Handle</span><br>
                      <strong>{{.Profile.DiscordTag}}</strong>
                    </li>
                    {{end}}
                    {{if .Profile.GitHub}}
                    <li>
                      <span class="topic-info">GitHub</span><br>
                      <a href="{{.Profile.GitHubURL}}" rel="noopener">github.com/{{.Profile.GitHubHandle}}</a>
                    </li>
                    {{end}}
                    {{if .Profile.Steam}}
                    <li>
                      <span class="topic-info">Steam</span><br>
                      <a href="{{.Profile.SteamURL}}" rel="noopener">{{.Profile.Steam}}</a>
                    </li>
                    {{end}}
                    <li class="d-summary-user-row">
                      <img src="/avatars/u/nta~/48.png" alt="nta~" width="36" height="36" class="avatar">
                      <div>
                        <a href="/u/nta~"><strong>nta~</strong> <span class="d-muted">NSM Founder</span></a>
                        <div class="d-muted"><span class="d-icon-heart">&#10084;</span> {{.LikesReceived}}</div>
                      </div>
                    </li>
                  </ul>
                </div>
              </div>

              <!-- 4. Top Badges (.top-section.badges-section) -->
              <div class="top-section badges-section">
                <h3 class="stats-title">Top Badges ({{.UnlockedCount}} Unlocked)</h3>
                <div class="badge-group-list">
                  {{range .Badges}}
                  <div class="d-badge-card badge-unlocked rarity-{{.Rarity}}">
                    <div class="d-badge-icon" style="{{.ColorStyle}}">
                      <svg viewBox="0 0 24 24" fill="currentColor" style="width:24px;height:24px"><circle cx="12" cy="8" r="6"/><path d="M9 14l-2 8 5-3 5 3-2-8"/></svg>
                    </div>
                    <div class="d-badge-info">
                      <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
                        <h3>{{.Name}}</h3>
                        <span class="d-badge-rarity-pill rarity-{{.Rarity}}">{{.Rarity}}</span>
                      </div>
                      <p>{{.Desc}}</p>
                    </div>
                  </div>
                  {{end}}
                </div>
                <p style="margin-top:12px"><a href="/u/{{.Profile.Username}}?tab=badges" class="d-more-link">View All {{.TotalBadgesCount}} Badges &amp; Unlock Guide &rarr;</a></p>
              </div>
              {{end}}

            </div>
          </div>
        </section>
      </div>
    </main>
  </div>

  <script>
    function hexToRgbTriplet(hex) {
      if (!hex || hex.length !== 7 || hex[0] !== '#') return '47, 123, 255';
      var r = parseInt(hex.slice(1, 3), 16);
      var g = parseInt(hex.slice(3, 5), 16);
      var b = parseInt(hex.slice(5, 7), 16);
      if (isNaN(r) || isNaN(g) || isNaN(b)) return '47, 123, 255';
      return r + ', ' + g + ', ' + b;
    }
    function syncNsmLiveColors() {
      var root = document.getElementById('nsm-user-profile-root');
      if (!root) return;
      var p = document.getElementById('picker-theme-primary');
      var a = document.getElementById('picker-theme-accent');
      var b = document.getElementById('picker-banner-color');
      var v = document.getElementById('picker-avatar-color');
      if (p) {
        root.style.setProperty('--prof-primary', p.value);
        root.style.setProperty('--prof-primary-rgb', hexToRgbTriplet(p.value));
        var hp = document.getElementById('hex-theme-primary');
        if (hp) hp.textContent = p.value;
      }
      if (a) {
        root.style.setProperty('--prof-accent', a.value);
        root.style.setProperty('--prof-accent-rgb', hexToRgbTriplet(a.value));
        var ha = document.getElementById('hex-theme-accent');
        if (ha) ha.textContent = a.value;
      }
      if (b) {
        root.style.setProperty('--prof-banner', b.value);
        var hb = document.getElementById('hex-banner-color');
        if (hb) hb.textContent = b.value;
      }
      if (v) {
        root.style.setProperty('--prof-avatar', v.value);
        var hv = document.getElementById('hex-avatar-color');
        if (hv) hv.textContent = v.value;
      }
    }
    function applyNsmProfileTheme(primary, accent, banner, avatar) {
      var p = document.getElementById('picker-theme-primary');
      var a = document.getElementById('picker-theme-accent');
      var b = document.getElementById('picker-banner-color');
      var v = document.getElementById('picker-avatar-color');
      if (p) p.value = primary;
      if (a) a.value = accent;
      if (b) b.value = banner;
      if (v) v.value = avatar;
      syncNsmLiveColors();
    }
    function syncNsmLiveDecoration(val) {
      var wrap = document.getElementById('live-avatar-wrap');
      if (!wrap) return;
      wrap.className = 'user-profile-avatar deco-' + val;
      wrap.setAttribute('data-decoration', val);
    }
    function syncNsmLiveEffect(val) {
      var root = document.getElementById('nsm-user-profile-root');
      if (!root) return;
      root.className = 'dc-ember-body user-summary-page user-full-themed-page fx-effect-' + val;
      root.setAttribute('data-profile-effect', val);
    }
    function previewNsmAvatarFile(inp) {
      if (!inp || !inp.files || !inp.files[0]) return;
      var reader = new FileReader();
      reader.onload = function(ev) {
        var av = document.getElementById('live-profile-avatar');
        if (av && ev.target && ev.target.result) av.src = ev.target.result;
      };
      reader.readAsDataURL(inp.files[0]);
    }
    function previewNsmBannerFile(inp) {
      if (!inp || !inp.files || !inp.files[0]) return;
      var reader = new FileReader();
      reader.onload = function(ev) {
        var bEl = document.getElementById('live-profile-banner');
        if (bEl && ev.target && ev.target.result) {
          bEl.style.backgroundImage = "linear-gradient(180deg, rgba(14,16,22,0.18), rgba(14,16,22,0.82)), url('" + ev.target.result + "')";
          bEl.style.backgroundSize = 'cover';
          bEl.style.backgroundPosition = 'center';
        }
      };
      reader.readAsDataURL(inp.files[0]);
    }
    function selectPulseCheckoutPlan(tier, label) {
      var sel = document.getElementById('pulse-checkout-tier');
      if (sel) sel.value = tier;
      var lbl = document.getElementById('pulse-checkout-plan-label');
      if (lbl) lbl.innerHTML = 'Selected Plan: <strong>' + label + '</strong>';
      var box = document.getElementById('pulse-checkout-box');
      if (box) box.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    function updatePulseCheckoutLabel(tier) {
      var map = {
        'core': '$4.99/mo — AFX Pulse Core (0 Server Upvotes)',
        'pro': '$9.99/mo — AFX Pulse Pro (+1 Server Upvote & Full-Page Profile Colors)',
        'sovereign': '$19.99/mo — AFX Pulse Sovereign (+4 Server Upvotes & Full-Page Profile Colors)'
      };
      var lbl = document.getElementById('pulse-checkout-plan-label');
      if (lbl && map[tier]) lbl.innerHTML = 'Selected Plan: <strong>' + map[tier] + '</strong>';
    }
    function pollProfileRealtimeStats() {
      fetch('/api/forum/realtime?profile={{.Profile.Username}}', { cache: 'no-store' })
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(d) {
          if (!d) return;
          if (d.profileViews) {
            var pv = document.getElementById('profile-realtime-views');
            if (pv) pv.textContent = d.profileViews;
          }
          if (typeof d.topicsViewed === 'number') {
            var tv = document.getElementById('profile-realtime-topics-viewed');
            if (tv) tv.textContent = d.topicsViewed;
          }
          if (typeof d.postsRead === 'number') {
            var pr = document.getElementById('profile-realtime-posts-read');
            if (pr) pr.textContent = d.postsRead;
          }
        })
        .catch(function() {});
    }
    setInterval(pollProfileRealtimeStats, 3000);
    if ((window.location.pathname === '/account/profile' || window.location.pathname === '/account/pulse') && window.history && window.history.replaceState) {
      window.history.replaceState(null, '', '/u/{{.Profile.Username}}?tab={{.Tab}}');
    }
  </script>
  <script src="/js/main.js?v=078m"></script>
</body>
</html>
