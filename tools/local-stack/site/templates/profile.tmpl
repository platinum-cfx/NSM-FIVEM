<!DOCTYPE html>
<html lang="en" class="discourse-dark-theme">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile - {{.Profile.EffectiveDisplayName}} (@{{.Profile.Username}}) - AFX Forum</title>
  <link rel="icon" type="image/png" href="/img/nsm-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=090a">
</head>
<body
  class="dc-ember-body user-summary-page user-full-themed-page fx-effect-{{.Profile.EffectiveProfileEffect}}"
  id="nsm-user-profile-root"
  data-profile-effect="{{.Profile.EffectiveProfileEffect}}"
  style="{{.Profile.ThemeStyleAttr}}"
>
  <!-- Full-Page Moving Profile Effect Ambient Layer -->
  <div class="fx-page-ambient-overlay" aria-hidden="true">
    <div class="fx-layer fx-layer-aurora"></div>
    <div class="fx-layer fx-layer-grid"></div>
    <div class="fx-layer fx-layer-stars"></div>
    <div class="fx-layer fx-layer-lightning"></div>
    <div class="fx-layer fx-layer-embers"></div>
    <div class="fx-layer fx-layer-prism"></div>
  </div>

  <!-- Discourse d-header -->
  <header class="d-header">
    <div class="d-header-wrap">
      <div class="d-header-left">
        <button type="button" class="btn-sidebar-toggle" onclick="document.getElementById('d-sidebar').classList.toggle('collapsed')" title="Toggle sidebar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <a href="/forum" class="d-logo-link">
          <img src="/img/nsm-icon.png" alt="NSM" class="d-logo-mark">
          <span class="d-logo-text">AFX <strong>Forum</strong></span>
        </a>
        <nav class="d-top-links">
          <a href="/">nsmultiplayer.com</a>
          <a href="/servers">Server List</a>
          <a href="/keymaster">AFX Portal</a>
          <a href="/marketplace">Marketplace</a>
          <a href="/docs">Docs</a>
          <a href="/support">Support</a>
          {{if and .User .User.IsStaffOrHigher}}
          <a href="/admin/users" style="color:#6ea8ff !important;font-weight:700">Staff</a>
          {{end}}
        </nav>
      </div>

      <div class="d-header-icons">
        <form method="get" action="/forum" class="d-header-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="search" name="q" placeholder="Search AFX Forum...">
        </form>

        {{if .User}}
        {{if .User.IsStaffOrHigher}}
        <a href="/admin/users" class="d-btn d-btn-default">Staff</a>
        {{end}}
        <a href="/u/{{.User.Username}}" class="d-header-user" title="{{.User.EffectiveDisplayName}} (@{{.User.Username}})">
          <img src="{{.User.AvatarPath}}" alt="{{.User.Username}}" class="d-header-avatar">
          <span class="d-header-username" id="live-navbar-display-name">{{.User.EffectiveDisplayName}}</span>
        </a>
        <a href="/u/{{.User.Username}}?tab=pulse" class="d-btn d-btn-flat d-btn-pulse-pill">&#9889; AFX Pulse</a>
        <a href="/u/{{.User.Username}}?tab=preferences" class="d-btn d-btn-flat">Preferences</a>
        <a href="/logout" class="d-btn d-btn-flat">Log Out</a>
        {{else}}
        <a href="/register?next=/u/{{.Profile.Username}}" class="d-btn d-btn-primary">Sign Up</a>
        <a href="/login?next=/u/{{.Profile.Username}}" class="d-btn d-btn-default">Log In</a>
        {{end}}
      </div>
    </div>
  </header>

  <div id="main-outlet-wrapper" class="d-outlet-wrapper">
    <!-- Left Discourse Sidebar -->
    <aside id="d-sidebar" class="sidebar-wrapper">
      <div class="sidebar-sections">
        <div class="sidebar-section">
          <ul class="sidebar-section-content">
            <li>
              <a href="/forum" class="sidebar-section-link">
                <span class="sidebar-section-link-prefix">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                </span>
                <span class="sidebar-section-link-content-text">Topics</span>
              </a>
            </li>
            <li>
              <a href="/forum?tab=categories" class="sidebar-section-link">
                <span class="sidebar-section-link-prefix">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                </span>
                <span class="sidebar-section-link-content-text">Categories</span>
              </a>
            </li>
            <li>
              <a href="/u" class="sidebar-section-link">
                <span class="sidebar-section-link-prefix">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </span>
                <span class="sidebar-section-link-content-text">Users</span>
              </a>
            </li>
            <li>
              <a href="/u/{{.Profile.Username}}" class="sidebar-section-link active">
                <span class="sidebar-section-link-prefix">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </span>
                <span class="sidebar-section-link-content-text">{{.Profile.EffectiveDisplayName}}</span>
              </a>
            </li>
            <li>
              <a href="/u/{{.Profile.Username}}?tab=pulse" class="sidebar-section-link">
                <span class="sidebar-section-link-prefix">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                </span>
                <span class="sidebar-section-link-content-text">AFX Pulse Perks</span>
              </a>
            </li>
            {{if .CanManagePartner}}
            <li>
              <a href="/admin/users" class="sidebar-section-link">
                <span class="sidebar-section-link-prefix">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
                </span>
                <span class="sidebar-section-link-content-text">Staff &amp; Partners</span>
              </a>
            </li>
            {{end}}
          </ul>
        </div>

        <div class="sidebar-section">
          <div class="sidebar-section-header">CATEGORIES</div>
          <ul class="sidebar-section-content">
            {{range .Categories}}
            <li>
              <a href="/forum/c/{{.Slug}}" class="sidebar-section-link">
                <span class="sidebar-section-link-prefix">
                  <span class="prefix-square" style="background:{{.Color}}"></span>
                </span>
                <span class="sidebar-section-link-content-text">{{.Name}}</span>
                <span class="sidebar-section-link-suffix">{{.TopicCount}}</span>
              </a>
            </li>
            {{end}}
          </ul>
        </div>
      </div>
    </aside>

    <!-- Main User Profile Outlet -->
    <main id="main-outlet" class="d-main-outlet">
      {{if .Msg}}
      <div class="d-alert d-alert-success">{{.Msg}}</div>
      {{end}}
      {{if .Error}}
      <div class="d-alert d-alert-error">{{.Error}}</div>
      {{end}}

      <div class="container {{if .IsOwn}}viewing-self{{end}}">
        <section class="user-main user-themed-profile">
          <!-- section.about.has-background -->
          <section class="about has-background">
            <div
              class="user-profile-image"
              id="live-profile-banner"
              style="{{.Profile.BannerStyleAttr}}"
            >
              <div class="user-profile-banner-shine"></div>
              <div class="user-profile-banner-fx"></div>
              {{if .Profile.HasPulse}}
              <div class="d-pulse-banner-tag">
                <span>&#9889; {{.Profile.EffectivePulseTierLabel}}</span>
              </div>
              {{end}}
            </div>

            <div class="details">
              <div class="primary">
                <!-- UserProfileAvatar + Animated Decorations (Cat Ears, Sovereign Crown, Cyber Visor, Plasma Flames, Volt Lightning, Sakura Drift, Singularity Nebula) -->
                <div class="user-profile-avatar deco-{{.Profile.EffectiveAvatarDecoration}}" id="live-avatar-wrap" data-decoration="{{.Profile.EffectiveAvatarDecoration}}">
                  <!-- Animated Decoration Layer -->
                  <div class="avatar-deco-layer" aria-hidden="true">
                    <!-- 1. Neon Cyber Cat Ears -->
                    <svg class="deco-svg deco-cat-ears" viewBox="0 0 160 160" fill="none">
                      <path class="cat-ear cat-ear-left" d="M22 64 L14 12 L62 36 Z" fill="var(--prof-primary)" stroke="var(--prof-accent)" stroke-width="3"/>
                      <path class="cat-ear-inner cat-ear-left" d="M27 56 L22 22 L53 38 Z" fill="var(--prof-accent)"/>
                      <path class="cat-ear cat-ear-right" d="M138 64 L146 12 L98 36 Z" fill="var(--prof-primary)" stroke="var(--prof-accent)" stroke-width="3"/>
                      <path class="cat-ear-inner cat-ear-right" d="M133 56 L138 22 L107 38 Z" fill="var(--prof-accent)"/>
                      <line class="cat-whisker" x1="2" y1="88" x2="18" y2="92" stroke="var(--prof-accent)" stroke-width="2.5" stroke-linecap="round"/>
                      <line class="cat-whisker" x1="4" y1="100" x2="19" y2="99" stroke="var(--prof-primary)" stroke-width="2.5" stroke-linecap="round"/>
                      <line class="cat-whisker" x1="158" y1="88" x2="142" y2="92" stroke="var(--prof-accent)" stroke-width="2.5" stroke-linecap="round"/>
                      <line class="cat-whisker" x1="156" y1="100" x2="141" y2="99" stroke="var(--prof-primary)" stroke-width="2.5" stroke-linecap="round"/>
                    </svg>

                    <!-- 2. Sovereign Floating Crown & Halo -->
                    <svg class="deco-svg deco-sovereign-crown" viewBox="0 0 160 160" fill="none">
                      <ellipse class="crown-halo" cx="80" cy="16" rx="44" ry="8" stroke="#FFD700" stroke-width="3" stroke-dasharray="8 4"/>
                      <path class="crown-body" d="M42 42 L34 14 L62 28 L80 8 L98 28 L126 14 L118 42 Z" fill="#FFD700" stroke="#F59E0B" stroke-width="2.5"/>
                      <circle cx="80" cy="24" r="4" fill="#EF4444"/>
                      <circle cx="58" cy="30" r="3" fill="#38BDF8"/>
                      <circle cx="102" cy="30" r="3" fill="#38BDF8"/>
                    </svg>

                    <!-- 3. AFX Cybernetic Visor & HUD Orbit -->
                    <svg class="deco-svg deco-cyber-visor" viewBox="0 0 160 160" fill="none">
                      <circle class="visor-orbit" cx="80" cy="88" r="66" stroke="var(--prof-accent)" stroke-width="2.5" stroke-dasharray="18 10 6 10"/>
                      <path class="visor-lens" d="M32 76 Q80 64 128 76 L122 92 Q80 82 38 92 Z" fill="rgba(56, 189, 248, 0.55)" stroke="#38BDF8" stroke-width="2"/>
                    </svg>

                    <!-- 4. Inferno Plasma Flames -->
                    <div class="deco-ring deco-plasma-ring"></div>

                    <!-- 5. Volt Lightning Storm -->
                    <div class="deco-ring deco-volt-ring"></div>

                    <!-- 6. Sakura Blossom Vortex -->
                    <div class="deco-ring deco-sakura-ring"></div>

                    <!-- 7. Singularity Nebula -->
                    <div class="deco-ring deco-nebula-ring"></div>
                  </div>

                  <img alt="{{.Profile.EffectiveDisplayName}}" width="120" height="120" src="{{.Profile.AvatarPath}}" class="avatar" id="live-profile-avatar">
                  {{if .Profile.IsFounderAccount}}
                  <div class="avatar-flair flair-founder" title="NSM Sovereign Founder">&#9813;</div>
                  {{else if or (eq .Profile.Role "admin") (eq .Profile.Role "staff")}}
                  <div class="avatar-flair" title="AFX Platform Staff">&#9733;</div>
                  {{else if .Profile.HasPartnerBadge}}
                  <div class="avatar-flair flair-partner" title="AFX Partnered Server Owner">&#8734;</div>
                  {{end}}
                </div>

                <!-- .primary-textual -->
                <div class="primary-textual">
                  <div class="user-profile-names">
                    <div class="username user-profile-names__primary">
                      <span id="live-profile-display-name">{{.Profile.EffectiveDisplayName}}</span>
                      {{if .Profile.IsFounderAccount}}
                      <span class="d-role-tag role-founder" title="NSM Founder &amp; Sovereign Owner">&#9813; FOUNDER</span>
                      {{else if eq .Profile.Role "admin"}}
                      <span class="d-role-tag role-admin">ADMIN</span>
                      {{else if eq .Profile.Role "staff"}}
                      <span class="d-role-tag role-staff">STAFF</span>
                      {{end}}
                      {{if .Profile.HasPartnerBadge}}
                      <span class="d-role-tag role-partner" title="Official AFX Partner">&#8734; PARTNER</span>
                      {{end}}
                      {{if .Profile.HasPulse}}
                      <span class="d-role-tag role-pulse" title="{{.Profile.EffectivePulseTierLabel}}">&#9889; {{.Profile.EffectivePulseTier}}</span>
                      {{end}}
                    </div>
                    <div class="full-name user-profile-names__secondary" id="live-profile-handle">@{{.Profile.Username}}</div>
                    <div class="user-profile-names__title">
                      <span id="live-profile-title">{{.Profile.EffectiveTitle}}</span>
                    </div>

                    <!-- Profile Header Unlocked Badge Tray (Interactive Icons for All Earned Badges) -->
                    <div class="d-profile-badge-tray" title="Unlocked AFX &amp; NSM Badges">
                      {{range .Badges}}
                      <a href="/u/{{$.Profile.Username}}?tab=badges" class="d-tray-badge rarity-{{.Rarity}}" style="{{.ColorStyle}}" title="{{.Name}} ({{.Rarity}}) — {{.Desc}}">
                        {{if eq .Icon "crown"}}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/></svg>
                        {{else if eq .Icon "staff_shield"}}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 6h2v6h-2V7zm0 8h2v2h-2v-2z"/></svg>
                        {{else if eq .Icon "admin_star"}}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.1-1.01L12 2z"/></svg>
                        {{else if eq .Icon "partner_infinity"}}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18.178 8c5.096 0 5.096 8 0 8-5.095 0-7.133-8-12.739-8-4.585 0-4.585 8 0 8 5.606 0 7.644-8 12.74-8z"/></svg>
                        {{else if eq .Icon "mod_sword"}}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3zm-1.06 13.54L7.4 12l1.41-1.41 2.12 2.12 4.24-4.24 1.41 1.41-5.64 5.66z"/></svg>
                        {{else if eq .Icon "pulse_wheel"}}
                        <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                        {{else if eq .Icon "boost_gem"}}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 9l10 13L22 9 12 2zm0 3.3L18.4 9 12 17.3 5.6 9 12 5.3z"/></svg>
                        {{else if eq .Icon "bravery"}}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L4 7v7c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V7l-8-5zm0 4l4 3-1.5 5h-5L8 9l4-3z"/></svg>
                        {{else if eq .Icon "brilliance"}}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a7 7 0 0 0-4 12.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26A7 7 0 0 0 12 2zm-2 18h4v2h-4v-2z"/></svg>
                        {{else if eq .Icon "balance"}}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3L2 12l10 9 10-9-10-9zm0 4.5L16.5 12 12 16.5 7.5 12 12 7.5z"/></svg>
                        {{else if or (eq .Icon "bug") (eq .Icon "gold_bug")}}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 8h-2.81a5.985 5.985 0 0 0-1.82-1.96L17 4.41 15.59 3l-2.17 2.17C12.96 5.06 12.49 5 12 5s-.96.06-1.41.17L8.41 3 7 4.41l1.62 1.63C7.88 6.55 7.26 7.22 6.81 8H4v2h2.09c-.05.33-.09.66-.09 1v1H4v2h2v1c0 .34.04.67.09 1H4v2h2.81c1.04 1.79 2.97 3 5.19 3s4.15-1.21 5.19-3H20v-2h-2.09c.05-.33.09-.66.09-1v-1h2v-2h-2v-1c0-.34-.04-.67-.09-1H20V8z"/></svg>
                        {{else if eq .Icon "code_brackets"}}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                        {{else if eq .Icon "verified_gear"}}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L9 4H4v5l-3 3 3 3v5h5l3 3 3-3h5v-5l3-3-3-3V4h-5l-3-3zm-1.5 14.5l-4-4 1.41-1.41 2.59 2.58 5.59-5.59L17.5 8.5l-7 7z"/></svg>
                        {{else}}
                        <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="6"/><path d="M9 14l-2 8 5-3 5 3-2-8"/></svg>
                        {{end}}
                      </a>
                      {{end}}
                    </div>
                  </div>

                  <div class="bio" id="live-profile-bio">
                    {{if .Profile.Bio}}
                    <p>{{.Profile.Bio}}</p>
                    {{else}}
                    <p>NSM &amp; AFX Platform Member. Playing on customized Grand Theft Auto V dedicated servers.</p>
                    {{end}}
                  </div>

                  <!-- Location, Website, Community Handle, GitHub, Steam, YouTube, Twitch, X/Twitter, Favorite Server -->
                  <div class="location-and-website user-profile__location-and-website">
                    {{if .Profile.Location}}
                    <div class="user-profile-location">
                      <svg class="d-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                      <span>{{.Profile.Location}}</span>
                    </div>
                    {{end}}

                    {{if .Profile.DiscordTag}}
                    <div class="d-social-pill d-social-community" title="Community Handle">
                      <svg class="d-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.03 2 11c0 2.87 1.5 5.43 3.85 7.08L5 22l4.32-2.16c.86.21 1.76.32 2.68.32 5.52 0 10-4.03 10-9S17.52 2 12 2z"/></svg>
                      <span>{{.Profile.DiscordTag}}</span>
                    </div>
                    {{end}}

                    {{if .Profile.GitHub}}
                    <a href="{{.Profile.GitHubURL}}" class="d-social-pill d-social-github" rel="noopener" title="GitHub">
                      <svg class="d-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                      <span>github.com/{{.Profile.GitHubHandle}}</span>
                    </a>
                    {{end}}

                    {{if .Profile.Steam}}
                    <a href="{{.Profile.SteamURL}}" class="d-social-pill d-social-steam" rel="noopener" title="Steam">
                      <svg class="d-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0z"/></svg>
                      <span>{{.Profile.Steam}}</span>
                    </a>
                    {{end}}

                    {{if .Profile.YouTube}}
                    <a href="{{.Profile.YouTubeURL}}" class="d-social-pill d-social-youtube" rel="noopener" title="YouTube">
